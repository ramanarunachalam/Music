\u0b95\u0bc1 \u0ba3\u0ba4\u0bcd\u0bb0\u0baf\u0bae\u0bc1 \u0bae\u0bb1\u0bcd\u0bb1\u0ba4\u0bca\u0bb0\u0bc1\u0b95\u0bbe\u0bb2\u0bae\u0bcd"}, {"M": "\u0b9a\u0bb0\u0ba3\u0bae\u0bcd 2", "T": "\u0ba8\u0bbf\u0b95\u0bb4\u0bc1\u0bae\u0bcd\u0bb5\u0b9f\u0bbf \u0bb5\u0bbf\u0ba9\u0bc8\u0bae\u0bc1\u0b9f\u0bbf\u0bb5\u0bbf \u0bb2\u0bca\u0ba9\u0bcd\u0bb1\u0bc6\u0ba9\u0bcd\u0bb1\u0bbf \u0bb0\u0bc1\u0baa\u0bcd\u0baa\u0ba4\u0ba9\u0bc8 <br/> \u0ba8\u0bbf\u0bb1\u0bc8\u0bb5\u0bc1\u0b95\u0bc1\u0bb1\u0bc8 \u0bb5\u0bca\u0bb4\u0bbf\u0bb5\u0bb1\u0ba9\u0bbf \u0bb1\u0bc8\u0ba8\u0bcd\u0ba4\u0bc6\u0b99\u0bcd\u0b95\u0bc1 \u0ba8\u0bbf\u0bb1\u0bcd\u0baa\u0ba4\u0ba9\u0bc8 <br/> \u0ba8\u0bbf\u0b95\u0bb0\u0bcd\u0baa\u0b95\u0bb0 \u0b85\u0bb1\u0bbf\u0baf\u0ba4\u0bc8\u0bb5\u0bbf \u0b9a\u0bc1\u0bae\u0bcd\u0baa\u0bbf\u0ba9\u0bcd\u0baa\u0bc1 \u0bb0\u0ba4\u0bcd\u0bb0\u0baf\u0bae\u0bc6 \u0bb0\u0bbf\u0ba4\u0bcd\u0ba4\u0baa\u0bc6\u0bb0\u0bc1\u0bae\u0bbe\u0ba9\u0bc1\u0bae\u0bcd"}, {"M": "\u0b9a\u0bb0\u0ba3\u0bae\u0bcd 3", "T": "\u0ba8\u0bbf\u0bb0\u0bc1\u0baa\u0b95\u0bc1\u0bb0\u0bc1 \u0baa\u0bb0\u0b95\u0bc1\u0bae\u0bb0 \u0b8e\u0ba9\u0bcd\u0bb1\u0bc6\u0ba9\u0bcd\u0bb1\u0bc1 \u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0b95\u0bca\u0b9f\u0bc1 <br/> \u0baa\u0bb0\u0bb5\u0bbe\u0bb0\u0bc1 \u0bb3\u0bbf\u0baf\u0bae\u0bb5\u0bc1\u0ba9 \u0bae\u0ba8\u0bcd\u0ba4\u0bcd\u0bb0\u0ba8\u0bcd\u0ba4 \u0ba8\u0bc8\u0baa\u0bcd\u0baa\u0bb4\u0bc8\u0baf <br/> \u0ba8\u0bbf\u0ba9\u0ba4\u0bc1\u0bb5\u0bb4\u0bbf \u0baf\u0b9f\u0bbf\u0bae\u0bc8\u0baf\u0bc1\u0bae\u0bcd\u0bb5\u0bbf \u0bb3\u0b99\u0bcd\u0b95\u0bc1\u0bae\u0bcd\u0baa \u0b9f\u0bbf\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bbf\u0ba4\u0bc1 \u0ba3\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0bb0\u0bc1\u0bb3\u0bcd\u0bb5\u0bbe\u0baf\u0bc7"}, {"M": "\u0b9a\u0bb0\u0ba3\u0bae\u0bcd 4", "T": "\u0ba4\u0b95\u0bc1\u0ba4\u0b95\u0bc1\u0b95\u0bc1 \u0ba4\u0b95\u0bc1\u0ba4\u0b95\u0bc1\u0b95\u0bc1 \u0ba4\u0ba8\u0bcd\u0ba4\u0ba8\u0bcd\u0ba4 \u0b95\u0bc1\u0ba4\u0bcd\u0ba4\u0b95\u0bc1\u0b95\u0bc1 <br/> \u0b9f\u0bbf\u0b95\u0bc1\u0b9f\u0bbf\u0b95\u0bc1\u0b95\u0bc1 \u0b9f\u0bbf\u0b95\u0bc1\u0b9f\u0bbf\u0b95\u0bc1\u0b95\u0bc1 \u0b9f\u0bbf\u0ba3\u0bcd\u0b9f\u0bbf\u0ba3\u0bcd\u0b9f\u0bbf \u0b95\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0b9f\u0bbf\u0b95\u0bc1 <br/> \u0ba4\u0b95\u0bc1\u0ba4\u0b95\u0bc6\u0ba3 \u0b95\u0bc6\u0ba3\u0b9a\u0bc6\u0b95\u0bc1\u0ba4 \u0ba4\u0ba8\u0bcd\u0ba4\u0ba8\u0bcd\u0ba4 \u0bb0\u0bbf\u0ba4\u0bcd\u0ba4\u0b95\u0bc1\u0ba4 \u0ba4\u0ba4\u0bcd\u0ba4\u0ba4\u0b95\u0bc1\u0ba4\u0bc0\u0ba4\u0bcb"}, {"M": "\u0b9a\u0bb0\u0ba3\u0bae\u0bcd 5", "T": "\u0ba4\u0ba9\u0ba4\u0ba9\u0ba9 \u0ba4\u0ba9\u0ba4\u0ba9\u0ba9 \u0ba4\u0ba8\u0bcd\u0ba4\u0ba8\u0bcd\u0ba4 \u0ba8\u0ba4\u0bcd\u0ba4\u0ba4\u0ba9 <br/> \u0b9f\u0bc1\u0b9f\u0bc1\u0b9f\u0bc1\u0b9f\u0bc1\u0b9f\u0bc1 \u0b9f\u0bc1\u0b9f\u0bc1\u0b9f\u0bc1\u0b9f\u0bc1\u0b9f\u0bc1 \u0b9f\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1 \u0b9f\u0bc1\u0b9f\u0bcd\u0b9f\u0bc1\u0b9f\u0bc1\u0b9f\u0bc1 <br/> \u0ba4\u0bb0\u0bb0\u0bb0\u0bb0 \u0bb0\u0bbf\u0bb0\u0bbf\u0bb0\u0bbf\u0bb0\u0bbf\u0bb0\u0bbf \u0baf\u0bc6\u0ba9\u0bcd\u0bb1\u0bc6\u0ba9\u0bcd\u0bb1\u0bbf \u0b9f\u0b95\u0bcd\u0b95\u0bc8\u0baf\u0bc1\u0bae\u0bc1 \u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0bc8\u0baf\u0bc1\u0bae\u0bbf\u0baf\u0bbe\u0bb5\u0bc1\u0bae\u0bcd"}, {"M": "\u0b9a\u0bb0\u0ba3\u0bae\u0bcd 6", "T": "\u0bae\u0bca\u0b95\u0bc1\u0bae\u0bca\u0b95\u0bc6\u0ba9 \u0b85\u0ba4\u0bbf\u0bb0\u0bae\u0bc1\u0ba4\u0bbf \u0bb0\u0ba3\u0bcd\u0b9f\u0bae\u0bcd\u0baa\u0bbf \u0bb3\u0b95\u0bcd\u0b95\u0ba9\u0bbf\u0bae\u0bbf\u0bb0\u0bcd <br/> \u0b85\u0bb2\u0b95\u0bc8\u0b95\u0bb0 \u0ba3\u0bae\u0bbf\u0b9f\u0bb5\u0bc1\u0bb2 \u0b95\u0bc6\u0b99\u0bcd\u0b95\u0bc1\u0bae\u0bcd\u0baa\u0bcd\u0bb0 \u0bae\u0bbf\u0b95\u0bcd\u0b95\u0ba9\u0b9f <br/> \u0bae\u0bc1\u0b9f\u0bc1\u0b95\u0bc1\u0baa\u0baf\u0bbf \u0bb0\u0bb5\u0bb0\u0bcd\u0baa\u0bb5\u0bc1\u0bb0\u0bbf \u0b95\u0bca\u0ba3\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd\u0baa\u0bc1 \u0bb1\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95 \u0bb3\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bca\u0bb0\u0bc1\u0b95\u0bcb\u0b9f\u0bbf"}, {"M": "\u0b9a\u0bb0\u0ba3\u0bae\u0bcd 7", "T": "\u0bae\u0bc1\u0ba4\u0bc1\u0b95\u0bb4\u0bc1\u0b95\u0bc1 \u0b95\u0bca\u0b9f\u0bbf\u0b95\u0bb0\u0bc1\u0b9f \u0ba8\u0b99\u0bcd\u0b95\u0bae\u0bcd\u0baa\u0bca \u0bb0\u0b95\u0bcd\u0b95\u0bc1\u0bb0\u0bc1\u0ba4\u0bbf <br/> \u0ba8\u0ba4\u0bbf\u0baa\u0bc6\u0bb0\u0bc1\u0b95 \u0bb5\u0bc6\u0b95\u0bc1\u0bae\u0bc1\u0b95\u0b95 \u0bb5\u0ba8\u0bcd\u0ba4\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0ba8\u0bbf\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bae\u0bbf\u0b9f <br/> \u0bae\u0bc1\u0bb0\u0b9a\u0ba4\u0bbf\u0bb0 \u0ba8\u0bbf\u0b9a\u0bbf\u0b9a\u0bb0\u0bb0\u0bc8 \u0bb5\u0bc6\u0ba9\u0bcd\u0bb1\u0bbf\u0ba8\u0bcd\u0ba4\u0bbf \u0bb0\u0bb1\u0bcd\u0b95\u0bb0\u0b9a \u0bb3\u0bbf\u0ba4\u0bcd\u0ba4\u0baa\u0bc6\u0bb0\u0bc1\u0bae\u0bbe\u0bb3\u0bc7."}]}, {"L": "Telugu", "text": [{"M": "\u0c2a\u0c32\u0c4d\u0c32\u0c35\u0c3f", "T": "\u0c05\u0c17\u0c30\u0c2e\u0c41\u0c26 \u0c32\u0c46\u0c28\u0c35\u0c41\u0c30\u0c48\u0c1a\u0c46\u0c2f\u0c4d \u0c10\u0c2e\u0c4d\u0c2a\u0c28\u0c4d\u0c24\u0c4a \u0c30\u0c15\u0c4d\u0c37\u0c30\u0c2e\u0c41\u0c2e\u0c4d <br/> \u0c05\u0c15\u0c3f\u0c32\u0c15\u0c32\u0c48 \u0c15\u0c33\u0c41\u0c2e\u0c4d\u0c35\u0c46\u0c15\u0c41\u0c35\u0c3f \u0c24\u0c19\u0c4d\u0c15\u0c4a\u0c23\u0c4d\u0c1f \u0c24\u0c24\u0c4d\u0c24\u0c41\u0c35\u0c2e\u0c41\u0c2e\u0c4d <br/> \u0c05\u0c2a\u0c30\u0c3f\u0c2e\u0c3f\u0c24 \u0c1a\u0c41\u0c30\u0c41\u0c24\u0c3f\u0c2f\u0c41\u0c2e \u0c1f\u0c19\u0c4d\u0c15\u0c41\u0c28\u0c4d\u0c24 \u0c28\u0c3f\u0c2a\u0c4d\u0c2a\u0c4a\u0c30\u0c41\u0c33\u0c48 \u0c0e\u0c2a\u0c4d\u0c2a\u0c4a\u0c30\u0c41\u0c33\u0c41\u0c2e\u0c3e\u0c2f"}, {"M": "\u0c1a\u0c30\u0c23\u0c2e\u0c4d 1", "T": "\u0c05\u0c31\u0c3f\u0c35\u0c48\u0c2f\u0c31\u0c3f \u0c2a\u0c35\u0c30\u0c31\u0c3f\u0c2f\u0c41\u0c2e\u0c4d \u0c07\u0c28\u0c4d\u0c2a\u0c28\u0c4d\u0c24 \u0c28\u0c48\u0c24\u0c4d\u0c24\u0c41\u0c30\u0c3f\u0c2f <br/> \u0c2e\u0c41\u0c1f\u0c3f\u0c35\u0c48\u0c05\u0c1f\u0c3f \u0c28\u0c1f\u0c41\u0c2e\u0c41\u0c1f\u0c3f\u0c35\u0c3f\u0c32\u0c4d \u0c24\u0c41\u0c19\u0c4d\u0c15\u0c28\u0c4d\u0c24 \u0c28\u0c48\u0c1a\u0c4d\u0c1a\u0c3f\u0c31\u0c3f\u0c2f <br/> \u0c05\u0c23\u0c41\u0c35\u0c48\u0c2f\u0c23\u0c41 \u0c35\u0c3f\u0c28\u0c3f\u0c28\u0c4d\u0c2e\u0c32\u0c2e\u0c41 \u0c28\u0c46\u0c1e\u0c4d\u0c1a\u0c41\u0c19\u0c4d\u0c15\u0c41 \u0c23\u0c24\u0c4d\u0c30\u0c2f\u0c2e\u0c41 \u0c2e\u0c1f\u0c4d\u0c31\u0c24\u0c4a\u0c30\u0c41\u0c15\u0c3e\u0c32\u0c2e\u0c4d"}, {"M": "\u0c1a\u0c30\u0c23\u0c2e\u0c4d 2", "T": "\u0c28\u0c3f\u0c15\u0c34\u0c41\u0c2e\u0c4d\u0c35\u0c1f\u0c3f \u0c35\u0c3f\u0c28\u0c48\u0c2e\u0c41\u0c1f\u0c3f\u0c35\u0c3f \u0c32\u0c4a\u0c28\u0c4d\u0c31\u0c46\u0c28\u0c4d\u0c31\u0c3f \u0c30\u0c41\u0c2a\u0c4d\u0c2a\u0c24\u0c28\u0c48 <br/> \u0c28\u0c3f\u0c31\u0c48\u0c35\u0c41\u0c15\u0c41\u0c31\u0c48 \u0c35\u0c4a\u0c34\u0c3f\u0c35\u0c31\u0c28\u0c3f \u0c31\u0c48\u0c28\u0c4d\u0c24\u0c46\u0c19\u0c4d\u0c15\u0c41 \u0c28\u0c3f\u0c31\u0c4d\u0c2a\u0c24\u0c28\u0c48 <br/> \u0c28\u0c3f\u0c15\u0c30\u0c4d\u0c2a\u0c15\u0c30 \u0c05\u0c31\u0c3f\u0c2f\u0c24\u0c48\u0c35\u0c3f \u0c1a\u0c41\u0c2e\u0c4d\u0c2a\u0c3f\u0c28\u0c4d\u0c2a\u0c41 \u0c30\u0c24\u0c4d\u0c30\u0c2f\u0c2e\u0c46 \u0c30\u0c3f\u0c24\u0c4d\u0c24\u0c2a\u0c46\u0c30\u0c41\u0c2e\u0c3e\u0c28\u0c41\u0c2e\u0c4d"}, {"M": "\u0c1a\u0c30\u0c23\u0c2e\u0c4d 3", "T": "\u0c28\u0c3f\u0c30\u0c41\u0c2a\u0c15\u0c41\u0c30\u0c41 \u0c2a\u0c30\u0c15\u0c41\u0c2e\u0c30 \u0c0e\u0c28\u0c4d\u0c31\u0c46\u0c28\u0c4d\u0c31\u0c41 \u0c2a\u0c24\u0c4d\u0c24\u0c3f\u0c15\u0c4a\u0c1f\u0c41 <br/> \u0c2a\u0c30\u0c35\u0c3e\u0c30\u0c41 \u0c33\u0c3f\u0c2f\u0c2e\u0c35\u0c41\u0c28 \u0c2e\u0c28\u0c4d\u0c24\u0c4d\u0c30\u0c28\u0c4d\u0c24 \u0c28\u0c48\u0c2a\u0c4d\u0c2a\u0c34\u0c48\u0c2f <br/> \u0c28\u0c3f\u0c28\u0c24\u0c41\u0c35\u0c34\u0c3f \u0c2f\u0c1f\u0c3f\u0c2e\u0c48\u0c2f\u0c41\u0c2e\u0c4d\u0c35\u0c3f \u0c33\u0c19\u0c4d\u0c15\u0c41\u0c2e\u0c4d\u0c2a \u0c1f\u0c3f\u0c15\u0c4d\u0c15\u0c3f\u0c28\u0c3f\u0c24\u0c41 \u0c23\u0c30\u0c4d\u0c24\u0c4d\u0c24\u0c3f\u0c2f\u0c30\u0c41\u0c33\u0c4d\u0c35\u0c3e\u0c2f\u0c47"}, {"M": "\u0c1a\u0c30\u0c23\u0c2e\u0c4d 4", "T": "\u0c24\u0c15\u0c41\u0c24\u0c15\u0c41\u0c15\u