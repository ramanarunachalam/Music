4a\u0c23\u0c4d\u0c1f\u0c3f\u0c28\u0c4d\u0c2a\u0c41 \u0c31\u0c2a\u0c4d\u0c2a\u0c1f\u0c41\u0c15 \u0c33\u0c24\u0c4d\u0c24\u0c3f\u0c32\u0c4a\u0c30\u0c41\u0c15\u0c4b\u0c1f\u0c3f"}, {"M": "\u0c1a\u0c30\u0c23\u0c2e\u0c4d 7", "T": "\u0c2e\u0c41\u0c24\u0c41\u0c15\u0c34\u0c41\u0c15\u0c41 \u0c15\u0c4a\u0c1f\u0c3f\u0c15\u0c30\u0c41\u0c1f \u0c28\u0c19\u0c4d\u0c15\u0c2e\u0c4d\u0c2a\u0c4a \u0c30\u0c15\u0c4d\u0c15\u0c41\u0c30\u0c41\u0c24\u0c3f <br/> \u0c28\u0c24\u0c3f\u0c2a\u0c46\u0c30\u0c41\u0c15 \u0c35\u0c46\u0c15\u0c41\u0c2e\u0c41\u0c15\u0c15 \u0c35\u0c28\u0c4d\u0c24\u0c19\u0c4d\u0c15\u0c33\u0c4d \u0c28\u0c3f\u0c30\u0c4d\u0c24\u0c4d\u0c24\u0c2e\u0c3f\u0c1f <br/> \u0c2e\u0c41\u0c30\u0c1a\u0c24\u0c3f\u0c30 \u0c28\u0c3f\u0c1a\u0c3f\u0c1a\u0c30\u0c30\u0c48 \u0c35\u0c46\u0c28\u0c4d\u0c31\u0c3f\u0c28\u0c4d\u0c24\u0c3f \u0c30\u0c31\u0c4d\u0c15\u0c30\u0c1a \u0c33\u0c3f\u0c24\u0c4d\u0c24\u0c2a\u0c46\u0c30\u0c41\u0c2e\u0c3e\u0c33\u0c47."}]}, {"L": "Kannada", "text": [{"M": "\u0caa\u0cb2\u0ccd\u0cb2\u0cb5\u0cbf", "T": "\u0c85\u0c97\u0cb0\u0cae\u0cc1\u0ca6 \u0cb2\u0cc6\u0ca8\u0cb5\u0cc1\u0cb0\u0cc8\u0c9a\u0cc6\u0caf\u0ccd \u0c90\u0cae\u0ccd\u0caa\u0ca8\u0ccd\u0ca4\u0cca \u0cb0\u0c95\u0ccd\u0cb7\u0cb0\u0cae\u0cc1\u0cae\u0ccd <br/> \u0c85\u0c95\u0cbf\u0cb2\u0c95\u0cb2\u0cc8 \u0c95\u0cb3\u0cc1\u0cae\u0ccd\u0cb5\u0cc6\u0c95\u0cc1\u0cb5\u0cbf \u0ca4\u0c99\u0ccd\u0c95\u0cca\u0ca3\u0ccd\u0c9f \u0ca4\u0ca4\u0ccd\u0ca4\u0cc1\u0cb5\u0cae\u0cc1\u0cae\u0ccd <br/> \u0c85\u0caa\u0cb0\u0cbf\u0cae\u0cbf\u0ca4 \u0c9a\u0cc1\u0cb0\u0cc1\u0ca4\u0cbf\u0caf\u0cc1\u0cae \u0c9f\u0c99\u0ccd\u0c95\u0cc1\u0ca8\u0ccd\u0ca4 \u0ca8\u0cbf\u0caa\u0ccd\u0caa\u0cca\u0cb0\u0cc1\u0cb3\u0cc8 \u0c8e\u0caa\u0ccd\u0caa\u0cca\u0cb0\u0cc1\u0cb3\u0cc1\u0cae\u0cbe\u0caf"}, {"M": "\u0c9a\u0cb0\u0ca3\u0cae\u0ccd 1", "T": "\u0c85\u0cb1\u0cbf\u0cb5\u0cc8\u0caf\u0cb1\u0cbf \u0caa\u0cb5\u0cb0\u0cb1\u0cbf\u0caf\u0cc1\u0cae\u0ccd \u0c87\u0ca8\u0ccd\u0caa\u0ca8\u0ccd\u0ca4 \u0ca8\u0cc8\u0ca4\u0ccd\u0ca4\u0cc1\u0cb0\u0cbf\u0caf <br/> \u0cae\u0cc1\u0c9f\u0cbf\u0cb5\u0cc8\u0c85\u0c9f\u0cbf \u0ca8\u0c9f\u0cc1\u0cae\u0cc1\u0c9f\u0cbf\u0cb5\u0cbf\u0cb2\u0ccd \u0ca4\u0cc1\u0c99\u0ccd\u0c95\u0ca8\u0ccd\u0ca4 \u0ca8\u0cc8\u0c9a\u0ccd\u0c9a\u0cbf\u0cb1\u0cbf\u0caf <br/> \u0c85\u0ca3\u0cc1\u0cb5\u0cc8\u0caf\u0ca3\u0cc1 \u0cb5\u0cbf\u0ca8\u0cbf\u0ca8\u0ccd\u0cae\u0cb2\u0cae\u0cc1 \u0ca8\u0cc6\u0c9e\u0ccd\u0c9a\u0cc1\u0c99\u0ccd\u0c95\u0cc1 \u0ca3\u0ca4\u0ccd\u0cb0\u0caf\u0cae\u0cc1 \u0cae\u0c9f\u0ccd\u0cb1\u0ca4\u0cca\u0cb0\u0cc1\u0c95\u0cbe\u0cb2\u0cae\u0ccd"}, {"M": "\u0c9a\u0cb0\u0ca3\u0cae\u0ccd 2", "T": "\u0ca8\u0cbf\u0c95\u0cb3\u0cc1\u0cae\u0ccd\u0cb5\u0c9f\u0cbf \u0cb5\u0cbf\u0ca8\u0cc8\u0cae\u0cc1\u0c9f\u0cbf\u0cb5\u0cbf \u0cb2\u0cca\u0ca8\u0ccd\u0cb1\u0cc6\u0ca8\u0ccd\u0cb1\u0cbf \u0cb0\u0cc1\u0caa\u0ccd\u0caa\u0ca4\u0ca8\u0cc8 <br/> \u0ca8\u0cbf\u0cb1\u0cc8\u0cb5\u0cc1\u0c95\u0cc1\u0cb1\u0cc8 \u0cb5\u0cca\u0cb3\u0cbf\u0cb5\u0cb1\u0ca8\u0cbf \u0cb1\u0cc8\u0ca8\u0ccd\u0ca4\u0cc6\u0c99\u0ccd\u0c95\u0cc1 \u0ca8\u0cbf\u0cb1\u0ccd\u0caa\u0ca4\u0ca8\u0cc8 <br/> \u0ca8\u0cbf\u0c95\u0cb0\u0ccd\u0caa\u0c95\u0cb0 \u0c85\u0cb1\u0cbf\u0caf\u0ca4\u0cc8\u0cb5\u0cbf \u0c9a\u0cc1\u0cae\u0ccd\u0caa\u0cbf\u0ca8\u0ccd\u0caa\u0cc1 \u0cb0\u0ca4\u0ccd\u0cb0\u0caf\u0cae\u0cc6 \u0cb0\u0cbf\u0ca4\u0ccd\u0ca4\u0caa\u0cc6\u0cb0\u0cc1\u0cae\u0cbe\u0ca8\u0cc1\u0cae\u0ccd"}, {"M": "\u0c9a\u0cb0\u0ca3\u0cae\u0ccd 3", "T": "\u0ca8\u0cbf\u0cb0\u0cc1\u0caa\u0c95\u0cc1\u0cb0\u0cc1 \u0caa\u0cb0\u0c95\u0cc1\u0cae\u0cb0 \u0c8e\u0ca8\u0ccd\u0cb1\u0cc6\u0ca8\u0ccd\u0cb1\u0cc1 \u0caa\u0ca4\u0ccd\u0ca4\u0cbf\u0c95\u0cca\u0c9f\u0cc1 <br/> \u0caa\u0cb0\u0cb5\u0cbe\u0cb0\u0cc1 \u0cb3\u0cbf\u0caf\u0cae\u0cb5\u0cc1\u0ca8 \u0cae\u0ca8\u0ccd\u0ca4\u0ccd\u0cb0\u0ca8\u0ccd\u0ca4 \u0ca8\u0cc8\u0caa\u0ccd\u0caa\u0cb3\u0cc8\u0caf <br/> \u0ca8\u0cbf\u0ca8\u0ca4\u0cc1\u0cb5\u0cb3\u0cbf \u0caf\u0c9f\u0cbf\u0cae\u0cc8\u0caf\u0cc1\u0cae\u0ccd\u0cb5\u0cbf \u0cb3\u0c99\u0ccd\u0c95\u0cc1\u0cae\u0ccd\u0caa \u0c9f\u0cbf\u0c95\u0ccd\u0c95\u0cbf\u0ca8\u0cbf\u0ca4\u0cc1 \u0ca3\u0cb0\u0ccd\u0ca4\u0ccd\u0ca4\u0cbf\u0caf\u0cb0\u0cc1\u0cb3\u0ccd\u0cb5\u0cbe\u0caf\u0cc7"}, {"M": "\u0c9a\u0cb0\u0ca3\u0cae\u0ccd 4", "T": "\u0ca4\u0c95\u0cc1\u0ca4\u0c95\u0cc1\u0c95\u0cc1 \u0ca4\u0c95\u0cc1\u0ca4\u0c95\u0cc1\u0c95\u0cc1 \u0ca4\u0ca8\u0ccd\u0ca4\u0ca8\u0ccd\u0ca4 \u0c95\u0cc1\u0ca4\u0ccd\u0ca4\u0c95\u0cc1\u0c95\u0cc1 <br/> \u0c9f\u0cbf\u0c95\u0cc1\u0c9f\u0cbf\u0c95\u0cc1\u0c95\u0cc1 \u0c9f\u0cbf\u0c95\u0cc1\u0c9f\u0cbf\u0c95\u0cc1\u0c95\u0cc1 \u0c9f\u0cbf\u0ca3\u0ccd\u0c9f\u0cbf\u0ca3\u0ccd\u0c9f\u0cbf \u0c95\u0cc1\u0c95\u0ccd\u0c95\u0cc1\u0c9f\u0cbf\u0c95\u0cc1 <br/> \u0ca4\u0c95\u0cc1\u0ca4\u0c95\u0cc6\u0ca3 \u0c95\u0cc6\u0ca3\u0c9a\u0cc6\u0c95\u0cc1\u0ca4 \u0ca4\u0ca8\u0ccd\u0ca4\u0ca8\u0ccd\u0ca4 \u0cb0\u0cbf\u0ca4\u0ccd\u0ca4\u0c95\u0cc1\u0ca4 \u0ca4\u0ca4\u0ccd\u0ca4\u0ca4\u0c95\u0cc1\u0ca4\u0cc0\u0ca4\u0ccb"}, {"M": "\u0c9a\u0cb0\u0ca3\u0cae\u0ccd 5", "T": "\u0ca4\u0ca8\u0ca4\u0ca8\u0ca8 \u0ca4\u0ca8\u0ca4\u0ca8\u0ca8 \u0ca4\u0ca8\u0ccd\u0ca4\u0ca8\u0ccd\u0ca4 \u0ca8\u0ca4\u0ccd\u0ca4\u0ca4\u0ca8 <br/> \u0c9f\u0cc1\u0c9f\u0cc1\u0c9f\u0cc1\u0c9f\u0cc1\u0c9f\u0cc1 \u0c9f\u0cc1\u0c9f\u0cc1\u0c9f\u0cc1\u0c9f\u0cc1\u0c9f\u0cc1 \u0c9f\u0cc1\u0ca3\u0ccd\u0c9f\u0cc1\u0ca3\u0ccd\u0c9f\u0cc1 \u0c9f\u0cc1\u0c9f\u0ccd\u0c9f\u0cc1\u0c9f\u0cc1\u0c9f\u0cc1 <br/> \u0ca4\u0cb0\u0cb0\u0cb0\u0cb0 \u0cb0\u0cbf\u0cb0\u0cbf\u0cb0\u0cbf\u0cb0\u0cbf\u0cb0\u0cbf \u0caf\u0cc6\u0ca8\u0ccd\u0cb1\u0cc6\u0ca8\u0ccd\u0cb1\u0cbf \u0c9f\u0c95\u0ccd\u0c95\u0cc8\u0caf\u0cc1\u0cae\u0cc1 \u0c9f\u0cc1\u0c95\u0ccd\u0c95\u0cc8\u0caf\u0cc1\u0cae\u0cbf\u0caf\u0cbe\u0cb5\u0cc1\u0cae\u0ccd"}, {"M": "\u0c9a\u0cb0\u0ca3\u0cae\u0ccd 6", "T": "\u0cae\u0cca\u0c95\u0cc1\u0cae\u0cca\u0c95\u0cc6\u0ca8 \u0c85\u0ca4\u0cbf\u0cb0\u0cae\u0cc1\u0ca4\u0cbf \u0cb0\u0ca3\u0ccd\u0c9f\u0cae\u0ccd\u0caa\u0cbf \u0cb3\u0c95\u0ccd\u0c95\u0ca8\u0cbf\u0cae\u0cbf\u0cb0\u0ccd <br/> \u0c85\u0cb2\u0c95\u0cc8\u0c95\u0cb0 \u0ca3\u0cae\u0cbf\u0c9f\u0cb5\u0cc1\u0cb2 \u0c95\u0cc6\u0c99\u0ccd\u0c95\u0cc1\u0cae\u0ccd\u0caa\u0ccd\u0cb0 \u0cae\u0cbf\u0c95\u0ccd\u0c95\u0ca8\u0c9f <br/> \u0cae\u0cc1\u0c9f\u0cc1\u0c95\u0cc1\u0caa\u0caf\u0cbf \u0cb0\u0cb5\u0cb0\u0ccd\u0caa\u0cb5\u0cc1\u0cb0\u0cbf \u0c95\u0cca\u0ca3\u0ccd\u0c9f\u0cbf\u0ca8\u0ccd\u0caa\u0cc1 \u0cb1\u0caa\u0ccd\u0caa\u0c9f\u0cc1\u0c95 \u0cb3\u0ca4\u0ccd\u0ca4\u0cbf\u0cb2\u0cca\u0cb0\u0cc1\u0c95\u0ccb\u0c9f\u0cbf"}, {"M": "\u0c9a\u0cb0\u0ca3\u0cae\u0ccd 7", "T": "\u0cae\u0cc1\u0ca4\u0cc1\u0c95\u0cb3\u0cc1\u0c95\u0cc1 \u0c95\u0cca\u0c9f\u0cbf\u0c95\u0cb0\u0cc1\u0c9f \u0ca8\u0c99\u0ccd\u0c95\u0cae\u0ccd\u0caa\u0cca \u0cb0\u0c95\u0ccd\u0c95\u0cc1\u0cb0\u0cc1\u0ca4\u0cbf <br/> \u0ca8\u0ca4\u0cbf\u0caa\u0cc6\u0cb0\u0cc1\u0c95 \u0cb5\u0cc6\u0c95\u0cc1\u0cae\u0cc1\u0c95\u0c95 \u0cb5\u0ca8\u0ccd\u0ca4\u0c99\u0ccd\u0c95\u0cb3\u0ccd \u0ca8\u0cbf\u0cb0\u0ccd\u0ca4\u0ccd\u0ca4\u0cae\u0cbf\u0c9f <br/> \u0cae\u0cc1\u0cb0\u0c9a\u0ca4\u0cbf\u0cb0 \u0ca8\u0cbf\u0c9a\u0cbf\u0c9a\u0cb0\u0cb0\u0cc8 \u0cb5\u0cc6\u0ca8\u0ccd\u0cb1\u0cbf\u0ca8\u0ccd\u0ca4\u0cbf \u0cb0\u0cb1\u0ccd\u0c95\u0cb0\u0c9a \u0cb3\u0cbf\u0ca4\u0ccd\u0ca4\u0caa\u0cc6\u0cb0\u0cc1\u0cae\u0cbe\u0cb3\u0cc7."}]}, {"L": "Malayalam", "text": [{"M": "\u0d2a\u0d32\u0d4d\u0d32\u0d35\u0d3f", "T": "\u0d05\u0d17\u0d30\u0d2e\u0d41\u0d26 \u0d32\u0d46\u0d28\u0d35\u0d41\u0d30\u0d48\u0d1a\u0d46\u0d2f\u0d4d \u0d10\u0d2e\u0d4d\u0d2a\u0d28\u0d4d\u0d24\u0d4a \u0d30\u0d15\u0d4d\u0d37\u0d30\u0d2e\u0d41\u0d2e\u0d4d <br/> \u0d05\u0d15\u0d3f\u0d32\u0d15\u0d32\u0d48 \u0d15\u0d33\u0d41\u0d2e\u0d4d\u0d35\u0d46\u0d15\u0d41\u0d35\u0d3f \u0d24\u0d19\u0d4d\u0d15\u0d4a\u0d23\u0d4d\u0d1f \u0d24\u0d24\u0d4d\u0d24\u0d41\u0d35\u0d2e\u0d41\u0d2e\u0d4d <br/> \u0d05\u0d2a\u0d30\u0d3f\u0d2e\u0d3f\u0d24 \u0d1a\u0d41\u0d30\u0d41\u0d24\u0d3f\u0d2f\u0d41\u0d2e \u0d1f\u0d19\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d24 \u0d28\u0d3f\u0d2a\u0d4d\u0d2a\u0d4a\u0d30\u0d41\u0d33\u0d48 \u0d0e\u0d2a\u0d4d\u0d2a\u0d4a\u0d30\u0d41\u0d33\u0d41\u0d2e\u0d3e\u0d2f"}, {"M": "\u0d1a\u0d30\u0d23\u0d2e\u0d4d 1", "T": "\u0d05\u0d31\u0d3f\u0d35\u0d48\u0d2f\u0d31\u0d3f \u0d2a\u0d35\u0d30\u0d31\u0d3f\u0d2f\u0d41\u0d2e\u0d4d \u0d07\u0d28\u0d4d\u0d2a\u0d28\u0d4d\u0d24 \u0d28\u0d48\u0d24\u0d4d\u0d24\u0d41\u0d30\u0d3f\u0d2f <br/> \u0d2e\u0d41\u0d1f\u0d3f\u0d35\u0d48\u0d05\u0d1f\u0d3f \u0d28\u0d1f\u0d41\u0d2e\u0d41\u0d1f\u0d3f\u0d35\u0d3f\u0d32\u0d4d \u0d24\u0d41\u0d19\u0d4d\u0d15\u0d28\u0d4d\u0d24 \u0d28\u0d48\u0d1a\u0d4d\u0d1a\u0d3f\u0d31\u0d3f\u0d2f <br/> \u0d05\u0d23\u0d41\u0d35\u0d48\u0d2f\u0d23\u0d41 \u0d35\u0d3f\u0d28\u0d3f\u0d28\u0d4d\u0d2e\u0d32\u0d2e\u0d41 \u0d28\u0d46\u0d1e\u0d4d\u0d1a\u0d41\u0d19\u0d4d\u0d15\u0d41 \u0d23\u0d24\u0d4d\u0d30\u0d2f\u0d2e\u0d41 \u0d2e\u0d1f\u0d4d\u0d31\u0d24\u0d4a\u0d30\u0d41\u0d15\u0d3e\u0d32\u0d2e\u0d4d"}, {"M": "\u0d1a\u0d30\u0d23\u0d2e\u0d4d 2", "T": "\u0d28\u0d3f\u0d15\u0d34\u0d41\u0d2e\u0d4d\u0d35\u0d1f\u0d3f \u0d35\u0d3f\u0d28\u0d48\u0d2e\u0d41\u0d1f\u0d3f\u0d35\u0d3f \u0d32\u0d4a\u0d28\u0d4d\u0d31\u0d46\u0d28\u0d4d\u0d31\u0d3f \u0d30\u0d41\u0d2a\u0d4d\u0d2a\u0d24\u0d28\u0d48 <br/> \u0d28\u0d3f\u0d31\u0d48\u0d35\u0d41\u0d15\u0d41\u0d31\u0d48 \u0d35\u0d4a\u0d34\u0d3f\u0d35\u0d31\u0d28\u0d3f \u0d31\u0d48\u0d28\u0d4d\u0d24\u0d46\u0d19\u0d4d\u0d15\u0d41 \u0d28\u0d3f\u0d31\u0d4d\u0d2a\u0d24\u0d28\u0d48 <br/> \u0d28\u0d3f\u0d15\u0d30\u0d4d\u0d2a\u0d15\u0d30 \u0d05\u0d31\u0d3f\u0d2f\u0d24\u0d48\u0d35\u0d3f \u0d1a\u0d41\u0d2e\u0d4d\u0d2a\u0d3f\u0d28\u0d4d\u0d2a\u0d41 \u0d30\u0d24\u0d4d\u0d30\u0d2f\u0d2e\u0d46 \u0d30\u0d3f\u0d24\u0d4d\u0d24\u0d2a\u0d46\u0d30\u0d41\u0d2e\u0d3e\u0d28\u0d41\u0d2e\u0d4d"}, {"M": "\u0d1a\u0d30\u0d23\u0d2e\u0d4d 3", "T": "\u0d28\u0d3f\u0d30\u0d41\u0d2a\u0d15\u0d41\u0d30\u0d41 \u0d2a\u0d30\u0d15\u0d41\u0d2e\u0d30 \u0d0e\u0d28\u0d4d\u0d31\u0d46\u0d28\u0d4d\u0d31\u0d41 \u0d2a\u0d24\u0d4d\u0d24\u0d3f\u0d15\u0d4a\u0d1f\u0d41 <br/> \u0d2a\u0d30\u0d35\u0d3e\u0d30\u0d41 \u0d33\u0d3f\u0d2f\u0d2e\u0d35\u0d41\u0d28 \u0d2e\u0d28\u0d4d\u0d24\u0d4d\u0d30\u0d28\u0d4d\u0d24 \u0d28\u0d48\u0d2a\u0d4d\u0d2a\u0d34\u0d48\u0d2f <br/> \u0d28\u0d3f\u0d28\u0d24\u0d41\u0d35\u0d34\u0d3f \u0d2f\u0d1f\u0d3f\u0d2e\u0d48\u0d2f\u0d41\u0d2e\u0d4d\u0d35\u0d3f \u0d33\u0d19\u0d4d\u0d15\u0d41\u0d2e\u0d4d\u0d2a \u0d1f\u0d3f\u0d15\u0d4d\u0d15\u0d3f\u0d28\u0d3f\u0d24\u0d41 \u0d23\u0d30\u0d4d\u0d24\u0d4d\u0d24\u0d3f\u0d2f\u0d30\u0d41\u0d33\u0d4d\u0d35\u0d3e\u0d2f\u0d47"}, {"M": "\u0d1a\u0d30\u0d23\u0d2e\u0d4d 4", "T": "\u0d24\u0d15\u0d41\u0d24\u0d15\u0d41\u0d15\u0d41 \u0d24\u0d15\u0d41\u0d24\u0d15\u0d41\u0d15\u0d41 \u0d24\u0d28\u0d4d\u0d24\u0d28\u0d4d\u0d24 \u0d15\u0d41\u0d24\u0d4d\u0d24\u0d15\u0d41\u0d15\u0d41 <br/> \u0d1f\u0d3f\u0d15\u0d41\u0d1f\u0d3f\u0d15\u0d41\u0d15\u0d41 \u0d1f\u0d3f\u0d15\u0d41\u0d1f\u0d3f\u0d15\u0d41\u0d15\u0d41 \u0d1f\u0d3f\u0d23\u0d4d\u0d1f\u0d3f\u0d23\u0d4d\u0d1f\u0d3f \u0d15\u0d41\u0d15\u0d4d\u0d15\u0d41\u0d1f\u0d3f\u0d15\u0d41 <br/> \u0d24\u0d15\u0d41\u0d24\u0d15\u0d46\u0d23 \u0d15\u0d46\u0d23\u0d1a\u0d46\u0d15\u0d41\u0d24 \u0d24\u0d28\u0d4d\u0d24\u0d28\u0d4d\u0d24 \u0d30\u0d3f\u0d24\u0d4d\u0d24\u0d15\u0d41\u0d24 \u0d24\u0d24\u0d4d\u0d24\u0d24\u0d15\u0d41\u0d24\u0d40\u0d24\u0d4b"}, {"M": "\u0d1a\u0d30\u0d23\u0d2e\u0d4d 5", "T": "\u0d24\u0d28\u0d24\u0d28\u0d28 \u0d24\u0d28\u0d24\u0d28\u0d28 \u0d24\u0d28\u0d4d\u0d24\u0d28\u0d4d\u0d24 \u0d28\u0d24\u0d4d\u0d24\u0d24\u0d28 <br/> \u0d1f\u0d41\u0d1f\u0d41\u0d1f\u0d41\u0d1f\u0d41\u0d1f\u0d41 \u0d1f\u0d41\u0d1f\u0d41\u0d1f\u0d41\u0d1f\u0d41\u0d1f\u0d41 \u0d1f\u0d41\u0d23\u0d4d\u0d1f\u0d41\u0d23\u0d4d\u0d1f\u0d41 \u0d1f\u0d41\u0d1f\u0d4d\u0d1f\u0d41\u0d1f\u0d41\u0d1f\u0d41 <br/> \u0d24\u0d30\u0d30\u0d30\u0d30 \u0d30\u0d3f\u0d30\u0d3f\u0d30\u0d3f\u0d30\u0d3f\u0d30\u0d3f \u0d2f\u0d46\u0d28\u0d4d\u0d31\u0d46\u0d28\u0d4d\u0d31\u0d3f \u0d1f\u0d15\u0d4d\u0d15\u0d48\u0d2f\u0d41\u0d2e\u0d41 \u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d48\u0d2f\u0d41\u0d2e\u0d3f\u0d2f\u0d3e\u0d35\u0d41\u0d2e\u0d4d"}, {"M": "\u0d1a\u0d30\u0d23\u0d2e\u0d4d 6", "T": "\u0d2e\u0d4a\u0d15\u0d41\u0d2e\u0d4a\u0d15\u0d46\u0d28 \u0d05\u0d24\u0d3f\u0d30\u0d2e\u0d41\u0d24\u0d3f \u0d30\u0d23\u0d4d\u0d1f\u0d2e\u0d4d\u0d2a\u0d3f \u0d33\u0d15\u0d4d\u0d15\u0d28\u0d3f\u0d2e\u0d3f\u0d30\u0d4d <br/> \u0d05\u0d32\u0d15\u0d48\u0d15\u0d30 \u0d23\u0d2e\u0d3f\u0d1f\u0d35\u0d41\u0d32 \u0d15\u0d46\u0d19\u0d4d\u0d15\u0d41\u0d2e\u0d4d\u0d2a\u0d4d\u0d30 \u0d2e\u0d3f\u0d15\u0d4d\u0d15\u0d28\u0d1f <br/> \u0d2e\u0d41\u0d1f\u0d41\u0d15\u0d41\u0d2a\u0d2f\u0d3f \u0d30\u0d35\u0d30\u0d4d\u0d2a\u0d35\u0d41\u0d30\u0d3f \u0d15\u0d4a\u0d23\u0d4d\u0d1f\u0d3f\u0d28\u0d4d\u0d2a\u0d41 \u0d31\u0d2a\u0d4d\u0d2a\u0d1f\u0d41\u0d15 \u0d33\u0d24\u0d4d\u0d24\u0d3f\u0d32\u0d4a\u0d30\u0d41\u0d15\u0d4b\u0d1f\u0d3f"}, {"M": "\u0d1a\u0d30\u0d23\u0d2e\u0d4d 7", "T": "\u0d2e\u0d41\u0d24\u0d41\u0d15\u0d34\u0d41\u0d15\u0d41 \u0d15\u0d4a\u0d1f\u0d3f\u0d15\u0d30\u0d41\u0d1f \u0d28\u0d19\u0d4d\u0d15\u0d2e\u0d4d\u0d2a\u0d4a \u0d30\u0d15\u0d4d\u0d15\u0d41\u0d30\u0d41\u0d24\u0d3f <br/> \u0d28\u0d24\u0d3f\u0d2a\u0d46\u0d30\u0d41\u0d15 \u0d35\u0d46\u0d15\u0d41\u0d2e\u0d41\u0d15\u0d15 \u0d35\u0d28\u0d4d\u0d24\u0d19\u0d4d\u0d15\u0d33\u0d4d \u0d28\u0d3f\u0d30\u0d4d\u0d24\u0d4d\u0d24\u0d2e\u0d3f\u0d1f <br/> \u0d2e\u0d41\u0d30\u0d1a\u0d24\u0d3f\u0d30 \u0d28\u0d3f\u0d1a\u0d3f\u0d1a\u0d30\u0d30\u0d48 \u0d35\u0d46\u0d28\u0d4d\u0d31\u0d3f\u0d28\u0d4d\u0d24\u0d3f \u0d30\u0d31\u0d4d\u0d15\u0d30\u0d1a \u0d33\u0d3f\u0d24\u0d4d\u0d24\u0d2a\u0d46\u0d30\u0d41\u0d2e\u0d3e\u0d33\u0d47."}]}, {"L": "Sanskrit", "text": [{"M": "\u092a\u0932\u094d\u0932\u0935\u093f", "T": "\u0905\u0917\u0930\u092e\u0941\u0926 \u0932\u0947\u0928\u0935\u0941\u0930\u0948\u091a\u0947\u092f\u094d \u0910\u092e\u094d\u092a\u0928\u094d\u0924\u094b \u0930\u0915\u094d\u0937\u0930\u092e\u0941\u092e\u094d <br/> \u0905\u0915\u093f\u0932\u0915\u0932\u0948 \u0915\u0932\u0941\u092e\u094d\u0935\u0947\u0915\u0941\u0935\u093f \u0924\u0919\u094d\u0915\u094b\u0923\u094d\u091f \u0924\u0924\u094d\u0924\u0941\u0935\u092e\u0941\u092e\u094d <br/> \u0905\u092a\u0930\u093f\u092e\u093f\u0924 \u091a\u0941\u0930\u0941\u0924\u093f\u092f\u0941\u092e \u091f\u0919\u094d\u0915\u0941\u0928\u094d\u0924 \u0928\u093f\u092a\u094d\u092a\u094b\u0930\u0941\u0932\u0948 \u090f\u092a\u094d\u092a\u094b\u0930\u0941\u0932\u0941\u092e\u093e\u092f"}, {"M": "\u091a\u0930\u0923\u092e\u094d 1", "T": "\u0905\u0930\u093f\u0935\u0948\u092f\u0930\u093f \u092a\u0935\u0930\u0930\u093f\u092f\u0941\u092e\u094d \u0907\u0928\u094d\u092a\u0928\u094d\u0924 \u0928\u0948\u0924\u094d\u0924\u0941\u0930\u093f\u092f <br/> \u092e\u0941\u091f\u093f\u0935\u0948\u0905\u091f\u093f \u0928\u091f\u0941\u092e\u0941\u091f\u093f\u0935\u093f\u0932\u094d \u0924\u0941\u0919\u094d\u0915\u0928\u094d\u0924 \u0928\u0948\u091a\u094d\u091a\u093f\u0930\u093f\u092f <br/> \u0905\u0923\u0941\u0935\u0948\u092f\u0923\u0941 \u0935\u093f\u0928\u093f\u0928\u094d\u092e\u0932\u092e\u0941 \u0928\u0947\u091e\u094d\u091a\u0941\u0919\u094d\u0915\u0941 \u0923\u0924\u094d\u0930\u092f\u092e\u0941 \u092e\u091f\u094d\u0930\u0924\u094b\u0930\u0941\u0915\u093e\u0932\u092e\u094d"}, {"M": "\u091a\u0930\u0923\u092e\u094d 2", "T": "\u0928\u093f\u0915\u0932\u0941\u092e\u094d\u0935\u091f\u093f \u0935\u093f\u0928\u0948\u092e\u0941\u091f\u093f\u0935\u093f \u0932\u094b\u0928\u094d\u0930\u0947\u0928\u094d\u0930\u093f \u0930\u0941\u092a\u094d\u092a\u0924\u0928\u0948 <br/> \u0928\u093f\u0930\u0948\u0935\u0941\u0915\u0941\u0930\u0948 \u0935\u094b\u0932\u093f\u0935\u0930\u0928\u093f \u0930\u0948\u0928\u094d\u0924\u0947\u0919\u094d\u0915\u0941 \u0928\u093f\u0930\u094d\u092a\u0924\u0928\u0948 <br/> \u0928\u093f\u0915\u0930\u094d\u092a\u0915\u0930 \u0905\u0930\u093f\u092f\u0924\u0948\u0935\u093f \u091a\u0941\u092e\u094d\u092a\u093f\u0928\u094d\u092a\u0941 \u0930\u0924\u094d\u0930\u092f\u092e\u0947 \u0930\u093f\u0924\u094d\u0924\u092a\u0947\u0930\u0941\u092e\u093e\u0928\u0941\u092e\u094d"}, {"M": "\u091a\u0930\u0923\u092e\u094d 3", "T": "\u0928\u093f\u0930\u0941\u092a\u0915\u0941\u0930\u0941 \u092a\u0930\u0915\u0941\u092e\u0930 \u090f\u0928\u094d\u0930\u0947\u0928\u094d\u0930\u0941 \u092a\u0924\u094d\u0924\u093f\u0915\u094b\u091f\u0941 <br/> \u092a\u0930\u0935\u093e\u0930\u0941 \u0932\u093f\u092f\u092e\u0935\u0941\u0928 \u092e\u0928\u094d\u0924\u094d\u0930\u0928\u094d\u0924 \u0928\u0948\u092a\u094d\u092a\u0932\u0948\u092f <br/> \u0928\u093f\u0928\u0924\u0941\u0935\u0932\u093f \u092f\u091f\u093f\u092e\u0948\u092f\u0941\u092e\u094d\u0935\u093f \u0932\u0919\u094d\u0915\u0941\u092e\u094d\u092a \u091f\u093f\u0915\u094d\u0915\u093f\u0928\u093f\u0924\u0941 \u0923\u0930\u094d\u0924\u094d\u0924\u093f\u092f\u0930\u0941\u0932\u094d\u0935\u093e\u092f\u0947"}, {"M": "\u091a\u0930\u0923\u092e\u094d 4", "T": "\u0924\u0915\u0941\u0924\u0915\u0941\u0915\u0941 \u0924\u0915\u0941\u0924\u0915\u0941\u0915\u0941 \u0924\u0928\u094d\u0924\u0928\u094d\u0924 \u0915\u0941\u0924\u094d\u0924\u0915\u0941\u0915\u0941 <br/> \u091f\u093f\u0915\u0941\u091f\u093f\u0915\u0941\u0915\u0941 \u091f\u093f\u0915\u0941\u091f\u093f\u0915\u0941\u0915\u0941 \u091f\u093f\u0923\u094d\u091f\u093f\u0923\u094d\u091f\u093f \u0915\u0941\u0915\u094d\u0915\u0941\u091f\u093f\u0915\u0941 <br/> \u0924\u0915\u0941\u0924\u0915\u0947\u0923 \u0915\u0947\u0923\u091a\u0947\u0915\u0941\u0924 \u0924\u0928\u094d\u0924\u0928\u094d\u0924 \u0930\u093f\u0924\u094d\u0924\u0915\u0941\u0924 \u0924\u0924\u094d\u0924\u0924\u0915\u0941\u0924\u0940\u0924\u094b"}, {"M": "\u091a\u0930\u0923\u092e\u094d 5", "T": "\u0924\u0928\u0924\u0928\u0928 \u0924\u0928\u0924\u0928\u0928 \u0924\u0928\u094d\u0924\u0928\u094d\u0924 \u0928\u0924\u094d\u0924\u0924\u0928 <br/> \u091f\u0941\u091f\u0941\u091f\u0941\u091f\u0941\u091f\u0941 \u091f\u0941\u091f\u0941\u091f\u0941\u091f\u0941\u091f\u0941 \u091f\u0941\u0923\u094d\u091f\u0941\u0923\u094d\u091f\u0941 \u091f\u0941\u091f\u094d\u091f\u0941\u091f\u0941\u091f\u0941 <br/> \u0924\u0930\u0930\u0930\u0930 \u0930\u093f\u0930\u093f\u0930\u093f\u0930\u093f\u0930\u093f \u092f\u0947\u0928\u094d\u0930\u0947\u0928\u094d\u0930\u093f \u091f\u0915\u094d\u0915\u0948\u092f\u0941\u092e\u0941 \u091f\u0941\u0915\u094d\u0915\u0948\u092f\u0941\u092e\u093f\u092f\u093e\u0935\u0941\u092e\u094d"}, {"M": "\