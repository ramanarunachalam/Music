,10", "gujarati": "12,19,13,9,7,17,5,14,2,1,6,0,11,8,18,20,4,15,16,3,10", "punjabi": "12,19,13,9,7,17,5,14,2,1,6,0,11,8,18,20,4,3,10,15,16", "odia": "12,19,13,9,7,17,5,14,2,1,6,0,11,8,18,20,4,15,16,3,10", "assamese": "12,19,13,9,7,17,5,14,2,1,6,20,0,11,8,18,4,15,16,3,10"}, "lyricstext": [{"L": "English", "text": [{"M": "pallavi", "T": "amuta mURuco lAkiya tOkaiyar <br/> poruLu LAraiye nANaiyu nANaiye <br/> naruku vITitu tAnatil vArume nuraikURum"}, {"M": "caraNam 1", "T": "acaTu mAtarku vAtucol kETikaL <br/> teruvin mItuku lAviyu lAvikaL <br/> avarkaL mAyaipa TAmalke TAmalni naruLtArAy"}, {"M": "caraNam 2", "T": "kumari kALiva rAkima kEcuri <br/> kavuri mOTicu rArini rApari <br/> koTiya cUlicu TAraNi yAmaLi makamAyi"}, {"M": "caraNam 3", "T": "kuRaLu rUpamu rArica kOtari <br/> yulaka tAriutAripa rApari <br/> kurupa rArivi kArina mOkari apirAmi"}, {"M": "caraNam 4", "T": "camara nIlipu rArita nAyaki <br/> malaiku mArika pAlina nAraNi <br/> calila mArici vAyama nOkari paraiyOki"}, {"M": "caraNam 5", "T": "cavuri vIrimu nIrviTa pOjani <br/> tikiri mEvukai yALice yALoru <br/> cakala vEtamu mAyina tAyumai yaruLpAlA"}, {"M": "caraNam 6", "T": "timita mATucu rArini cAcarar <br/> muTika TORuka TAviyi TEyoru <br/> cilapa cAcuku NAlini NAmuNa viTumvElA"}, {"M": "caraNam 7", "T": "tiruvu lAvuco NEcara NAmalai <br/> mukilu lAvuvi mAnana vOnilai <br/> cikara mItuku lAviyu lAviya perumALE."}]}, {"L": "Tamil", "text": [{"M": "\u0baa\u0bb2\u0bcd\u0bb2\u0bb5\u0bbf", "T": "\u0b85\u0bae\u0bc1\u0ba4 \u0bae\u0bc2\u0bb1\u0bc1\u0b9a\u0bca \u0bb2\u0bbe\u0b95\u0bbf\u0baf \u0ba4\u0bcb\u0b95\u0bc8\u0baf\u0bb0\u0bcd <br/> \u0baa\u0bca\u0bb0\u0bc1\u0bb3\u0bc1 \u0bb3\u0bbe\u0bb0\u0bc8\u0baf\u0bc6 \u0ba8\u0bbe\u0ba3\u0bc8\u0baf\u0bc1 \u0ba8\u0bbe\u0ba3\u0bc8\u0baf\u0bc6 <br/> \u0ba8\u0bb0\u0bc1\u0b95\u0bc1 \u0bb5\u0bc0\u0b9f\u0bbf\u0ba4\u0bc1 \u0ba4\u0bbe\u0ba9\u0ba4\u0bbf\u0bb2\u0bcd \u0bb5\u0bbe\u0bb0\u0bc1\u0bae\u0bc6 \u0ba8\u0bc1\u0bb0\u0bc8\u0b95\u0bc2\u0bb1\u0bc1\u0bae\u0bcd"}, {"M": "\u0b9a\u0bb0\u0ba3\u0bae\u0bcd 1", "T": "\u0b85\u0b9a\u0b9f\u0bc1 \u0bae\u0bbe\u0ba4\u0bb0\u0bcd\u0b95\u0bc1 \u0bb5\u0bbe\u0ba4\u0bc1\u0b9a\u0bca\u0bb2\u0bcd \u0b95\u0bc7\u0b9f\u0bbf\u0b95\u0bb3\u0bcd <br/> \u0ba4\u0bc6\u0bb0\u0bc1\u0bb5\u0bbf\u0ba9\u0bcd \u0bae\u0bc0\u0ba4\u0bc1\u0b95\u0bc1 \u0bb2\u0bbe\u0bb5\u0bbf\u0baf\u0bc1 \u0bb2\u0bbe\u0bb5\u0bbf\u0b95\u0bb3\u0bcd <br/> \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0bbe\u0baf\u0bc8\u0baa \u0b9f\u0bbe\u0bae\u0bb2\u0bcd\u0b95\u0bc6 \u0b9f\u0bbe\u0bae\u0bb2\u0bcd\u0ba9\u0bbf \u0ba8\u0bb0\u0bc1\u0bb3\u0bcd\u0ba4\u0bbe\u0bb0\u0bbe\u0baf\u0bcd"}, {"M": "\u0b9a\u0bb0\u0ba3\u0bae\u0bcd 2", "T": "\u0b95\u0bc1\u0bae\u0bb0\u0bbf \u0b95\u0bbe\u0bb3\u0bbf\u0bb5 \u0bb0\u0bbe\u0b95\u0bbf\u0bae \u0b95\u0bc7\u0b9a\u0bc1\u0bb0\u0bbf <br/> \u0b95\u0bb5\u0bc1\u0bb0\u0bbf \u0bae\u0bcb\u0b9f\u0bbf\u0b9a\u0bc1 \u0bb0\u0bbe\u0bb0\u0bbf\u0ba9\u0bbf \u0bb0\u0bbe\u0baa\u0bb0\u0bbf <br/> \u0b95\u0bca\u0b9f\u0bbf\u0baf \u0b9a\u0bc2\u0bb2\u0bbf\u0b9a\u0bc1 \u0b9f\u0bbe\u0bb0\u0ba3\u0bbf \u0baf\u0bbe\u0bae\u0bb3\u0bbf \u0bae\u0b95\u0bae\u0bbe\u0baf\u0bbf"}, {"M": "\u0b9a\u0bb0\u0ba3\u0bae\u0bcd 3", "T": "\u0b95\u0bc1\u0bb1\u0bb3\u0bc1 \u0bb0\u0bc2\u0baa\u0bae\u0bc1 \u0bb0\u0bbe\u0bb0\u0bbf\u0b9a \u0b95\u0bcb\u0ba4\u0bb0\u0bbf <br/> \u0baf\u0bc1\u0bb2\u0b95 \u0ba4\u0bbe\u0bb0\u0bbf\u0b89\u0ba4\u0bbe\u0bb0\u0bbf\u0baa \u0bb0\u0bbe\u0baa\u0bb0\u0bbf <br/> \u0b95\u0bc1\u0bb0\u0bc1\u0baa \u0bb0\u0bbe\u0bb0\u0bbf\u0bb5\u0bbf \u0b95\u0bbe\u0bb0\u0bbf\u0ba9 \u0bae\u0bcb\u0b95\u0bb0\u0bbf \u0b85\u0baa\u0bbf\u0bb0\u0bbe\u0bae\u0bbf"}, {"M": "\u0b9a\u0bb0\u0ba3\u0bae\u0bcd 4", "T": "\u0b9a\u0bae\u0bb0 \u0ba8\u0bc0\u0bb2\u0bbf\u0baa\u0bc1 \u0bb0\u0bbe\u0bb0\u0bbf\u0ba4 \u0ba8\u0bbe\u0baf\u0b95\u0bbf <br/> \u0bae\u0bb2\u0bc8\u0b95\u0bc1 \u0bae\u0bbe\u0bb0\u0bbf\u0b95 \u0baa\u0bbe\u0bb2\u0bbf\u0ba9 \u0ba8\u0bbe\u0bb0\u0ba3\u0bbf <br/> \u0b9a\u0bb2\u0bbf\u0bb2 \u0bae\u0bbe\u0bb0\u0bbf\u0b9a\u0bbf \u0bb5\u0bbe\u0baf\u0bae \u0ba8\u0bcb\u0b95\u0bb0\u0bbf \u0baa\u0bb0\u0bc8\u0baf\u0bcb\u0b95\u0bbf"}, {"M": "\u0b9a\u0bb0\u0ba3\u0bae\u0bcd 5", "T": "\u0b9a\u0bb5\u0bc1\u0bb0\u0bbf \u0bb5\u0bc0\u0bb0\u0bbf\u0bae\u0bc1 \u0ba8\u0bc0\u0bb0\u0bcd\u0bb5\u0bbf\u0b9f \u0baa\u0bcb\u0b9c\u0ba9\u0bbf <br/> \u0ba4\u0bbf\u0b95\u0bbf\u0bb0\u0bbf \u0bae\u0bc7\u0bb5\u0bc1\u0b95\u0bc8 \u0baf\u0bbe\u0bb3\u0bbf\u0b9a\u0bc6 \u0baf\u0bbe\u0bb3\u0bca\u0bb0\u0bc1 <br/> \u0b9a\u0b95\u0bb2 \u0bb5\u0bc7\u0ba4\u0bae\u0bc1 \u0bae\u0bbe\u0baf\u0bbf\u0ba9 \u0ba4\u0bbe\u0baf\u0bc1\u0bae\u0bc8 \u0baf\u0bb0\u0bc1\u0bb3\u0bcd\u0baa\u0bbe\u0bb2\u0bbe"}, {"M": "\u0b9a\u0bb0\u0ba3\u0bae\u0bcd 6", "T": "\u0ba4\u0bbf\u0bae\u0bbf\u0ba4 \u0bae\u0bbe\u0b9f\u0bc1\u0b9a\u0bc1 \u0bb0\u0bbe\u0bb0\u0bbf\u0ba9\u0bbf \u0b9a\u0bbe\u0b9a\u0bb0\u0bb0\u0bcd <br/> \u0bae\u0bc1\u0b9f\u0bbf\u0b95 \u0b9f\u0bcb\u0bb1\u0bc1\u0b95 \u0b9f\u0bbe\u0bb5\u0bbf\u0baf\u0bbf \u0b9f\u0bc7\u0baf\u0bca\u0bb0\u0bc1 <br/> \u0b9a\u0bbf\u0bb2\u0baa \u0b9a\u0bbe\u0b9a\u0bc1\u0b95\u0bc1 \u0ba3\u0bbe\u0bb2\u0bbf\u0ba9\u0bbf \u0ba3\u0bbe\u0bae\u0bc1\u0ba3 \u0bb5\u0bbf\u0b9f\u0bc1\u0bae\u0bcd\u0bb5\u0bc7\u0bb2\u0bbe"}, {"M": "\u0b9a\u0bb0\u0ba3\u0bae\u0bcd 7", "T": "\u0ba4\u0bbf\u0bb0\u0bc1\u0bb5\u0bc1 \u0bb2\u0bbe\u0bb5\u0bc1\u0b9a\u0bca \u0ba3\u0bc7\u0b9a\u0bb0 \u0ba3\u0bbe\u0bae\u0bb2\u0bc8 <br/> \u0bae\u0bc1\u0b95\u0bbf\u0bb2\u0bc1 \u0bb2\u0bbe\u0bb5\u0bc1\u0bb5\u0bbf \u0bae\u0bbe\u0ba9\u0ba9 \u0bb5\u0bcb\u0ba9\u0bbf\u0bb2\u0bc8 <br/> \u0b9a\u0bbf\u0b95\u0bb0 \u0bae\u0bc0\u0ba4\u0bc1\u0b95\u0bc1 \u0bb2\u0bbe\u0bb5\u0bbf\u0baf\u0bc1 \u0bb2\u0bbe\u0bb5\u0bbf\u0baf \u0baa\u0bc6\u0bb0\u0bc1\u0bae\u0bbe\u0bb3\u0bc7."}]}, {"L": "Telugu", "text": [{"M": "\u0c2a\u0c32\u0c4d\u0c32\u0c35\u0c3f", "T": "\u0c05\u0c2e\u0c41\u0c24 \u0c2e\u0c42\u0c31\u0c41\u0c1a\u0c4a \u0c32\u0c3e\u0c15\u0c3f\u0c2f \u0c24\u0c4b\u0c15\u0c48\u0c2f\u0c30\u0c4d <br/> \u0c2a\u0c4a\u0c30\u0c41\u0c33\u0c41 \u0c33\u0c3e\u0c30\u0c48\u0c2f\u0c46 \u0c28\u0c3e\u0c23\u0c48\u0c2f\u0c41 \u0c28\u0c3e\u0c23\u0c48\u0c2f\u0c46 <br/> \u0c28\u0c30\u0c41\u0c15\u0c41 \u0c35\u0c40\u0c1f\u0c3f\u0c24\u0c41 \u0c24\u0c3e\u0c28\u0c24\u0c3f\u0c32\u0c4d \u0c35\u0c3e\u0c30\u0c41\u0c2e\u0c46 \u0c28\u0c41\u0c30\u0c48\u0c15\u0c42\u0c31\u0c41\u0c2e\u0c4d"}, {"M": "\u0c1a\u0c30\u0c23\u0c2e\u0c4d 1", "T": "\u0c05\u0c1a\u0c1f\u0c41 \u0c2e\u0c3e\u0c24\u0c30\u0c4d\u0c15\u0c41 \u0c35\u0c3e\u0c24\u0c41\u0c1a\u0c4a\u0c32\u0c4d \u0c15\u0c47\u0c1f\u0c3f\u0c15\u0c33\u0c4d <br/> \u0c24\u0c46\u0c30\u0c41\u0c35\u0c3f\u0c28\u0c4d \u0c2e\u0c40\u0c24\u0c41\u0c15\u0c41 \u0c32\u0c3e\u0c35\u0c3f\u0c2f\u0c41 \u0c32\u0c3e\u0c35\u0c3f\u0c15\u0c33\u0c4d <br/> \u0c05\u0c35\u0c30\u0c4d\u0c15\u0c33\u0c4d \u0c2e\u0c3e\u0c2f\u0c48\u0c2a \u0c1f\u0c3e\u0c2e\u0c32\u0c4d\u0c15\u0c46 \u0c1f\u0c3e\u0c2e\u0c32\u0c4d\u0c28\u0c3f \u0c28\u0c30\u0c41\u0c33\u0c4d\u0c24\u0c3e\u0c30\u0c3e\u0c2f\u0c4d"}, {"M": "\u0c1a\u0c30\u0c23\u0c2e\u0c4d 2", "T": "\u0c15\u0c41\u0c2e\u0c30\u0c3f \u0c15\u0c3e\u0c33\u0c3f\u0c35 \u0c30\u0c3e\u0c15\u0c3f\u0c2e \u0c15\u0c47\u0c1a\u0c41\u0c30\u0c3f <br/> \u0c15\u0c35\u0c41\u0c30\u0c3f \u0c2e\u0c4b\u0c1f\u0c3f\u0c1a\u0c41 \u0c30\u0c3e\u0c30\u0c3f\u0c28\u0c3f \u0c30\u0c3e\u0c2a\u0c30\u0c3f <br/> \u0c15\u0c4a\u0c1f\u0c3f\u0c2f \u0c1a\u0c42\u0c32\u0c3f\u0c1a\u0c41 \u0c1f\u0c3e\u0c30\u0c23\u0c3f \u0c2f\u0c3e\u0c2e\u0c33\u0c3f \u0c2e\u0c15\u0c2e\u0c3e\u0c2f\u0c3f"}, {"M": "\u0c1a\u0c30\u0c23\u0c2e\u0c4d 3", "T": "\u0c15\u0c41\u0c31\u0c33\u0c41 \u0c30\u0c42\u0c2a\u0c2e\u0c41 \u0c30\u0c3e\u0c30\u0c3f\u0c1a \u0c15\u0c4b\u0c24\u0c30\u0c3f <br/> \u0c2f\u0c41\u0c32\u0c15 \u0c24\u0c3e\u0c30\u0c3f\u0c09\u0c24\u0c3e\u0c30\u0c3f\u0c2a \u0c30\u0c3e\u0c2a\u0c30\u0c3f <br/> \u0c15\u0c41\u0c30\u0c41\u0c2a \u0c30\u0c3e\u0c30\u0c3f\u0c35\u0c3f \u0c15\u0c3e\u0c30\u0c3f\u0c28 \u0c2e\u0c4b\u0c15\u0c30\u0c3f \u0c05\u0c2a\u0c3f\u0c30\u0c3e\u0c2e\u0c3f"}, {"M": "\u0c1a\u0c30\u0c23\u0c2e\u0c4d 4", "T": "\u0c1a\u0c2e\u0c30 \u0c28\u0c40\u0c32\u0c3f\u0c2a\u0c41 \u0c30\u0c3e\u0c30\u0c3f\u0c24 \u0c28\u0c3e\u0c2f\u0c15\u0c3f <br/> \u0c2e\u0c32\u0c48\u0c15\u0c41 \u0c2e\u0c3e\u0c30\u0c3f\u0c15 \u0c2a\u0c3e\u0c32\u0c3f\u0c28 \u0c28\u0c3e\u0c30\u0c23\u0c3f <br/> \u0c1a\u0c32\u0c3f\u0c32 \u0c2e\u0c3e\u0c30\u0c3f\u0c1a\u0c3f \u0c35\u0c3e\u0c2f\u0c2e \u0c28\u0c4b\u0c15\u0c30\u0c3f \u0c2a\u0c30\u0c48\u0c2f\u0c4b\u0c15\u0c3f"}, {"M": "\u0c1a\u0c30\u0c23\u0c2e\u0c4d 5", "T": "\u0c1a\u0c35\u0c41\u0c30\u0c3f \u0c35\u0c40\u0c30\u0c3f\u0c2e\u0c41 \u0c28\u0c40\u0c30\u0c4d\u0c35\u0c3f\u0c1f \u0c2a\u0c4b\u0c1c\u0c28\u0c3f <br/> \u0c24\u0c3f\u0c15\u0c3f\u0c30\u0c3f \u0c2e\u0c47\u0c35\u0c41\u0c15\u0c48 \u0c2f\u0c3e\u0c33\u0c3f\u0c1a\u0c46 \u0c2f\u0c3e\u0c33\u0c4a\u0c30\u0c41 <br/> \u0c1a\u0c15\u0c32 \u0c35\u0c47\u0c24\u0c2e\u0c41 \u0c2e\u0c3e\u0c2f\u0c3f\u0c28 \u0c24\u0c3e\u0c2f\u0c41\u0c2e\u0c48 \u0c2f\u0c30\u0c41\u0c33\u0c4d\u0c2a\u0c3e\u0c32\u0c3e"}, {"M": "\u0c1a\u0c30\u0c23\u0c2e\u0c4d 6", "T": "\u0c24\u0c3f\u0c2e\u0c3f\u0c24 \u0c2e\u0c3e\u0c1f\u0c41\u0c1a\u0c41 \u0c30\u0c3e\u0c30\u0c3f\u0c28\u0c3f \u0c1a\u0c3e\u0c1a\u0c30\u0c30\u0c4d <br/> \u0c2e\u0c41\u0c1f\u0c3f\u0c15 \u0c1f\u0c4b\u0c31\u0c41\u0c15 \u0c1f\u0c3e\u0c35\u0c3f\u0c2f\u0c3f \u0c1f\u0c47\u0c2f\u0c4a\u0c30\u0c41 <br/> \u0c1a\u0c3f\u0c32\u0c2a \u0c1a\u0c3e\u0c1a\u0c41\u0c15\u0c41 \u0c23\u0c3e\u0c32\u0c3f\u0c28\u0c3f \u0c23\u0c3e\u0c2e\u0c41\u0c23 \u0c35\u0c3f\u0c1f\u0c41\u0c2e\u0c4d\u0c35\u0c47\u0c32\u0c3e"}, {"M": "\u0c1a\u0c30\u0c23\u0c2e\u0c4d 7", "T": "\u0c24\u0c3f\u0c30\u0c41\u0c35\u0c41 \u0c32\u0c3e\u0c35\u0c41\u0c1a\u0c4a \u0c23\u0c47\u0c1a\u0c30 \u0c23\u0c3e\u0c2e\u0c32\u0c48 <br/> \u0c2e\u0c41\u0c15\u0c3f\u0c32\u0c41 \u0c32\u0c3e\u0c35\u0c41\u0c35\u0c3f \u0c2e\u0c3e\u0c28\u0c28 \u0c35\u0c4b\u0c28\u0c3f\u0c32\u0c48 <br/> \u0c1a\u0c3f\u0c15\u0c30 \u0c2e\u0c40\u0c24\u0c41\u0c15\u0c41 \u0c32\u0c3e\u0c35\u0c3f\u0c2f\u0c41 \u0c32\u0c3e\u0c35\u0c3f\u0c2f \u0c2a\u0c46\u0c30\u0c41\u0c2e\u0c3e\u0c33\u0c47."}]}, {"L": "Kannada", "text": [{"M": "\u0caa\u0cb2\u0ccd\u0cb2\u0cb5\u0cbf", "T": "\u0c85\u0cae\u0cc1\u0ca4 \u0cae\u0cc2\u0cb1\u0cc1\u0c9a\u0cca \u0cb2\u0cbe\u0c95\u0cbf\u0caf \u0ca4\u0ccb\u0c95\u0cc8\u0caf\u0cb0\u0ccd <br/> \u0caa\u0cca\u0cb0\u0cc1\u0cb3\u0cc1 \u0cb3\u0cbe\u0cb0\u0cc8\u0caf\u0cc6 \u0ca8\u0cbe\u0ca3\u0cc8\u0caf\u0cc1 \u0ca8\u0cbe\u0ca3\u0cc8\u0caf\u0cc6 <br/> \u0ca8\u0cb0\u0cc1\u0c95\u0cc1 \u0cb5\u0cc0\u0c9f\u0cbf\u0ca4\u0cc1 \u0ca4\u0cbe\u0ca8\u0ca4\u0cbf\u0cb2\u0ccd \u0cb5\u0cbe\u0cb0\u0cc1\u0cae\u0cc6 \u0ca8\u0cc1\u0cb0\u0cc8\u0c95\u0cc2\u0cb1\u0cc1\u0cae\u0ccd"}, {"M": "\u0c9a\u0cb0\u0ca3\u0cae\u0ccd 1", "T": "\u0c85\u0c9a\u0c9f\u0cc1 \u0cae\u0cbe\u0ca4\u0cb0\u0ccd\u0c95\u0cc1 \u0cb5\u0cbe\u0ca4\u0cc1\u0c9a\u0cca\u0cb2\u0ccd \u0c95\u0cc7\u0c9f\u0cbf\u0c95\u0cb3\u0ccd <br/> \u0ca4\u0cc6\u0cb0\u0cc1\u0cb5\u0cbf\u0ca8\u0ccd \u0cae\u0cc0\u0ca4\u0cc1\u0c95\u0cc1 \u0cb2\u0cbe\u0cb5\u0cbf\u0caf\u0cc1 \u0cb2\u0cbe\u0cb5\u0cbf\u0c95\u0cb3\u0ccd <br/> \u0c85\u0cb5\u0cb0\u0ccd\u0c95\u0cb3\u0ccd \u0cae\u0cbe\u0caf\u0cc8\u0caa \u0c9f\u0cbe\u0cae\u0cb2\u0ccd\u0c95\u0cc6 \u0c9f\u0cbe\u0cae\u0cb2\u0ccd\u0ca8\u0cbf \u0ca8\u0cb0\u0cc1\u0cb3\u0ccd\u0ca4\u0cbe\u0cb0\u0cbe\u0caf\u0ccd"}, {"M": "\u0c9a\u0cb0\u0ca3\u0cae\u0ccd 2", "T": "\u0c95\u0cc1\u0cae\u0cb0\u0cbf \u0c95\u0cbe\u0cb3\u0cbf\u0cb5 \u0cb0\u0cbe\u0c95\u0cbf\u0cae \u0c95\u0cc7\u0c9a\u0cc1\u0cb0\u0cbf <br/> \u0c95\u0cb5\u0cc1\u0cb0\u0cbf \u0cae\u0ccb\u0c9f\u0cbf\u0c9a\u0cc1 \u0cb0\u0cbe\u0cb0\u0cbf\u0ca8\u0cbf \u0cb0\u0cbe\u0caa\u0cb0\u0cbf <br/> \u0c95\u0cca\u0c9f\u0cbf\u0caf \u0c9a\u0cc2\u0cb2\u0cbf\u0c9a\u0cc1 \u0c9f\u0cbe\u0cb0\u0ca3\u0cbf \u0caf\u0cbe\u0cae\u0cb3\u0cbf \u0cae\u0c95\u0cae\u0cbe\u0caf\u0cbf"}, {"M": "\u0c9a\u0cb0\u0ca3\u0cae\u0ccd 3", "T": "\u0c95\u0cc1\u0cb1\u0cb3\u0cc1 \u0cb0\u0cc2\u0caa\u0cae\u0cc1 \u0cb0\u0cbe\u0cb0\u0cbf\u0c9a \u0c95\u0ccb\u0ca4\u0cb0\u0cbf <br/> \u0caf\u0cc1\u0cb2\u0c95 \u0ca4\u0cbe\u0cb0\u0cbf\u0c89\u0ca4\u0cbe\u0cb0\u0cbf\u0caa \u0cb0\u0cbe\u0caa\u0cb0\u0cbf <br/> \u0c95\u0cc1\u0cb0\u0cc1\u0caa \u0cb0\u0cbe\u0cb0\u0cbf\u0cb5\u0cbf \u0c95\u0cbe\u0cb0\u0cbf\u0ca8 \u0cae\u0ccb\u0c95\u0cb0\u0cbf \u0c85\u0caa\u0cbf\u0cb0\u0cbe\u0cae\u0cbf"}, {"M": "\u0c9a\u0cb0\u0ca3\u0cae\u0ccd 4", "T": "\u0c9a\u0cae\u0cb0 \u0ca8\u0cc0\u0cb2\u0cbf\u0caa\u0cc1 \u0cb0\u0cbe\u0cb0\u0cbf\u0ca4 \u0ca8\u0cbe\u0caf\u0c95\u0cbf <br/> \u0cae\u0cb2\u0cc8\u0c95\u0cc1 \u0cae\u0cbe\u0cb0\u0cbf\u0c95 \u0caa\u0cbe\u0cb2\u0cbf\u0ca8 \u0ca8\u0cbe\u0cb0\u0ca3\u0cbf <br/> \u0c9a\u0cb2\u0cbf\u0cb2 \u0cae\u0cbe\u0cb0\u0cbf\u0c9a\u0cbf \u0cb5\u0cbe\u0caf\u0cae \u0ca8\u0ccb\u0c95\u0cb0\u0cbf \u0caa\u0cb0\u0cc8\u0caf\u0ccb\u0c95\u0cbf"}, {"M": "\u0c9a\u0cb0\u0ca3\u0cae\u0ccd 5", "T": "\u0c9a\u0cb5\u0cc1\u0cb0\u0cbf \u0cb5\u0cc0\u0cb0\u0cbf\u0cae\u0cc1 \u0ca8\u0cc0\u0cb0\u0ccd\u0cb5\u0cbf\u0c9f \u0caa\u0ccb\u0c9c\u0ca8\u0cbf <br/> \u0ca4\u0cbf\u0c95\u0cbf\u0cb0\u0cbf \u0cae\u0cc7\u0cb5\u0cc1\u0c95\u0cc8 \u0caf\u0cbe\u0cb3\u0cbf\u0c9a\u0cc6 \u0caf\u0cbe\u0cb3\u0cca\u0cb0\u0cc1 <br/> \u0c9a\u0c95\u0cb2 \u0cb5\u0cc7\u0ca4\u0cae\u0cc1 \u0cae\u0cbe\u0caf\u0cbf\u0ca8 \u0ca4\u0cbe\u0caf\u0cc1\u0cae\u0cc8 \u0caf\u0cb0\u0cc1\u0cb3\u0ccd\u0caa\u0cbe\u0cb2\u0cbe"}, {"M": "\u0c9a\u0cb0\u0ca3\u0cae\u0ccd 6", "T": "\u0ca4\u0cbf\u0cae\u0cbf\u0ca4 \u0cae\u0cbe\u0c9f\u0cc1\u0c9a\u0cc1 \u0cb0\u0cbe\u0cb0\u0cbf\u0ca8\u0cbf \u0c9a\u0cbe\u0c9a\u0cb0\u0cb0\u0ccd <br/> \u0cae\u0cc1\u0c9f\u0cbf\u0c95 \u0c9f\u0ccb\u0cb1\u0cc1\u0c95 \u0c9f\u0cbe\u0cb5\u0cbf\u0caf\u0cbf \u0c9f\u0cc7\u0caf\u0cca\u0cb0\u0cc1 <br/> \u0c9a\u0cbf\u0cb2\u0caa \u0c9a\u0cbe\u0c9a\u0cc1\u0c95\u0cc1 \u0ca3\u0cbe\u0cb2\u0cbf\u0ca8\u0cbf \u0ca3\u0cbe\u0cae\u0cc1\u0ca3 \u0cb5\u0cbf\u0c9f\u0cc1\u0cae\u0ccd\u0cb5\u0cc7\u0cb2\u0cbe"}, {"M": "\u0c9a\u0cb0\u0ca3\u0cae\u0ccd 7", "T": "\u0ca4\u0cbf\u0cb0\u0cc1\u0cb5\u0cc1 \u0cb2\u0cbe\u0cb5\u0cc1\u0c9a\u0cca \u0ca3\u0cc7\u0c9a\u0cb0 \u0ca3\u0cbe\u0cae\u0cb2\u0cc8 <br/> \u0cae\u0cc1\u0c95\u0cbf\u0cb2\u0cc1 \u0cb2\u0cbe\u0cb5\u0cc1\u0cb5\u0cbf \u0cae\u0cbe\u0ca8\u0ca8 \u0cb5\u0ccb\u0ca8\u0cbf\u0cb2\u0cc8 <br/> \u0c9a\u0cbf\u0c95\u0cb0 \u0cae\u0cc0\u0ca4\u0cc1\u0c95\u0cc1 \u0cb2\u0cbe\u0cb5\u0cbf\u0caf\u0cc1 \u0cb2\u0cbe\u0cb5\u0cbf\u0caf \u0caa\u0cc6\u0cb0\u0cc1\u0cae\u0cbe\u0cb3\u0cc7."}]}, {"L": "Malayalam", "text": [{"M": "\u0d2a\u0d32\u0d4d\u0d32\u0d35\u0d3f", "T": "\u0d05\u0d2e\u0d41\u0d24 \u0d2e\u0d42\u0d31\u0d41\u0d1a\u0d4a \u0d32\u0d3e\u0d15\u0d3f\u0d2f \u0d24\u0d4b\u0d15\u0d48\u0d2f\u0d30\u0d4d <br/> \u0d2a\u0d4a\u0d30\u0d41\u0d33\u0d41 \u0d33\u0d3e\u0d30\u0d48\u0d2f\u0d46 \u0d28\u0d3e\u0d23\u0d48\u0d2f\u0d41 \u0d28\u0d3e\u0d23\u0d48\u0d2f\u0d46 <br/> \u0d28\u0d30\u0d41\u0d15\u0d41 \u0d35\u0d40\u0d1f\u0d3f\u0d24\u0d41 \u0d24\u0d3e\u0d28\u0d24\u0d3f\u0d32\u0d4d \u0d35\u0d3e\u0d30\u0d41\u0d2e\u0d46 \u0d28\u0d41\u0d30\u0d48\u0d15\u0d42\u0d31\u0d41\u0d2e\u0d4d"}, {"M": "\u0d1a\u0d30\u0d23\u0d2e\u0d4d 1", "T": "\u0d05\u0d1a\u0d1f\u0d41 \u0d2e\u0d3e\u0d24\u0d30\u0d4d\u0d15\u0d41 \u0d35\u0d3e\u0d24\u0d41\u0d1a\u0d4a\u0d32\u0d4d \u0d15\u0d47\u0d1f\u0d3f\u0d15\u0d33\u0d4d <br/> \u0d24\u0d46\u0d30\u0d41\u0d35\u0d3f\u0d28\u0d4d \u0d2e\u0d40\u0d24\u0d41\u0d15\u0d41 \u0d32\u0d3e\u0d35\u0d3f\u0d2f\u0d41 \u0d32\u0d3e\u0d35\u0d3f\u0d15\u0d33\u0d4d <br/> \u0d05\u0d35\u0d30\u0d4d\u0d15\u0d33\u0d4d \u0d2e\u0d3e\u0d2f\u0d48\u0d2a \u0d1f\u0d3e\u0d2e\u0d32\u0d4d\u0d15\u0d46 \u0d1f\u0d3e\u0d2e\u0d32\u0d4d\u0d28\u0d3f \u0d28\u0d30\u0d41\u0d33\u0d4d\u0d24\u0d3e\u0d30\u0d3e\u0d2f\u0d4d"}, {"M": "\u0d1a\u0d30\u0d23\u0d2e\u0d4d 2", "T": "\u0d15\u0d41\u0d2e\u0d30\u0d3f \u0d15\u0d3e\u0d33\u0d3f\u0d35 \u0d30\u0d3e\u0d15\u0d3f\u0d2e \u0d15\u0d47\u0d1a\u0d41\u0d30\u0d3f <br/> \u0d15\u0d35\u0d41\u0d30\u0d3f \u0d2e\u0d4b\u0d1f\u0d3f\u0d1a\u0d41 \u0d30\u0d3e\u0d30\u0d3f\u0d28\u0d3f \u0d30\u0d3e\u0d2a\u0d30\u0d3f <br/> \u0d15\u0d4a\u0d1f\u0d3f\u0d2f \u0d1a\u0d42\u0d32\u0d3f\u0d1a\u0d41 \u0d1f\u0d3e\u0d30\u0d23\u0d3f \u0d2f\u0d3e\u0d2e\u0d33\u0d3f \u0d2e\u0d15\u0d2e\u0d3e\u0d2f\u0d3f"}, {"M": "\u0d1a\u0d30\u0d23\u0d2e\u0d4d 3", "T": "\u0d15\u0d41\u0d31\u0d33\u0d41 \u0d30\u0d42\u0d2a\u0d2e\u0d41 \u0d30\u0d3e\u0d30\u0d3f\u0d1a \u0d15\u0d4b\u0d24\u0d30\u0d3f <br/> \u0d2f\u0d41\u0d32\u0d15 \u0d24\u0d3e\u0d30\u0d3f\u0d09\u0d24\u0d3e\u0d30\u0d3f\u0d2a \u0d30\u0d3e\u0d2a\u0d30\u0d3f <br/> \u0d15\u0d41\u0d30\u0d41\u0d2a \u0d30\u0d3e\u0d30\u0d3f\u0d35\u0d3f \u0d15\u0d3e\u0d30\u0d3f\u0d28 \u0d2e\u0d4b\u0d15\u0d30\u0d3f \u0d05\u0d2a\u0d3f\u0d30\u0d3e\u0d2e\u0d3f"}, {"M": "\u0d1a\u0d30\u0d23\u0d2e\u0d4d 4", "T": "\u0d1a\u0d2e\u0d30 \u0d28\u0d40\u0d32\u0d3f\u0d2a\u0d41 \u0d30\u0d3e\u0d30\u0d3f\u0d24 \u0d28\u0d3e\u0d2f\u0d15\u0d3f <br/> \u0d2e\u0d32\u0d48\u0d15\u0d41 \u0d2e\u0d3e\u0d30\u0d3f\u0d15 \u0d2a\u0d3e\u0d32\u0d3f\u0d28 \u0d28\u0d3e\u0d30\u0d23\u0d3f <br/> \u0d1a\u0d32\u0d3f\u0d32 \u0d2e\u0d3e\u0d30\u0d3f\u0d1a\u0d3f \u0d35\u0d3e\u0d2f\u0d2e \u0d28\u0d4b\u0d15\u0d30\u0d3f \u0d2a\u0d30\u0d48\u0d2f\u0d4b\u0d15\u0d3f"}, {"M": "\u0d1a\u0d30\u0d23\u0d2e\u0d4d 5", "T": "\u0d1a\u0d35\u0d41\u0d30\u0d3f \u0d35\u0d40\u0d30\u0d3f\u0d2e\u0d41 \u0d28\u0d40\u0d30\u0d4d\u0d35\u0d3f\u0d1f \u0d2a\u0d4b\u0d1c\u0d28\u0d3f <br/> \u0d24\u0d3f\u0d15\u0d3f\u0d30\u0d3f \u0d2e\u0d47\u0d35\u0d41\u0d15\u0d48 \u0d2f\u0d3e\u0d33\u0d3f\u0d1a\u0d46 \u0d2f\u0d3e\u0d33\u0d4a\u0d30\u0d41 <br/> \u0d1a\u0d15\u0d32 \u0d35\u0d47\u0d24\u0d2e\u0d41 \u0d2e\u0d3e\u0d2f\u0d3f\u0d28 \u0d24\u0d3e\u0d2f\u0d41\u0d2e\u0d48 \u0d2f\u0d30\u0d41\u0d33\u0d4d\u0d2a\u0d3e\u0d32\u0d3e"}, {"M": "\u0d1a\u0d30\u0d23\u0d2e\u0d4d 6", "T": "\u0d24\u0d3f\u0d2e\u0d3f\u0d24 \u0d2e\u0d3e\u0d1f\u0d41\u0d1a\u0d41 \u0d30\u0d3e\u0d30\u0d3f\u0d28\u0d3f \u0d1a\u0d3e\u0d1a\u0d30\u0d30\u0d4d <br/> \u0d2e\u0d41\u0d1f\u0d3f\u0d15 \u0d1f\u0d4b\u0d31\u0d41\u0d15 \u0d1f\u0d3e\u0d35\u0d3f\u0d2f\u0d3f \u0d1f\u0d47\u0d2f\u0d4a\u0d30\u0d41 <br/> \u0d1a\u0d3f\u0d32\u0d2a \u0d1a\u0d3e\u0d1a\u0d41\u0d15\u0d41 \u0d23\u0d3e\u0d32\u0d3f\u0d28\u0d3f \u0d23\u0d3e\u0d2e\u0d41\u0d23 \u0d35\u0d3f\u0d1f\u0d41\u0d2e\u0d4d\u0d35\u0d47\u0d32\u0d3e"}, {"M": "\u0d1a\u0d30\u0d23\u0d2e\u0d4d 7", "T": "\u0d24\u0d3f\u0d30\u0d41\u0d35\u0d41 \u0d32\u0d3e\u0d35\u0d41\u0d1a\u0d4a \u0d23\u0d47\u0d1a\u0d30 \u0d23\u0d3e\u0d2e\u0d32\u0d48 <br/> \u0d2e\u0d41\u0d15\u0d3f\u0d32\u0d41 \u0d32\u0d3e\u0d35\u0d41\u0d35\u0d3f \u0d2e\u0d3e\u0d28\u0d28 \u0d35\u0d4b\u0d28\u0d3f\u0d32\u0d48 <br/> \u0d1a\u0d3f\u0d15\u0d30 \u0d2e\u0d40\u0d24\u0d41\u0d15\u0d41 \u0d32\u0d3e\u0d35\u0d3f\u0d2f\u0d41 \u0d32\u0d3e\u0d35\u0d3f\u0d2f \u0d2a\u0d46\u0d30\u0d41\u0d2e\u0d3e\u0d33\u0d47."}]}, {"L": "Sanskrit", "text": [{"M": "\u092a\u0932\u094d\u0932\u0935\u093f", "T": "\u0905\u092e\u0941\u0924 \u092e\u0942\u0930\u0941\u091a\u094b \u0932\u093e\u0915\u093f\u092f \u0924\u094b\u0915\u0948\u092f\u0930\u094d <br/> \u092a\u094b\u0930\u0941\u0932\u0941 \u0932\u093e\u0930\u0948\u092f\u0947 \u0928\u093e\u0923\u0948\u092f\u0941 \u0928\u093e\u0923\u0948\u092f\u0947 <br/> \u0928\u0930\u0941\u0915\u0941 \u0935\u0940\u091f\u093f\u0924\u0941 \u0924\u093e\u0928\u0924\u093f\u0932\u094d \u0935\u093e\u0930\u0941\u092e\u0947 \u0928\u0941\u0930\u0948\u0915\u0942\u0930\u0941\u092e\u094d"}, {"M": "\u091a\u0930\u0923\u092e\u094d 1", "T": "\u0905\u091a\u091f\u0941 \u092e\u093e\u0924\u0930\u094d\u0915\u0941 \u0935\u093e\u0924\u0941\u091a\u094b\u0932\u094d \u0915\u0947\u091f\u093f\u0915\u0932\u094d <br/> \u0924\u0947\u0930\u0941\u0935\u093f\u0928\u094d \u092e\u0940\u0924\u0941\u0915\u0941 \u0932\u093e\u0935\u093f\u092f\u0941 \u0932\u093e\u0935\u093f\u0915\u0932\u094d <br/> \u0905\u0935\u0930\u094d\u0915\u0932\u094d \u092e\u093e\u092f\u0948\u092a \u091f\u093e\u092e\u0932\u094d\u0915\u0947 \u091f\u093e\u092e\u0932\u094d\u0928\u093f \u0928\u0930\u0941\u0932\u094d\u0924\u093e\u0930\u093e\u092f\u094d"}, {"M": "\u091a\u0930\u0923\u092e\u094d 2", "T": "\u0915\u0941\u092e\u0930\u093f \u0915\u093e\u0932\u093f\u0935 \u0930\u093e\u0915\u093f\u092e \u0915\u0947\u091a\u0941\u0930\u093f <br/> \u0915\u0935\u0941\u0930\u093f \u092e\u094b\u091f\u093f\u091a\u0941 \u0930\u093e\u0930\u093f\u0928\u093f \u0930\u093e\u092a\u0930\u093f <br/> \u0915\u094b\u091f\u093f\u092f \u091a\u0942\u0932\u093f\u091a\u0941 \u091f\u093e\u0930\u0923\u093f \u092f\u093e\u092e\u0932\u093f \u092e\u0915\u092e\u093e\u092f\u093f"}, {"M": "\u091a\u0930\u0923\u092e\u094d 3", "T": "\u0915\u0941\u0930\u0932\u0941 \u0930\u0942\u092a\u092e\u0941 \u0930\u093e\u0930\u093f\u091a \u0915\u094b\u0924\u0930\u093f <br/> \u092f\u0941\u0932\u0915 \u0924\u093e\u0930\u093f\u0909\u0924\u093e\u0930\u093f\u092a \u0930\u093e\u092a\u0930\u093f <br/> \u0915\u0941\u0930\u0941\u092a \u0930\u093e\u0930\u093f\u0935\u093f \u0915\u093e\u0930\u093f\u0928 \u092e\u094b\u0915\u0930\u093f \u0905\u092a\u093f\u0930\u093e\u092e\u093f"}, {"M": "\u091a\u0930\u0923\u092e\u094d 4", "T": "\u091a\u092e\u0930 \u0928\u0940\u0932\u093f\u092a\u0941 \u0930\u093e\u0930\u093f\u0924 \u0928\u093e\u092f\u0915\u093f <br/> \u092e\u0932\u0948\u0915\u0941 \u092e\u093e\u0930\u093f\u0915 \u092a\u093e\u0932\u093f\u0928 \u0928\u093e\u0930\u0923\u093f <br/> \u091a\u0932\u093f\u0932 \u092e\u093e\u0930\u093f\u091a\u093f \u0935\u093e\u092f\u092e \u0928\u094b\u0915\u0930\u093f \u092a\u0930\u0948\u092f\u094b\u0915\u093f"}, {"M": "\u091a\u0930\u0923\u092e\u094d 5", "T": "\u091a\u0935\u0941\u0930\u093f \u0935\u0940\u0930\u093f\u092e\u0941 \u0928\u0940\u0930\u094d\u0935\u093f\u091f \u092a\u094b\u091c\u0928\u093f <br/> \u0924\u093f\u0915\u093f\u0930\u093f \u092e\u0947\u0935\u0941\u0915\u0948 \u092f\u093e\u0932\u093f\u091a\u0947 \u092f\u093e\u0932\u094b\u0930\u0941 <br/> \u091a\u0915\u0932 \u0935\u0947\u0924\u092e\u0941 \u092e\u093e\u092f\u093f\u0928 \u0924\u093e\u092f\u0941\u092e\u0948 \u092f\u0930\u0941\u0932\u094d\u092a\u093e\u0932\u093e"}, {"M": "\u091a\u0930\u0923\u092e\u094d 6", "T": "\u0924\u093f\u092e\u093f\u0924 \u092e\u093e\u091f\u0941\u091a\u0941 \u0930\u093e\u0930\u093f\u0928\u093f \u091a\u093e\u091a\u0930\u0930\u094d <br/> \u092e\u0941\u091f\u093f\u0915 \u091f\u094b\u0930\u0941\u0915 \u091f\u093e\u0935\u093f\u092f\u093f \u091f\u0947\u092f\u094b\u0930\u0941 <br/> \u091a\u093f\u0932\u092a \u091a\u093e\u091a\u0941\u0915\u0941 \u0923\u093e\u0932\u093f\u0928\u093f \u0923\u093e\u092e\u0941\u0923 \u0935\u093f\u091f\u0941\u092e\u094d\u0935\u0947\u0932\u093e"}, {"M": "\u091a\u0930\u0923\u092e\u094d 7", "T": "\u0924\u093f\u0930\u0941\u0935\u0941 \u0932\u093e\u0935\u0941\u091a\u094b \u0923\u0947\u091a\u0930 \u0923\u093e\u092e\u0932\u0948 <br/> \u092e\u0941\u0915\u093f\u0932\u0941 \u0932\u093e\u0935\u0941\u0935\u093f \u092e\u093e\u0928\u0928 \u0935\u094b\u0928\u093f\u0932\u0948 <br/> \u091a\u093f\u0915\u0930 \u092e\u0940\u0924\u0941\u0915\u0941 \u0932\u093e\u0935\u093f\u092f\u0941 \u0932\u093e\u0935\u093f\u092f \u092a\u0947\u0930\u0941\u092e\u093e\u0932\u0947."}]}], "L": "l", "lyricsref": [{"links": [{"N": "www.kaumaram.com", "L": "https://www.kaumaram.com/thiru/nnt0384_u.html"}]}]}