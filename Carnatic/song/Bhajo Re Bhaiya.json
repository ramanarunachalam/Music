 "\u0b9a\u0bb0\u0ba3\u0bae\u0bcd 3", "T": "\u0b95\u0bb9\u0ba4 \u0b95\u0baa\u0bc0\u0bb0\u0bbe \u0bb0\u0bbe\u0bae \u0ba8 \u0b9c\u0bbe\u0bb9\u0bc2\u0bae\u0bcd, \u0ba4\u0bbe \u0bae\u0bc1\u0b95 \u0ba4\u0bc2\u0bb2 \u0baa\u0bb0\u0bc0\u0964"}]}, {"L": "Telugu", "text": [{"M": "\u0c2a\u0c32\u0c4d\u0c32\u0c35\u0c3f", "T": "\u0c2d\u0c1c\u0c4b \u0c30\u0c47 \u0c2d\u0c48\u0c2f\u0c3e \u0c30\u0c3e\u0c2e \u0c17\u0c4b\u0c35\u0c3f\u0c28\u0c4d\u0c26 \u0c39\u0c30\u0c40\u0964"}, {"M": "\u0c1a\u0c30\u0c23\u0c2e\u0c4d 1", "T": "\u0c1c\u0c2a \u0c24\u0c2a \u0c38\u0c3e\u0c27\u0c28 \u0c28\u0c39\u0c40\u0c02 \u0c15\u0c1b\u0c41 \u0c32\u0c3e\u0c17\u0c24, \u0c16\u0c30\u0c1a\u0c24 \u0c28\u0c39\u0c40\u0c02 \u0c17\u0c20\u0c30\u0c40\u0964"}, {"M": "\u0c1a\u0c30\u0c23\u0c2e\u0c4d 2", "T": "\u0c38\u0c28\u0c4d\u0c24\u0c24 \u0c38\u0c2e\u0c4d\u0c2a\u0c24 \u0c38\u0c41\u0c16 \u0c15\u0c47 \u0c15\u0c3e\u0c30\u0c23, \u0c1c\u0c3e\u0c38\u0c4b\u0c02 \u0c2d\u0c42\u0c32 \u0c2a\u0c30\u0c40\u0964"}, {"M": "\u0c1a\u0c30\u0c23\u0c2e\u0c4d 3", "T": "\u0c15\u0c39\u0c24 \u0c15\u0c2c\u0c40\u0c30\u0c3e \u0c30\u0c3e\u0c2e \u0c28 \u0c1c\u0c3e\u0c39\u0c42\u0c02, \u0c24\u0c3e \u0c2e\u0c41\u0c16 \u0c27\u0c42\u0c32 \u0c2a\u0c30\u0c40\u0964"}]}, {"L": "Kannada", "text": [{"M": "\u0caa\u0cb2\u0ccd\u0cb2\u0cb5\u0cbf", "T": "\u0cad\u0c9c\u0ccb \u0cb0\u0cc7 \u0cad\u0cc8\u0caf\u0cbe \u0cb0\u0cbe\u0cae \u0c97\u0ccb\u0cb5\u0cbf\u0ca8\u0ccd\u0ca6 \u0cb9\u0cb0\u0cc0\u0964"}, {"M": "\u0c9a\u0cb0\u0ca3\u0cae\u0ccd 1", "T": "\u0c9c\u0caa \u0ca4\u0caa \u0cb8\u0cbe\u0ca7\u0ca8 \u0ca8\u0cb9\u0cc0\u0c82 \u0c95\u0c9b\u0cc1 \u0cb2\u0cbe\u0c97\u0ca4, \u0c96\u0cb0\u0c9a\u0ca4 \u0ca8\u0cb9\u0cc0\u0c82 \u0c97\u0ca0\u0cb0\u0cc0\u0964"}, {"M": "\u0c9a\u0cb0\u0ca3\u0cae\u0ccd 2", "T": "\u0cb8\u0ca8\u0ccd\u0ca4\u0ca4 \u0cb8\u0cae\u0ccd\u0caa\u0ca4 \u0cb8\u0cc1\u0c96 \u0c95\u0cc7 \u0c95\u0cbe\u0cb0\u0ca3, \u0c9c\u0cbe\u0cb8\u0ccb\u0c82 \u0cad\u0cc2\u0cb2 \u0caa\u0cb0\u0cc0\u0964"}, {"M": "\u0c9a\u0cb0\u0ca3\u0cae\u0ccd 3", "T": "\u0c95\u0cb9\u0ca4 \u0c95\u0cac\u0cc0\u0cb0\u0cbe \u0cb0\u0cbe\u0cae \u0ca8 \u0c9c\u0cbe\u0cb9\u0cc2\u0c82, \u0ca4\u0cbe \u0cae\u0cc1\u0c96 \u0ca7\u0cc2\u0cb2 \u0caa\u0cb0\u0cc0\u0964"}]}, {"L": "Malayalam", "text": [{"M": "\u0d2a\u0d32\u0d4d\u0d32\u0d35\u0d3f", "T": "\u0d2d\u0d1c\u0d4b \u0d30\u0d47 \u0d2d\u0d48\u0d2f\u0d3e \u0d30\u0d3e\u0d2e \u0d17\u0d4b\u0d35\u0d3f\u0d28\u0d4d\u0d26 \u0d39\u0d30\u0d40\u0964"}, {"M": "\u0d1a\u0d30\u0d23\u0d2e\u0d4d 1", "T": "\u0d1c\u0d2a \u0d24\u0d2a \u0d38\u0d3e\u0d27\u0d28 \u0d28\u0d39\u0d40\u0d02 \u0d15\u0d1b\u0d41 \u0d32\u0d3e\u0d17\u0d24, \u0d16\u0d30\u0d1a\u0d24 \u0d28\u0d39\u0d40\u0d02 \u0d17\u0d20\u0d30\u0d40\u0964"}, {"M": "\u0d1a\u0d30\u0d23\u0d2e\u0d4d 2", "T": "\u0d38\u0d28\u0d4d\u0d24\u0d24 \u0d38\u0d2e\u0d4d\u0d2a\u0d24 \u0d38\u0d41\u0d16 \u0d15\u0d47 \u0d15\u0d3e\u0d30\u0d23, \u0d1c\u0d3e\u0d38\u0d4b\u0d02 \u0d2d\u0d42\u0d32 \u0d2a\u0d30\u0d40\u0964"}, {"M": "\u0d1a\u0d30\u0d23\u0d2e\u0d4d 3", "T": "\u0d15\u0d39\u0d24 \u0d15\u0d2c\u0d40\u0d30\u0d3e \u0d30\u0d3e\u0d2e \u0d28 \u0d1c\u0d3e\u0d39\u0d42\u0d02, \u0d24\u0d3e \u0d2e\u0d41\u0d16 \u0d27\u0d42\u0d32 \u0d2a\u0d30\u0d40\u0964"}]}, {"L": "Sanskrit", "text": [{"M": "\u092a\u0932\u094d\u0932\u0935\u093f", "T": "\u092d\u091c\u094b \u0930\u0947 \u092d\u0948\u092f\u093e \u0930\u093e\u092e \u0917\u094b\u0935\u093f\u0928\u094d\u0926 \u0939\u0930\u0940\u0964"}, {"M": "\u091a\u0930\u0923\u092e\u094d 1", "T": "\u091c\u092a \u0924\u092a \u0938\u093e\u0927\u0928 \u0928\u0939\u0940\u0902 \u0915\u091b\u0941 \u0932\u093e\u0917\u0924, \u0916\u0930\u091a\u0924 \u0928\u0939\u0940\u0902 \u0917\u0920\u0930\u0940\u0964"}, {"M": "\u091a\u0930\u0923\u092e\u094d 2", "T": "\u0938\u0928\u094d\u0924\u0924 \u0938\u092e\u094d\u092a\u0924 \u0938\u0941\u0916 \u0915\u0947 \u0915\u093e\u0930\u0923, \u091c\u093e\u0938\u094b\u0902 \u092d\u0942\u0932 \u092a\u0930\u0940\u0964"}, {"M": "\u091a\u0930\u0923\u092e\u094d 3", "T": "\u0915\u0939\u0924 \u0915\u092c\u0940\u0930\u093e \u0930\u093e\u092e \u0928 \u091c\u093e\u0939\u0942\u0902, \u0924\u093e \u092e\u0941\u0916 \u0927\u0942\u0932 \u092a\u0930\u0940\u0964"}]}], "L": "l", "lyricsref": [{"links": [{"N": "gurumaa.com", "L": "https://gurumaa.com/lyrics/kabir/bhajo-re-bhaiya-rama-govind-hari"}]}]}