c8e\u0c82\u0c97\u0cc1\u0cae\u0ccd \u0c89\u0ca8\u0ccd\u0ca8\u0cc8\u0caf\u0cc7 \u0ca4\u0cc7\u0ca1\u0cbf \u0c93\u0ca6\u0cbf \u0cb5\u0cbe\u0ca6\u0cbf\u0ca8\u0cc7\u0ca8\u0ccd \u0caa\u0ccd\u0cb0\u0cad\u0ccb \u2013 \u0caa\u0cbe <br/> \u0cae\u0cb0\u0cb0\u0ccd \u0cad\u0cc0\u0cae \u0ca8\u0cbf\u0cb6\u0ccd\u0c95\u0cbe\u0cae\u0ca8\u0cc7 \u0cb5\u0cbf\u0cb1\u0cc8\u0cb5\u0cbf\u0ca8\u0cbf\u0cb2\u0ccd \u0caa\u0cb0\u0cbf\u0ca8\u0ccd\u0ca6\u0cc1 \u0ca8\u0cc0 \u0c8e\u0ca8\u0cc8 \u0c8f\u0c9f\u0ccd\u0cb1\u0cc1"}, {"M": "\u0c9a\u0cb0\u0ca3\u0cae\u0ccd 1", "T": "\u0ca8\u0cc0\u0cb0\u0c9c \u0ca8\u0caf\u0ca8 \u0caa\u0cbe\u0cb5\u0ca8"}, {"M": "\u0c9a\u0cb0\u0ca3\u0cae\u0ccd 2", "T": "\u0ca6\u0cc0\u0ca8 \u0cb0\u0c95\u0ccd\u0cb6\u0c95 \u0ca6\u0caf\u0cbe \u0cb8\u0ccd\u0cb5\u0cb0\u0cc2\u0caa"}, {"M": "\u0c9a\u0cb0\u0ca3\u0cae\u0ccd 3", "T": "\u0ca8\u0cbf\u0ca8\u0ccd \u0cb8\u0cb0\u0cbf \u0c8e\u0cb5\u0cb0\u0cc7 \u0ca8\u0cc0\u0cb0\u0ca7\u0cbf \u0cb5\u0cb0 \u0cb6\u0caf\u0ca8 \u0ca8\u0cc0\u0cb2 \u0cae\u0cc7\u0c98 \u0cb6\u0ccd\u0caf\u0cbe\u0cae\u0cb3\u0ca8\u0cc7 \u0ca8\u0cc0 \u0cb5\u0cb0\u0cc1\u0cb9"}, {"M": "\u0c9a\u0cb0\u0ca3\u0cae\u0ccd 4", "T": "\u0cae\u0ca8\u0ccd\u0cae\u0ca5\u0ca8\u0ccd \u0c95\u0ca3\u0cc8\u0cb9\u0cb3\u0ccd \u0cac\u0cbe\u0ca7\u0caf\u0cc8 \u0ca4\u0cbe\u0cb3\u0cb5\u0cc7 \u0c87\u0caf\u0cb2\u0cbe\u0ca6\u0cc1 \u0ca8\u0cbf\u0ca8\u0ccd\u0cb1\u0cbf\u0ca1\u0cc1\u0cae\u0ccd \u0c8e\u0ca8\u0ccd\u0ca6\u0ca8\u0ccd <br/> \u0cae\u0ca8\u0ca6\u0cc8 \u0c85\u0cb1\u0cbf\u0ca8\u0ccd\u0ca6\u0cc1 \u0c95\u0cb0\u0cc1\u0ca3\u0cc8 \u0caa\u0cc1\u0cb0\u0cbf\u0ca8\u0ccd\u0ca6\u0cc1 \u0caa\u0cb2 \u0c87\u0ca8\u0ccd\u0cac\u0cae\u0ccd \u0ca4\u0ca8\u0ccd\u0ca6\u0cc1 \u0c85\u0cb0\u0cc1\u0cb3\u0ccd\u0cb5\u0cbe\u0c87 \u0cae\u0cb9\u0cbf\u0cb3\u0ccd\u0ca8\u0ccd\u0ca6\u0cc1"}, {"M": "\u0c9a\u0cb0\u0ca3\u0cae\u0ccd 5", "T": "\u0cb8\u0cbe\u0cb0\u0cb8 \u0cb5\u0ca6\u0ca8 \u0c95\u0ccd\u0cb0\u0ccd\u0caa\u0cbe\u0c95\u0cb0\u0ca8\u0cc7 \u0cb0\u0cb5\u0cbf \u0cb6\u0cb6\u0cbf \u0ca4\u0cca\u0cb3\u0cc1\u0cae\u0ccd \u0caa\u0ca6\u0ca8\u0cc7 <br/> \u0c86\u0ca6\u0cbf \u0cae\u0cc2\u0cb2\u0ca8\u0cc7 \u0c86\u0c97\u0cae \u0ca8\u0cc1\u0ca4\u0ca8\u0cc7 \u0ca4\u0cc1\u0cae\u0ccd\u0cac\u0cc1\u0cb0\u0cc1 \u0ca8\u0cbe\u0cb0\u0ca6 \u0c97\u0cbe\u0ca8 \u0cb2\u0ccb\u0cb2 \u0c97\u0cc1\u0ca3 <br/> \u0cb6\u0cc0\u0cb2 \u0cb5\u0ca8\u0cae\u0cbe\u0cb2\u0ca8\u0cc7 \u0cb5\u0cbe \u0ca6\u0cbe\u0cae\u0ccb\u0ca6\u0cb0\u0ca8\u0cc7 \u0ca6\u0cbe\u0cb8\u0cb0\u0ccd \u0caa\u0ca3\u0cbf \u0c89\u0cae\u0cbe \u0cb8\u0ccb\u0ca6- <br/> \u0cb0\u0ca8\u0cc7 \u0cb5\u0cbe \u0cb5\u0cc7\u0ca6\u0cae\u0ccd \u0c95\u0cbe\u0ca4\u0ccd\u0ca4\u0cb5\u0ca8\u0cc7 \u0cb5\u0cc0\u0cb0\u0cb0\u0ccd \u0caf\u0cbe\u0cb5\u0cb0\u0cc1\u0cae\u0ccd \u0caa\u0ccb\u0c9f\u0ccd\u0cb1\u0cc1\u0cae\u0ccd \u0caa\u0cb0\u0cae\u0ca8\u0cc7"}]}, {"L": "Malayalam", "text": [{"M": "\u0d2a\u0d32\u0d4d\u0d32\u0d35\u0d3f", "T": "\u0d2e\u0d3e \u0d26\u0d2f\u0d48 \u0d2a\u0d41\u0d30\u0d3f\u0d35\u0d3e\u0d2f\u0d47 \u0d2e\u0d3e\u0d27\u0d35\u0d3e <br/> \u0d2e\u0d28\u0d4d\u0d26\u0d30 \u0d27\u0d30\u0d28\u0d47 \u0d2e\u0d28\u0d4d\u0d26\u0d39\u0d3e\u0d38\u0d28\u0d47"}, {"M": "\u0d05\u0d28\u0d41\u0d2a\u0d32\u0d4d\u0d32\u0d35\u0d3f", "T": "\u0d2a\u0d3e\u0d26 \u0d2e\u0d32\u0d30\u0d48\u0d2a\u0d4d\u0d2a\u0d23\u0d3f\u0d28\u0d4d\u0d26\u0d41 \u0d2a\u0d3e\u0d21\u0d3f\u0d28\u0d47\u0d28\u0d4d <br/> \u0d2a\u0d4b\u0d26\u0d41\u0d2e\u0d4d \u0d07\u0d28\u0d4d\u0d26 \u0d2a\u0d30\u0d3f\u0d39\u0d3e\u0d38\u0d2e\u0d4d \u0d28\u0d47\u0d36\u0d28\u0d47 <br/> \u0d35\u0d47\u0d26\u0d28\u0d48 \u0d2e\u0d40\u0d30\u0d3f \u0d0e\u0d02\u0d17\u0d41\u0d2e\u0d4d \u0d09\u0d28\u0d4d\u0d28\u0d48\u0d2f\u0d47 \u0d24\u0d47\u0d21\u0d3f \u0d13\u0d26\u0d3f \u0d35\u0d3e\u0d26\u0d3f\u0d28\u0d47\u0d28\u0d4d \u0d2a\u0d4d\u0d30\u0d2d\u0d4b \u2013 \u0d2a\u0d3e <br/> \u0d2e\u0d30\u0d30\u0d4d \u0d2d\u0d40\u0d2e \u0d28\u0d3f\u0d36\u0d4d\u0d15\u0d3e\u0d2e\u0d28\u0d47 \u0d35\u0d3f\u0d31\u0d48\u0d35\u0d3f\u0d28\u0d3f\u0d32\u0d4d \u0d2a\u0d30\u0d3f\u0d28\u0d4d\u0d26\u0d41 \u0d28\u0d40 \u0d0e\u0d28\u0d48 \u0d0f\u0d1f\u0d4d\u0d31\u0d41"}, {"M": "\u0d1a\u0d30\u0d23\u0d2e\u0d4d 1", "T": "\u0d28\u0d40\u0d30\u0d1c \u0d28\u0d2f\u0d28 \u0d2a\u0d3e\u0d35\u0d28"}, {"M": "\u0d1a\u0d30\u0d23\u0d2e\u0d4d 2", "T": "\u0d26\u0d40\u0d28 \u0d30\u0d15\u0d4d\u0d36\u0d15 \u0d26\u0d2f\u0d3e \u0d38\u0d4d\u0d35\u0d30\u0d42\u0d2a"}, {"M": "\u0d1a\u0d30\u0d23\u0d2e\u0d4d 3", "T": "\u0d28\u0d3f\u0d28\u0d4d \u0d38\u0d30\u0d3f \u0d0e\u0d35\u0d30\u0d47 \u0d28\u0d40\u0d30\u0d27\u0d3f \u0d35\u0d30 \u0d36\u0d2f\u0d28 \u0d28\u0d40\u0d32 \u0d2e\u0d47\u0d18 \u0d36\u0d4d\u0d2f\u0d3e\u0d2e\u0d33\u0d28\u0d47 \u0d28\u0d40 \u0d35\u0d30\u0d41\u0d39"}, {"M": "\u0d1a\u0d30\u0d23\u0d2e\u0d4d 4", "T": "\u0d2e\u0d28\u0d4d\u0d2e\u0d25\u0d28\u0d4d \u0d15\u0d23\u0d48\u0d39\u0d33\u0d4d \u0d2c\u0d3e\u0d27\u0d2f\u0d48 \u0d24\u0d3e\u0d33\u0d35\u0d47 \u0d07\u0d2f\u0d32\u0d3e\u0d26\u0d41 \u0d28\u0d3f\u0d28\u0d4d\u0d31\u0d3f\u0d21\u0d41\u0d2e\u0d4d \u0d0e\u0d28\u0d4d\u0d26\u0d28\u0d4d <br/> \u0d2e\u0d28\u0d26\u0d48 \u0d05\u0d31\u0d3f\u0d28\u0d4d\u0d26\u0d41 \u0d15\u0d30\u0d41\u0d23\u0d48 \u0d2a\u0d41\u0d30\u0d3f\u0d28\u0d4d\u0d26\u0d41 \u0d2a\u0d32 \u0d07\u0d28\u0d4d\u0d2c\u0d2e\u0d4d \u0d24\u0d28\u0d4d\u0d26\u0d41 \u0d05\u0d30\u0d41\u0d33\u0d4d\u0d35\u0d3e\u0d07 \u0d2e\u0d39\u0d3f\u0d34\u0d4d\u0d28\u0d4d\u0d26\u0d41"}, {"M": "\u0d1a\u0d30\u0d23\u0d2e\u0d4d 5", "T": "\u0d38\u0d3e\u0d30\u0d38 \u0d35\u0d26\u0d28 \u0d15\u0d4d\u0d30\u0d4d\u0d2a\u0d3e\u0d15\u0d30\u0d28\u0d47 \u0d30\u0d35\u0d3f \u0d36\u0d36\u0d3f \u0d24\u0d4a\u0d34\u0d41\u0d2e\u0d4d \u0d2a\u0d26\u0d28\u0d47 <br/> \u0d06\u0d26\u0d3f \u0d2e\u0d42\u0d32\u0d28\u0d47 \u0d06\u0d17\u0d2e \u0d28\u0d41\u0d24\u0d28\u0d47 \u0d24\u0d41\u0d2e\u0d4d\u0d2c\u0d41\u0d30\u0d41 \u0d28\u0d3e\u0d30\u0d26 \u0d17\u0d3e\u0d28 \u0d32\u0d4b\u0d32 \u0d17\u0d41\u0d23 <br/> \u0d36\u0d40\u0d32 \u0d35\u0d28\u0d2e\u0d3e\u0d32\u0d28\u0d47 \u0d35\u0d3e \u0d26\u0d3e\u0d2e\u0d4b\u0d26\u0d30\u0d28\u0d47 \u0d26\u0d3e\u0d38\u0d30\u0d4d \u0d2a\u0d23\u0d3f \u0d09\u0d2e\u0d3e \u0d38\u0d4b\u0d26- <br/> \u0d30\u0d28\u0d47 \u0d35\u0d3e \u0d35\u0d47\u0d26\u0d2e\u0d4d \u0d15\u0d3e\u0d24\u0d4d\u0d24\u0d35\u0d28\u0d47 \u0d35\u0d40\u0d30\u0d30\u0d4d \u0d2f\u0d3e\u0d35\u0d30\u0d41\u0d2e\u0d4d \u0d2a\u0d4b\u0d1f\u0d4d\u0d31\u0d41\u0d2e\u0d4d \u0d2a\u0d30\u0d2e\u0d28\u0d47"}]}, {"L": "Sanskrit", "text": [{"M": "\u092a\u0932\u094d\u0932\u0935\u093f", "T": "\u092e\u093e \u0926\u092f\u0948 \u092a\u0941\u0930\u093f\u0935\u093e\u092f\u0947 \u092e\u093e\u0927\u0935\u093e <br/> \u092e\u0928\u094d\u0926\u0930 \u0927\u0930\u0928\u0947 \u092e\u0928\u094d\u0926\u0939\u093e\u0938\u0928\u0947"}, {"M": "\u0905\u0928\u0941\u092a\u0932\u094d\u0932\u0935\u093f", "T": "\u092a\u093e\u0926 \u092e\u0932\u0930\u0948\u092a\u094d\u092a\u0923\u093f\u0928\u094d\u0926\u0941 \u092a\u093e\u0921\u093f\u0928\u0947\u0928\u094d <br/> \u092a\u094b\u0926\u0941\u092e\u094d \u0907\u0928\u094d\u0926 \u092a\u0930\u093f\u0939\u093e\u0938\u092e\u094d \u0928\u0947\u0936\u0928\u0947 <br/> \u0935\u0947\u0926\u0928\u0948 \u092e\u0940\u0930\u093f \u090f\u0902\u0917\u0941\u092e\u094d \u0909\u0928\u094d\u0928\u0948\u092f\u0947 \u0924\u0947\u0921\u093f \u0913\u0926\u093f \u0935\u093e\u0926\u093f\u0928\u0947\u0928\u094d \u092a\u094d\u0930\u092d\u094b \u2013 \u092a\u093e <br/> \u092e\u0930\u0930\u094d \u092d\u0940\u092e \u0928\u093f\u0936\u094d\u0915\u093e\u092e\u0928\u0947 \u0935\u093f\u0930\u0948\u0935\u093f\u0928\u093f\u0932\u094d \u092a\u0930\u093f\u0928\u094d\u0926\u0941 \u0928\u0940 \u090f\u0928\u0948 \u090f\u091f\u094d\u0930\u0941"}, {"M": "\u091a\u0930\u0923\u092e\u094d 1", "T": "\u0928\u0940\u0930\u091c \u0928\u092f\u0928 \u092a\u093e\u0935\u0928"}, {"M": "\u091a\u0930\u0923\u092e\u094d 2", "T": "\u0926\u0940\u0928 \u0930\u0915\u094d\u0936\u0915 \u0926\u092f\u093e \u0938\u094d\u0935\u0930\u0942\u092a"}, {"M": "\u091a\u0930\u0923\u092e\u094d 3", "T": "\u0928\u093f\u0928\u094d \u0938\u0930\u093f \u090f\u0935\u0930\u0947 \u0928\u0940\u0930\u0927\u093f \u0935\u0930 \u0936\u092f\u0928 \u0928\u0940\u0932 \u092e\u0947\u0918 \u0936\u094d\u092f\u093e\u092e\u0932\u0928\u0947 \u0928\u0