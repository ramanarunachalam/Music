e\u0ccd", "T": "\u0c9e\u0cbe\u0c95\u0cc7\u0cb6\u0cbf\u0cb0 \u0cae\u0ccb\u0cb0 \u0cae\u0cc1\u0c95\u0cc1\u0ca6 \u0cae\u0cc7\u0cb0\u0ccb\u0caa\u0ca4\u0cbf \u0cb8\u0ccb\u0caf\u0cbf <br/> \u0cb6\u0c82\u0c95 \u0c9b\u0c95\u0ccd\u0cb0 \u0c97\u0ca6\u0cbe \u0caa\u0ca6\u0ccd\u0cae \u0c95\u0ca8\u0ccd\u0ca6\u0cae\u0cbe\u0cb2 \u0cb8\u0ccb\u0caf\u0cbf <br/> \u0c9f\u0cbe\u0ca4 \u0cae\u0cbe\u0ca4 \u0caa\u0ccd\u0cb0\u0cbe\u0ca4 \u0cac\u0ca8\u0ccd\u0ca6\u0ccd\u0ca7\u0cc1 \u0c85\u0c86\u0caa\u0ca8\u0ccb \u0ca8 \u0c95\u0ccb\u0caf\u0cbf <br/> C\u0cb9\u0cbe\u0ca8\u0ccd\u0ca6 \u0ca6\u0caf\u0cc0 \u0c95\u0cc1\u0cb2\u0c95\u0cbf \u0c95\u0cbe\u0ca8 \u0c95\u0ccd\u0caf\u0cbe\u0c95\u0cb0\u0cc8\u0c95 \u0c95\u0ccb\u0caf\u0cbf <br/> \u0cb7\u0ca8\u0ccd\u0ca4\u0ca8 \u0cb8\u0c82\u0c97 \u0cac\u0cc8\u0ca4 \u0cac\u0cc8\u0ca4 \u0cb2\u0ccb\u0c95\u0cb2\u0cbe\u0c9c \u0c95\u0ccb\u0caf\u0cbf <br/> \u0c86\u0caa\u0ca4\u0ccb \u0caa\u0cbe\u0ca6 \u0caa\u0cc8\u0cb2\u0c95\u0caf\u0cbf \u0c9c\u0ca8\u0cc7 \u0cb8\u0cac\u0ccd \u0c95\u0ccb\u0caf\u0cbf <br/> \u0c86\u0cb8\u0cc1\u0cb5\u0ca8 \u0c9c\u0cb2 \u0cb8\u0cc0\u0ca8\u0ccd\u0c9b \u0cb8\u0cc0\u0ca8\u0ccd\u0c9b \u0caa\u0ccd\u0cb0\u0cc7\u0cae \u0caa\u0cc7\u0cb2\u0cbf \u0caa\u0cca\u0caf\u0cbf <br/> \u0c82\u0c88\u0cb0\u0cbe \u0caa\u0ccd\u0cb0\u0cad\u0cc1 \u0cb2\u0c97\u0ca8 \u0cb2\u0c97\u0cc0 \u0cb9\u0ccb\u0ca8\u0cbf \u0cb9\u0ccb\u0cb8 \u0cb9\u0ccb\u0caf\u0cbf"}]}, {"L": "Malayalam", "text": [{"M": "\u0d2a\u0d32\u0d4d\u0d32\u0d35\u0d3f", "T": "\u0d2e\u0d47\u0d30\u0d47 \u0d24\u0d4a \u0d17\u0d3f\u0d30\u0d3f\u0d27\u0d30 \u0d17\u0d4b\u0d2a\u0d32 \u0d26\u0d42\u0d38\u0d30\u0d4a \u0d28 \u0d15\u0d4b\u0d2f\u0d3f"}, {"M": "\u0d1a\u0d30\u0d23\u0d2e\u0d4d", "T": "\u0d1e\u0d3e\u0d15\u0d47\u0d36\u0d3f\u0d30 \u0d2e\u0d4b\u0d30 \u0d2e\u0d41\u0d15\u0d41\u0d26 \u0d2e\u0d47\u0d30\u0d4b\u0d2a\u0d24\u0d3f \u0d38\u0d4b\u0d2f\u0d3f <br/> \u0d36\u0d02\u0d15 \u0d1b\u0d15\u0d4d\u0d30 \u0d17\u0d26\u0d3e \u0d2a\u0d26\u0d4d\u0d2e \u0d15\u0d28\u0d4d\u0d26\u0d2e\u0d3e\u0d32 \u0d38\u0d4b\u0d2f\u0d3f <br/> \u0d1f\u0d3e\u0d24 \u0d2e\u0d3e\u0d24 \u0d2a\u0d4d\u0d30\u0d3e\u0d24 \u0d2c\u0d28\u0d4d\u0d26\u0d4d\u0d27\u0d41 \u0d05\u0d06\u0d2a\u0d28\u0d4b \u0d28 \u0d15\u0d4b\u0d2f\u0d3f <br/> C\u0d39\u0d3e\u0d28\u0d4d\u0d26 \u0d26\u0d2f\u0d40 \u0d15\u0d41\u0d32\u0d15\u0d3f \u0d15\u0d3e\u0d28 \u0d15\u0d4d\u0d2f\u0d3e\u0d15\u0d30\u0d48\u0d15 \u0d15\u0d4b\u0d2f\u0d3f <br/> \u0d37\u0d28\u0d4d\u0d24\u0d28 \u0d38\u0d02\u0d17 \u0d2c\u0d48\u0d24 \u0d2c\u0d48\u0d24 \u0d32\u0d4b\u0d15\u0d32\u0d3e\u0d1c \u0d15\u0d4b\u0d2f\u0d3f <br/> \u0d06\u0d2a\u0d24\u0d4b \u0d2a\u0d3e\u0d26 \u0d2a\u0d48\u0d32\u0d15\u0d2f\u0d3f \u0d1c\u0d28\u0d47 \u0d38\u0d2c\u0d4d \u0d15\u0d4b\u0d2f\u0d3f <br/> \u0d06\u0d38\u0d41\u0d35\u0d28 \u0d1c\u0d32 \u0d38\u0d40\u0d28\u0d4d\u0d1b \u0d38\u0d40\u0d28\u0d4d\u0d1b \u0d2a\u0d4d\u0d30\u0d47\u0d2e \u0d2a\u0d47\u0d32\u0d3f \u0d2a\u0d4a\u0d2f\u0d3f <br/> \u0d02\u0d08\u0d30\u0d3e \u0d2a\u0d4d\u0d30\u0d2d\u0d41 \u0d32\u0d17\u0d28 \u0d32\u0d17\u0d40 \u0d39\u0d4b\u0d28\u0d3f \u0d39\u0d4b\u0d38 \u0d39\u0d4b\u0d2f\u0d3f"}]}, {"L": "Sanskrit", "text": [{"M": "\u092a\u0932\u094d\u0932\u0935\u093f", "T": "\u092e\u0947\u0930\u0947 \u0924\u094b \u0917\u093f\u0930\u093f\u0927\u0930 \u0917\u094b\u092a\u0932 \u0926\u0942\u0938\u0930\u094b \u0928 \u0915\u094b\u092f\u093f"}, {"M": "\u091a\u0930\u0923\u092e\u094d", "T": "\u091e\u093e\u0915\u0947\u0936\u093f\u0930 \u092e\u094b\u0930 \u092e\u0941\u0915\u0941\u0926 \u092e\u0947\u0930\u094b\u092a\u0924\u093f \u0938\u094b\u092f\u093f <br/> \u0936\u0902\u0915 \u091b\u0915\u094d\u0930 \u0917\u0926\u093e \u092a\u0926\u094d\u092e \u0915\u0928\u094d\u0926\u092e\u093e\u0932 \u0938\u094b\u092f\u093f <br/> \u091f\u093e\u0924 \u092e\u093e\u0924 \u092a\u094d\u0930\u093e\u0924 \u092c\u0928\u094d\u0926\u094d\u0927\u0941 \u0905\u0906\u092a\u0928\u094b \u0928 \u0915\u094b\u092f\u093f <br/> C\u0939\u093e\u0928\u094d\u0926 \u0926\u092f\u0940 \u0915\u0941\u0932\u0915\u093f \u0915\u093e\u0928 \u0915\u094d\u092f\u093e\u0915\u0930\u0948\u0915 \u0915\u094b\u092f\u093f 