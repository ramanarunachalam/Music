23\u0d4d\u0d21\u0d47"}, {"M": "\u0d05\u0d28\u0d41\u0d2a\u0d32\u0d4d\u0d32\u0d35\u0d3f", "T": "\u0d35\u0d3f\u0d27\u0d40\u0d28\u0d4d\u0d26\u0d4d\u0d30\u0d28\u0d41\u0d1a\u0d47 \u0d35\u0d3f\u0d2e\u0d32\u0d47 \u0d38\u0d32\u0d39\u0d4c \u0d35\u0d47\u0d26\u0d38\u0d3e\u0d30\u0d47 \u0d35\u0d3f\u0d1c\u0d2f\u0d3e\u0d2e\u0d4d\u0d2c\u0d3f\u0d15\u0d47"}, {"M": "\u0d1a\u0d30\u0d23\u0d2e\u0d4d", "T": "\u0d38\u0d30\u0d38\u0d3f\u0d1c\u0d3e\u0d15\u0d4d\u0d37 \u0d1c\u0d17\u0d28\u0d4d\u0d2e\u0d4b\u0d39\u0d3f\u0d28\u0d3f \u0d38\u0d30\u0d38\u0d30\u0d3e\u0d17 \u0d2e\u0d23\u0d3f\u0d2d\u0d42\u0d37\u0d23\u0d3f \u0d39\u0d30\u0d3f\u0d15\u0d47\u0d36 \u0d2a\u0d4d\u0d30\u0d3f\u0d2f \u0d15\u0d3e\u0d2e\u0d3f\u0d28\u0d3f \u0d06\u0d28\u0d28\u0d4d\u0d26\u0d3e\u0d2e\u0d4d\u0d30\u0d4d\u0d24\u0d15\u0d30\u0d4d\u0d37\u0d23\u0d3f"}, {"M": "\u0d1a\u0d3f\u0d1f\u0d4d\u0d1f\u0d38\u0d4d\u0d35\u0d30\u0d2e\u0d4d", "T": "\u0d37\u0d4d\u0d28\u0d4d\u0d2a\u0d4d, \u0d2a\u0d4d\u0d2e\u0d4d\u0d17\u0d4d\u0d38\u0d4d \u0d17\u0d4d,\u0d38\u0d4d, \u0d38\u0d4d\u0d28\u0d4d\u0d2a\u0d4d\u0d28\u0d4d ,\u0d38\u0d4d,\u0d17\u0d4d ,\u0d2e\u0d4d\u0d2a\u0d4d\u0d28\u0d4d | <br/> \u0d37\u0d4d\u0d23\u0d4d\u0d37\u0d4d\u0d19\u0d4d \u0d37\u0d4d\u0d19\u0d4d\u0d02, \u0d19\u0d4d\u0d37\u0d4d\u0d23\u0d4dP \u0d37\u0d4d\u0d37\u0d4d,\u0d2a\u0d4d \u0d2a\u0d4d,\u0d38\u0d4d\u0d17\u0d4d ,\u0d2e\u0d4d\u0d2a\u0d4d\u0d28\u0d4d ||"}]}, {"L": "Sanskrit", "text": [{"M": "\u092a\u0932\u094d\u0932\u0935\u093f", "T": "\u0938\u0941\u0927\u093e\u092e\u092f\u093f \u0938\u0941\u0927\u093e\u0928\u093f\u0927\u093f \u0938\u0941\u092e\u091a\u0930\u0947\u0915\u094d\u0937\u0941 \u0915\u094b\u0926\u0923\u094d\u0921\u0947"}, {"M": "\u0905\u0928\u0941\u092a\u0932\u094d\u0932\u0935\u093f", "T": "\u0935\u093f\u0927\u0940\u0928\u094d\u0926\u094d\u0930\u0928\u0941\u091a\u0947 \u0935\u093f\u092e\u0932\u0947 \u0938\u0932\u0939\u094c \u0935\u0947\u0926\u0938\u093e\u0930\u0947 \u0935\u093f\u091c\u092f\u093e\u092e\u094d\u092c\u093f\u0915\u0947"}, {"M": "\u091a\u0930\u0923\u092e\u094d", "T": "\u0938\u0930\u0938\u093f\u091c\u093e\u0915\u094d\u0937 \u091c\u0917\u0928\u094d\u092e\u094b\u0939\u093f\u0928\u093f \u0938\u0930\u0938\u0930\u093e\u0917 \u092e\u0923\u093f\u092d\u0942\u0937\u0923\u093f \u0939\u0930\u093f\u0915\u0947\u0936 \u092a\u094d\u0930\u093f\u092f \u0915\u093e\u092e\u093f\u0928\u093f \u0906\u0928\u0928\u094d\u0926\u093e\u092e\u094d\u0930\u094d\u0924\u0915\u0930\u094d\u0937\u0923\u093f"}, {"M": "\u091a\u093f\u091f\u094d\u091f\u0938\u094d\u0935\u0930\u092e\u094d", "T": "\u0937\u094d\u0928\u094d\u092a\u094d, \u092a\u094d\u092e\u094d\u0917\u094d\u0938\u094d \u0917\u094d,\u0938\u094d, \u0938\u094d\u0928\u094d\u092a\u094d\u0928\u094d ,\u0938\u094d,\u0917\u094d ,\u092e\u094d\u092a\u094d\u0928\u094d | <br/> \u0937\u094d\u0923\u094d\u0937\u094d\u0919\u094d \u0937\u094d\u0919\u094d\u0902, \u0919\u094d\u0937\u094d\u0923\u094dP \u0937\u094d\u0937\u094d,\u092a\u094d \u092a\u094d,\u0938\u094d\u0917\u094d ,\u092e\u094d\u092a\u094d\u0928\u094d ||"}]}], "L": "l", "lyricsref": [{"links": [{"N": "www.karnatik.com", "L": "http://www.karnatik.com/c1045.shtml"}]}]}