0bcd\u0bb5\u0bb0\u0bae\u0bcd", "T": "\u0bb7\u0bcd\u0ba9\u0bcd\u0baa\u0bcd, \u0baa\u0bcd\u0bae\u0bcd\u0b95\u0bcd\u0bb8\u0bcd \u0b95\u0bcd,\u0bb8\u0bcd, \u0bb8\u0bcd\u0ba9\u0bcd\u0baa\u0bcd\u0ba9\u0bcd ,\u0bb8\u0bcd,\u0b95\u0bcd ,\u0bae\u0bcd\u0baa\u0bcd\u0ba9\u0bcd | <br/> \u0bb7\u0bcd\u0ba3\u0bcd\u0bb7\u0bcd\u0b99\u0bcd \u0bb7\u0bcd\u0b99\u0bcd\u0bae\u0bcd, \u0b99\u0bcd\u0bb7\u0bcd\u0ba3\u0bcdP \u0bb7\u0bcd\u0bb7\u0bcd,\u0baa\u0bcd \u0baa\u0bcd,\u0bb8\u0bcd\u0b95\u0bcd ,\u0bae\u0bcd\u0baa\u0bcd\u0ba9\u0bcd ||"}]}, {"L": "Telugu", "text": [{"M": "\u0c2a\u0c32\u0c4d\u0c32\u0c35\u0c3f", "T": "\u0c38\u0c41\u0c27\u0c3e\u0c2e\u0c2f\u0c3f \u0c38\u0c41\u0c27\u0c3e\u0c28\u0c3f\u0c27\u0c3f \u0c38\u0c41\u0c2e\u0c1a\u0c30\u0c47\u0c15\u0c4d\u0c37\u0c41 \u0c15\u0c4b\u0c26\u0c23\u0c4d\u0c21\u0c47"}, {"M": "\u0c05\u0c28\u0c41\u0c2a\u0c32\u0c4d\u0c32\u0c35\u0c3f", "T": "\u0c35\u0c3f\u0c27\u0c40\u0c28\u0c4d\u0c26\u0c4d\u0c30\u0c28\u0c41\u0c1a\u0c47 \u0c35\u0c3f\u0c2e\u0c32\u0c47 \u0c38\u0c32\u0c39\u0c4c \u0c35\u0c47\u0c26\u0c38\u0c3e\u0c30\u0c47 \u0c35\u0c3f\u0c1c\u0c2f\u0c3e\u0c2e\u0c4d\u0c2c\u0c3f\u0c15\u0c47"}, {"M": "\u0c1a\u0c30\u0c23\u0c2e\u0c4d", "T": "\u0c38\u0c30\u0c38\u0c3f\u0c1c\u0c3e\u0c15\u0c4d\u0c37 \u0c1c\u0c17\u0c28\u0c4d\u0c2e\u0c4b\u0c39\u0c3f\u0c28\u0c3f \u0c38\u0c30\u0c38\u0c30\u0c3e\u0c17 \u0c2e\u0c23\u0c3f\u0c2d\u0c42\u0c37\u0c23\u0c3f \u0c39\u0c30\u0c3f\u0c15\u0c47\u0c36 \u0c2a\u0c4d\u0c30\u0c3f\u0c2f \u0c15\u0c3e\u0c2e\u0c3f\u0c28\u0c3f \u0c06\u0c28\u0c28\u0c4d\u0c26\u0c3e\u0c2e\u0c4d\u0c30\u0c4d\u0c24\u0c15\u0c30\u0c4d\u0c37\u0c23\u0c3f"}, {"M": "\u0c1a\u0c3f\u0c1f\u0c4d\u0c1f\u0c38\u0c4d\u0c35\u0c30\u0c2e\u0c4d", "T": "\u0c37\u0c4d\u0c28\u0c4d\u0c2a\u0c4d, \u0c2a\u0c4d\u0c2e\u0c4d\u0c17\u0c4d\u0c38\u0c4d \u0c17\u0c4d,\u0c38\u0c4d, \u0c38\u0c4d\u0c28\u0c4d\u0c2a\u0c4d\u0c28\u0c4d ,\u0c38\u0c4d,\u0c17\u0c4d ,\u0c2e\u0c4d\u0c2a\u0c4d\u0c28\u0c4d | <br/> \u0c37\u0c4d\u0c23\u0c4d\u0c37\u0c4d\u0c19\u0c4d \u0c37\u0c4d\u0c19\u0c4d\u0c02, \u0c19\u0c4d\u0c37\u0c4d\u0c