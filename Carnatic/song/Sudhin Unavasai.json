, {"L": "Kannada", "text": [{"M": "\u0caa\u0cb2\u0ccd\u0cb2\u0cb5\u0cbf", "T": "\u0c87\u0c9a\u0cc2\u0ca4\u0cbf\u0ca8\u0cc1\u0ca3 \u0cb5\u0cbe\u0c9a\u0cc8\u0ca4\u0ca8\u0cbf \u0cb2\u0cc7\u0c9a\u0cc1\u0cb3\u0cb2\u0cc1 \u0cae\u0cc0\u0ca8\u0ca4\u0cc6\u0ca8 <br/> \u0ca4\u0cc2\u0c9a\u0cc1\u0cb5\u0cb3 \u0c95\u0cbe\u0ca8\u0cb5\u0c9f\u0cbf \u0cb5\u0ca4\u0ca8\u0cbe\u0cb2\u0cc7"}, {"M": "\u0c9a\u0cb0\u0ca3\u0cae\u0ccd 1", "T": "\u0c9a\u0cc2\u0ca4\u0cae\u0cc1\u0c9f \u0ca8\u0cc7\u0cb0\u0cc1\u0cae\u0cc6\u0ca8 \u0cae\u0cbe\u0ca4\u0cb0\u0ccd\u0ca8\u0c9a\u0cc8 \u0ca4\u0cc7\u0c9f\u0cc1\u0caa\u0cca\u0cb0\u0cc1 <br/> \u0cb3\u0cbe\u0c9a\u0cc8\u0ca4\u0cae\u0cbf \u0cb2\u0cc7\u0c9a\u0cc1\u0cb3\u0cb2 \u0cb5\u0cb0\u0cc1\u0c95\u0cbe\u0cb2\u0ca8\u0ccd"}, {"M": "\u0c9a\u0cb0\u0ca3\u0cae\u0ccd 2", "T": "\u0c86\u0ca4\u0cbf\u0cb5\u0cbf\u0ca4\u0cbf \u0caf\u0ccb\u0c9f\u0cc1\u0caa\u0cbf\u0cb1 \u0cb3\u0cbe\u0ca4\u0cb5\u0c95\u0cc8 \u0ca4\u0cc7\u0c9f\u0cbf\u0caf\u0cc6\u0ca8 <br/> \u0ca4\u0cbe\u0cb5\u0cbf\u0ca4\u0ca8\u0cc8 \u0caf\u0cc7\u0c95\u0cc1\u0cb1\u0cc1\u0c95\u0cbf \u0cb5\u0cb0\u0cc1\u0caa\u0ccb\u0ca4\u0cc1"}, {"M": "\u0c9a\u0cb0\u0ca3\u0cae\u0ccd 3", "T": "\u0c86\u0ca4\u0cbf\u0cae\u0cc1\u0cb0\u0cc1 \u0c95\u0cbe\u0ca4\u0cbf\u0cae\u0cc1\u0cb0\u0cc1 \u0c95\u0cbe\u0ca4\u0cbf\u0cae\u0cc1\u0cb0\u0cc1 \u0c95\u0cbe\u0c8e\u0ca8\u0cb5\u0cc1 <br/> \u0cae\u0cbe\u0ca4\u0cbf\u0cae\u0cc1\u0cb0\u0cc1 \u0c95\u0cbe\u0ca8\u0cbf\u0ca8\u0cc8\u0cb5\u0cc1 \u0ca4\u0cb0\u0cc1\u0cb5\u0cbe\u0caf\u0cc7"}, {"M": "\u0c9a\u0cb0\u0ca3\u0cae\u0ccd 4", "T": "\u0c93\u0ca4\u0cae\u0cc1\u0c95\u0cbf \u0cb2\u0cbe\u0c9f\u0cc1\u0c95\u0cbf\u0cb0\u0cbf \u0caf\u0cc7\u0cb1\u0cc1\u0caa\u0c9f \u0cb5\u0cbe\u0cb3\u0c9a\u0cc1\u0cb0\u0cb0\u0ccd <br/> \u0c93\u0cb2\u0cae\u0cbf\u0c9f \u0cb5\u0cc7\u0caf\u0caf\u0cbf\u0cb2\u0ccd\u0c95\u0cca \u0c9f\u0cae\u0cb0\u0cbe\u0c9f\u0cc0"}, {"M": "\u0c9a\u0cb0\u0ca3\u0cae\u0ccd 5", "T": "\u0c93\u0ca8\u0cae\u0c9a\u0cbf \u0cb5\u0cbe\u0caf\u0c95\u0cc1\u0cb0\u0cc1 \u0caa\u0cbe\u0ca4\u0cae\u0ca4\u0cbf \u0cb2\u0cc7\u0caa\u0ca3\u0cbf\u0caf\u0cc1\u0cae\u0ccd <br/> \u0caf\u0ccb\u0c95\u0cae\u0caf\u0cbf \u0cb2\u0cbe\u0c85\u0cae\u0cb2\u0cc8 \u0cae\u0c95\u0cbf\u0cb3\u0ccd\u0caa\u0cbe\u0cb2\u0cbe"}, {"M": "\u0c9a\u0cb0\u0ca3\u0cae\u0ccd 6", "T": "\u0ca8\u0cbe\u0ca4\u0cb0\u0c95\u0cc1 \u0cb0\u0cbe\u0cae\u0cbe\u0cb0\u0cbf \u0cae\u0cbe\u0caf\u0ca8\u0ccd\u0cae\u0cb0\u0cc1 \u0c95\u0cbe\u0caa\u0cc1\u0cb5\u0ca8 <br/> \u0ca8\u0cbe\u0c9f\u0cc1\u0cae\u0c9f\u0cbf \u0caf\u0cbe\u0cb0\u0ccd\u0c95\u0cb3\u0ccd\u0cae\u0ca8 \u0ca4\u0cc1\u0cb1\u0cc8\u0cb5\u0ccb\u0ca8\u0cc7"}, {"M": "\u0c9a\u0cb0\u0ca3\u0cae\u0ccd 7", "T": "\u0c9e\u0cbe\u0ca8\u0c9a\u0cc1\u0cb0 \u0cb5\u0cbe\u0ca8\u0cc8\u0c95\u0ca3 \u0cb5\u0cbe\u0cae\u0cc1\u0cb0\u0cc1\u0c95 \u0ca8\u0cc7\u0caf\u0cae\u0cb0\u0cb0\u0ccd <br/> \u0ca8\u0cbe\u0c9f\u0cc1\u0caa\u0cc6\u0cb1 \u0cb5\u0cbe\u0cb3\u0cb5\u0cb0\u0cc1\u0cb3\u0ccd \u0caa\u0cc6\u0cb0\u0cc1\u0cae\u0cbe\u0cb3\u0cc7."}]}, {"L": "Malayalam", "text": [{"M": "\u0d2a\u0d32\u0d4d\u0d32\u0d35\u0d3f", "T": "\u0d07\u0d1a\u0d42\u0d24\u0d3f\u0d28\u0d41\u0d23 \u0d35\u0d3e\u0d1a\u0d48\u0d24\u0d28\u0d3f \u0d32\u0d47\u0d1a\u0d41\u0d34\u0d32\u0d41 \u0d2e\u0d40\u0d28\u0d24\u0d46\u0d28 <br/> \u0d24\u0d42\u0d1a\u0d41\u0d35\u0d34 \u0d15\u0d3e\u0d28\u0d35\u0d1f\u0d3f \u0d35\u0d24\u0d28\u0d3e\u0d32\u0d47"}, {"M": "\u0d1a\u0d30\u0d23\u0d2e\u0d4d 1", "T": "\u0d1a\u0d42\u0d24\u0d2e\u0d41\u0d1f \u0d28\u0d47\u0d30\u0d41\u0d2e\u0d46\u0d28 \u0d2e\u0d3e\u0d24\u0d30\u0d4d\u0d28\u0d1a\u0d48 \u0d24\u0d47\u0d1f\u0d41\u0d2a\u0d4a\u0d30\u0d41 <br/> \u0d33\u0d3e\u0d1a\u0d48\u0d24\u0d2e\u0d3f \u0d32\u0d47\u0d1a\u0d41\u0d34\u0d32 \u0d35\u0d30\u0d41\u0d15\u0d3e\u0d32\u0d28\u0d4d"}, {"M": "\u0d1a\u0d30\u0d23\u0d2e\u0d4d 2", "T": "\u0d06\u0d24\u0d3f\u0d35\u0d3f\u0d24\u0d3f \u0d2f\u0d4b\u0d1f\u0d41\u0d2a\u0d3f\u0d31 \u0d34\u0d3e\u0d24\u0d35\u0d15\u0d48 \u0d24\u0d47\u0d1f\u0d3f\u0d2f\u0d46\u0d28 <br/> \u0d24\u0d3e\u0d35\u0d3f\u0d24\u0d28\u0d48 \u0d2f\u0d47\u0d15\u0d41\u0d31\u0d41\u0d15\u0d3f \u0d35\u0d30\u0d41\u0d2a\u0d4b\u0d24\u0d41"}, {"M": "\u0d1a\u0d30\u0d23\u0d2e\u0d4d 3", "T": "\u0d06\u0d24\u0d3f\u0d2e\u0d41\u0d30\u0d41 \u0d15\u0d3e\u0d24\u0d3f\u0d2e\u0d41\u0d30\u0d41 \u0d15\u0d3e\u0d24\u0d3f\u0d2e\u0d41\u0d30\u0d41 \u0d15\u0d3e\u0d0e\u0d28\u0d35\u0d41 <br/> \u0d2e\u0d3e\u0d24\u0d3f\u0d2e\u0d41\u0d30\u0d41 \u0d15\u0d3e\u0d28\u0d3f\u0d28\u0d48\u0d35\u0d41 \u0d24\u0d30\u0d41\u0d35\u0d3e\u0d2f\u0d47"}, {"M": "\u0d1a\u0d30\u0d23\u0d2e\u0d4d 4", "T": "\u0d13\u0d24\u0d2e\u0d41\u0d15\u0d3f \u0d32\u0d3e\u0d1f\u0d41\u0d15\u0d3f\u0d30\u0d3f \u0d2f\u0d47\u0d31\u0d41\u0d2a\u0d1f \u0d35\u0d3e\u0d34\u0d1a\u0d41\u0d30\u0d30\u0d4d <br/> \u0d13\u0d32\u0d2e\u0d3f\u0d1f \u0d35\u0d47\u0d2f\u0d2f\u0d3f\u0d32\u0d4d\u0d15\u0d4a \u0d1f\u0d2e\u0d30\u0d3e\u0d1f\u0d40"}, {"M": "\u0d1a\u0d30\u0d23\u0d2e\u0d4d 5", "T": "\u0d13\u0d28\u0d2e\u0d1a\u0d3f \u0d35\u0d3e\u0d2f\u0d15\u0d41\u0d30\u0d41 \u0d2a\u0d3e\u0d24\u0d2e\u0d24\u0d3f \u0d32\u0d47\u0d2a\u0d23\u0d3f\u0d2f\u0d41\u0d2e\u0d4d <br/> \u0d2f\u0d4b\u0d15\u0d2e\u0d2f\u0d3f \u0d32\u0d3e\u0d05\u0d2e\u0d32\u0d48 \u0d2e\u0d15\u0d3f\u0d34\u0d4d\u0d2a\u0d3e\u0d32\u0d3e"}, {"M": "\u0d1a\u0d30\u0d23\u0d2e\u0d4d 6", "T": "\u0d28\u0d3e\u0d24\u0d30\u0d15\u0d41 \u0d30\u0d3e\u0d2e\u0d3e\u0d30\u0d3f \u0d2e\u0d3e\u0d2f\u0d28\u0d4d\u0d2e\u0d30\u0d41 \u0d15\u0d3e\u0d2a\u0d41\u0d35\u0d28 <br/> \u0d28\u0d3e\u0d1f\u0d41\u0d2e\u0d1f\u0d3f \u0d2f\u0d3e\u0d30\u0d4d\u0d15\u0d33\u0d4d\u0d2e\u0d28 \u0d24\u0d41\u0d31\u0d48\u0d35\u0d4b\u0d28\u0d47"}, {"M": "\u0d1a\u0d30\u0d23\u0d2e\u0d4d 7", "T": "\u0d1e\u0d3e\u0d28\u0d1a\u0d41\u0d30 \u0d35\u0d3e\u0d28\u0d48\u0d15\u0d23 \u0d35\u0d3e\u0d2e\u0d41\u0d30\u0d41\u0d15 \u0d28\u0d47\u0d2f\u0d2e\u0d30\u0d30\u0d4d <br/> \u0d28\u0d3e\u0d1f\u0d41\u0d2a\u0d46\u0d31 \u0d35\u0d3e\u0d34\u0d35\u0d30\u0d41\u0d33\u0d4d \u0d2a\u0d46\u0d30\u0d41\u0d2e\u0d3e\u0d33\u0d47."}]}, {"L": "Sanskrit", "text": [{"M": "\u092a\u0932\u094d\u0932\u0935\u093f", "T": "\u0907\u091a\u0942\u0924\u093f\u0928\u0941\u0923 \u0935\u093e\u091a\u0948\u0924\u0928\u093f \u0932\u0947\u091a\u0941\u0932\u0932\u0941 \u092e\u0940\u0928\u0924\u0947\u0928 <br/> \u0924\u0942\u091a\u0941\u0935\u0932 \u0915\u093e\u0928\u0935\u091f\u093f \u0935\u0924\u0928\u093e\u0932\u0947"}, {"M": "\u091a\u0930\u0923\u092e\u094d 1", "T": "\u091a\u0942\u0924\u092e\u0941\u091f \u0928\u0947\u0930\u0941\u092e\u0947\u0928 \u092e\u093e\u0924\u0930\u094d\u0928\u091a\u0948 \u0924\u0947\u091f\u0941\u092a\u094b\u0930\u0941 <br/> \u0932\u093e\u091a\u0948\u0924\u092e\u093f \u0932\u0947\u091a\u0941\u0932\u0932 \u0935\u0930\u0941\u0915\u093e\u0932\u0928\u094d"}, {"M": "\u091a\u0930\u0923\u092e\u094d 2", "T": "\u0906\u0924\u093f\u0935\u093f\u0924\u093f \u092f\u094b\u091f\u0941\u092a\u093f\u0930 \u0932\u093e\u0924\u0935\u0915\u0948 \u0924\u0947\u091f\u093f\u092f\u0947\u0928 <br/> \u0924\u093e\u0935\u093f\u0924\u0928\u0948 \u092f\u0947\u0915\u0941\u0930\u0941\u0915\u093f \u0935\u0930\u0941\u092a\u094b\u0924\u0941"}, {"M": "\u091a\u0930\u0923\u092e\u094d 3", "T": "\u0906\u0924\u093f\u092e\u0941\u0930\u0941 \u0915\u093e\u0924\u093f\u092e\u0941\u0930\u0941 \u0915\u093e\u0924\u093f\u092e\u0941\u0930\u0941 \u0915\u093e\u090f\u0928\u0935\u0941 <br/> \u092e\u093e\u0924\u093f\u092e\u0941\u0930\u0941 \u0915\u093e\u0928\u093f\u0928\u0948\u0935\u0941 \u0924\u0930\u0941\u0935\u093e\u092f\u0947"}, {"M": "\u091a\u0930\u0923\u092e\u094d 4", "T": "\u0913\u0924\u092e\u0941\u0915\u093f \u0932\u093e\u091f\u0941\u0915\u093f\u0930\u093f \u092f\u0947\u0930\u0941\u092a\u091f \u0935\u093e\u0932\u091a\u0941\u0930\u0930\u094d <br/> \u0913\u0932\u092e\u093f\u091f \u0935\u0947\u092f\u092f\u093f\u0932\u094d\u0915\u094b \u091f\u092e\u0930\u093e\u091f\u0940"}, {"M": "\u091a\u0930\u0923\u092e\u094d 5", "T": "\u0913\u0928\u092e\u091a\u093f \u0935\u093e\u092f\u0915\u0941\u0930\u0941 \u092a\u093e\u0924\u092e\u0924\u093f \u0932\u0947\u092a\u0923\u093f\u092f\u0941\u092e\u094d <br/> \u092f\u094b\u0915\u092e\u092f\u093f \u0932\u093e\u0905\u092e\u0932\u0948 \u092e\u0915\u093f\u0932\u094d\u092a\u093e\u0932\u093e"}, {"M": "\u091a\u0930\u0923\u09