ae\u0bbe\u0bb3\u0bc7."}]}, {"L": "Telugu", "text": [{"M": "\u0c2a\u0c32\u0c4d\u0c32\u0c35\u0c3f", "T": "\u0c24\u0c3f\u0c30\u0c41\u0c2a\u0c4d\u0c2a\u0c41\u0c15\u0c34\u0c4d \u0c2a\u0c1f\u0c3f\u0c15\u0c4d\u0c15\u0c41\u0c2e\u0c4d \u0c05\u0c35\u0c30\u0c4d \u0c1a\u0c3f\u0c02\u0c24\u0c48 \u0c35\u0c32\u0c41\u0c35\u0c3e\u0c32\u0c47 <br/> \u0c12\u0c30\u0c41\u0c24\u0c4d\u0c24\u0c30\u0c48 \u0c2e\u0c24\u0c3f\u0c2a\u0c4d\u0c2a\u0c24\u0c41 \u0c07\u0c32\u0c48, \u0c09\u0c28\u0c4d\u0c24\u0c28\u0c4d \u0c05\u0c30\u0c41\u0c33\u0c3e\u0c32\u0c47, <br/> \u0c2a\u0c4a\u0c30\u0c41\u0c2a\u0c4d\u0c2a\u0c41 \u0c09\u0c15 \u0c2e\u0c3f\u0c15\u0c2a\u0c4d\u0c2a\u0c4a\u0c30\u0c41\u0c24\u0c41 \u0c35\u0c46\u0c28\u0c4d\u0c31\u0c41, \u0c2e\u0c2f\u0c3f\u0c32\u0c4d \u0c2e\u0c40\u0c24\u0c47 <br/> \u0c24\u0c30\u0c3f\u0c24\u0c4d\u0c24\u0c41 \u0c12\u0c30\u0c41 \u0c24\u0c3f\u0c30\u0c41\u0c24\u0c4d\u0c24\u0c23\u0c3f\u0c2f\u0c3f\u0c32\u0c4d \u0c28\u0c3f\u0c28\u0c4d\u0c31 \u0c2a\u0c46\u0c30\u0c41\u0c2e\u0c3e\u0c33\u0c47."}]}, {"L": "Kannada", "text": [{"M": "\u0caa\u0cb2\u0ccd\u0cb2\u0cb5\u0cbf", "T": "\u0ca4\u0cbf\u0cb0\u0cc1\u0caa\u0ccd\u0caa\u0cc1\u0c95\u0cb3\u0ccd \u0caa\u0c9f\u0cbf\u0c95\u0ccd\u0c95\u0cc1\u0cae\u0ccd \u0c85\u0cb5\u0cb0\u0ccd \u0c9a\u0cbf\u0c82\u0ca4\u0cc8 \u0cb5\u0cb2\u0cc1\u0cb5\u0cbe\u0cb2\u0cc7 <br/> \u0c92\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0cb0\u0cc8 \u0cae\u0ca4\u0cbf\u0caa\u0ccd\u0caa\u0ca4\u0cc1 \u0c87\u0cb2\u0cc8, \u0c89\u0ca8\u0ccd\u0ca4\u0ca8\u0ccd \u0c85\u0cb0\u0cc1\u0cb3\u0cbe\u0cb2\u0cc7, <br/> \u0caa\u0cca\u0cb0\u0cc1\u0caa\u0ccd\u0caa\u0cc1 \u0c89\u0c95 \u0cae\u0cbf\u0c95\u0caa\u0ccd\u0caa\u0cca\u0cb0\u0cc1\u0ca4\u0cc1 \u0cb5\u0cc6\u0ca8\u0ccd\u0cb1\u0cc1, \u0cae\u0caf\u0cbf\u0cb2\u0ccd \u0cae\u0cc0\u0ca4\u0cc7 <br/> \u0ca4\u0cb0\u0cbf\u0ca4\u0ccd\u0ca4\u0cc1 \u0c92\u0cb0\u0cc1 \u0ca4\u0cbf\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0ca3\u0cbf\u0caf\u0cbf\u0cb2\u0ccd \u0ca8\u0cbf\u0ca8\u0ccd\u0cb1 \u0caa\u0cc6\u0cb0\u0cc1\u0cae\u0cbe\u0cb3\u0cc7."}]}, {"L": "Malayalam", "text": [{"M": "\u0d2a\u0d32\u0d4d\u0d32\u0d35\u0d3f", "T": "\u0d24\u0d3f\u0d30\u0d41\u0d2a\u0d4d\u0d2a\u0d41\u0d15\u0d34\u0d4d \u0d2a\u0d1f\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d2e\u0d4d \u0d05\u0d35\u0d30\u0d4d \u0d1a\u0d3f\u0d02\u0d24\u0d48 \u0d35\u0d32\u0d41\u0d35\u0d3e\u0d32\u0d47 <br/> \u0d12\u0d30\u0d41\u0d24\u0d4d\u0d24\u0d30\u0d48 \u0d2e\u0d24\u0d3f\u0d2a\u0d4d\u0d2a\u0d24\u0d41 \u0d07\u0d32\u0d48, \u0d09\u0d29\u0d4d\u0d24\u0d29\u0d4d \u0d05\u0d30\u0d41\u0d33\u0d3e\u0d32\u0d47, <br/> \u0d2a\u0d4a\u0d30\u0d41\u0d2a\u0d4d\u0d2a\u0d41 \u0d09\u0d15 \u0d2e\u0d3f\u0d15\u0d2a\u0d4d\u0d2a\u0d4a\u0d30\u0d41\u0d24\u0d41 \u0d35\u0d46\u0d29\u0d4d\u0d31\u0d41, \u0d2e\u0d2f\u0d3f\u0d32\u0d4d \u0d2e\u0d40\u0d24\u0d47 <br/> \u0d24\u0d30\u0d3f\u0d24\u0d4d\u0d24\u0d41 \u0d12\u0d30\u0d41 \u0d24\u0d3f\u0d30\u0d41\u0d24\u0d4d\u0d24\u0d23\u0d3f\u0d2f\u0d3f\u0d32\u0d4d \u0d28\u0d3f\u0d29\u0d4d\u0d31 \u0d2a\u0d46\u0d30\u0d41\u0d2e\u0d3e\u0d33\u0d47."}]}, {"L": "Sanskrit", "text": [{"M": "\u092a\u0932\u094d\u0932\u0935\u093f", "T": "\u0924\u093f\u0930\u0941\u092a\u094d\u092a\u0941\u0915\u0932\u094d \u092a\u091f\u093f\u0915\u094d\u0915\u0941\u092e\u094d \u0905\u0935\u0930\u094d \u091a\u093f\u0902\u0924\u0948 \u0935\u0932\u0941\u0935\u093e\u0932\u0947 <br/> \u0913\u0930\u0941\u0924\u094d\u0924\u0930\u0948 \u092e\u0924\u093f\u092a\u094d\u092a\u0924\u0941 \u0907\u0932\u0948, \u0909\u0928\u094d\u0924\u0928\u094d \u0905\u0930\u0941\u0932\u093e\u0932\u0947, <br/> \u092a\u094b\u0930\u0941\u092a\u094d\u092a\u0941 \u0909\u0915 \u092e\u093f\u0915\u092a\u094d\u092a\u094b\u0930\u0941\u0924\u0941 \u0935\u0947\u0928\u094d\u0930\u0941, \u092e\u092f\u093f\u0932\u094d \u092e\u0940\u0924\u0947 <br/> \u0924\u0930\u093f\u0924\u094d\u0924\u0941 \u0913\u0930\u0941 \u0924\u093f\u0930\u0941\u0924\u094d\u0924\u0923\u093f\u092f\u093f\u0932\u094d \u0928\u093f\u0928\u094d\u0930 \u092a\u0947\u0930\u0941\u092e\u093e\u0932\u0947."}]}], "L": "l", "lyricsref": [{"links": [{"N": "kuganarul.blogspot.com", "L": "http://kuganarul.blogspot.com/2018/05/blog-post_27.html"}]}]}