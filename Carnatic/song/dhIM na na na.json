: "Telugu", "text": [{"M": "\u0c2a\u0c32\u0c4d\u0c32\u0c35\u0c3f", "T": "\u0c27\u0c40\u0c2e\u0c4d \u0c28 \u0c28 \u0c28 \u0c24\u0c3f\u0c32\u0c4d\u0c32\u0c3f\u0c32\u0c4d\u0c32\u0c28 \u0c24\u0c3f\u0c32\u0c4d\u0c32\u0c3e\u0c28 \u0c28\u0c3e\u0c26\u0c3f\u0c30\u0c3f \u0c27\u0c40\u0c2e\u0c4d \u0c27\u0c40\u0c2e\u0c4d \u0c28\u0c3e\u0c26\u0c3f\u0c30\u0c3f \u0c27\u0c40\u0c2e\u0c4d \u0c28\u0c3e\u0c26\u0c3f\u0c30\u0c3f \u0c27\u0c40\u0c2e\u0c4d \u0c28\u0c3e\u0c26\u0c3f\u0c30\u0c3f <br/> \u0c27\u0c40\u0c2e\u0c4d \u0c28 \u0c28 \u0c28 \u0c24\u0c3f\u0c32\u0c4d\u0c32\u0c3f\u0c32\u0c4d\u0c32\u0c28 \u0c24\u0c3f\u0c32\u0c4d\u0c32\u0c3e\u0c28 \u0c28\u0c3e\u0c26\u0c3f\u0c30\u0c3f \u0c27\u0c40\u0c2e\u0c4d \u0c27\u0c40\u0c2e\u0c4d \u0c28\u0c3e\u0c26\u0c3f\u0c30\u0c3f \u0c27\u0c40\u0c2e\u0c4d \u0c28\u0c3e\u0c26\u0c4d\u0c30\u0c41 \u0c27\u0c40\u0c2e\u0c4d \u0c28\u0c3e\u0c26\u0c3f\u0c30\u0c3f"}, {"M": "\u0c05\u0c28\u0c41\u0c2a\u0c32\u0c4d\u0c32\u0c35\u0c3f", "T": "\u0c27\u0c40\u0c2e\u0c4d \u0c28\u0c28\u0c3e \u0c27\u0c40\u0c2e\u0c4d \u0c28\u0c28\u0c3e \u0c24\u0c26\u0c3f\u0c02\u0c17\u0c3f\u0c23\u0c24\u0c4b\u0c2e\u0c4d \u0c24\u0c15\u0c3f\u0c1f \u0c1d\u0c2e\u0c4d \u0c24\u0c1d\u0c2e\u0c4d \u0c24\u0c1d\u0c28\u0c4d\u0c24 \u0c24\u0c1d\u0c28\u0c4d\u0c24\u0c30\u0c3f\u0c1d\u0c2e\u0c4d \u0c24\u0c30\u0c3f\u0c24 \u0c1d\u0c2e\u0c4d \u0c24\u0c30\u0c3f\u0c24 \u0c28\u0c3e\u0c26\u0c3f\u0c30\u0c3f"}, {"M": "\u0c1a\u0c30\u0c23\u0c2e\u0c4d", "T": "\u0c38\u0c4a\u0c17\u0c38\u0c41\u0c32\u0c42\u0c30 \u0c39\u0c4b\u0c2f\u0c32\u0c41 \u0c2e\u0c40\u0c30\u0c3f \u0c28\u0c40\u0c26\u0c30\u0c3f \u0c1c\u0c47\u0c30\u0c3f\u0c24\u0c3f\u0c28\u0c3f \u0c28\u0c40\u0c30 \u0c15\u0c4d\u0c37\u0c40\u0c30 \u0c28\u0c4d\u0c2f\u0c3e\u0c2f\u0c2e\u0c48 \u0c2e\u0c48\u0c2e\u0c30\u0c1a\u0c3f \u0c38\u0c15\u0c32 \u0c1a\u0c30\u0c3e\u0c1a\u0c30\u0c2e\u0c46\u0c32\u0c4d\u0c32 \u0c2a\u0c41\u0c32\u0c15\u0c3f\u0c02\u0c1a\u0c46 <br/> \u0c24\u0c40\u0c2f\u0c28\u0c3f \u0c39\u0c4d\u0c2f\u0c28\u0c3f \u0c2a\u0c3f\u0c02\u0c1a\u0c41 \u0c1a\u0c3f\u0c30\u0c41 \u0c30\u0c35\u0c33\u0c3f \u0c28\u0c40 \u0c2e\u0c41\u0c30\u0c33\u0c40 \u0c2e\u0c3e\u0c27\u0c41\u0c30\u0c40 \u0c28\u0c3e\u0c27\u0c3f\u0c30\u0c3f"}]}, {"L": "Kannada", "text": [{"M": "\u0caa\u0cb2\u0ccd\u0cb2\u0cb5\u0cbf", "T": "\u0ca7\u0cc0\u0cae\u0ccd \u0ca8 \u0ca8 \u0ca8 \u0ca4\u0cbf\u0cb2\u0ccd\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2\u0ca8 \u0ca4\u0cbf\u0cb2\u0ccd\u0cb2\u0cbe\u0ca8 \u0ca8\u0cbe\u0ca6\u0cbf\u0cb0\u0cbf \u0ca7\u0cc0\u0cae\u0ccd \u0ca7\u0cc0\u0cae\u0ccd \u0ca8\u0cbe\u0ca6\u0cbf\u0cb0\u0cbf \u0ca7\u0cc0\u0cae\u0ccd \u0ca8\u0cbe\u0ca6\u0cbf\u0cb0\u0cbf \u0ca7\u0cc0\u0cae\u0ccd \u0ca8\u0cbe\u0ca6\u0cbf\u0cb0\u0cbf <br/> \u0ca7\u0cc0\u0cae\u0ccd \u0ca8 \u0ca8 \u0ca8 \u0ca4\u0cbf\u0cb2\u0ccd\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2\u0ca8 \u0ca4\u0cbf\u0cb2\u0ccd\u0cb2\u0cbe\u0ca8 \u0ca8\u0cbe\u0ca6\u0cbf\u0cb0\u0cbf \u0ca7\u0cc0\u0cae\u0ccd \u0ca7\u0cc0\u0cae\u0ccd \u0ca8\u0cbe\u0ca6\u0cbf\u0cb0\u0cbf \u0ca7\u0cc0\u0cae\u0ccd \u0ca8\u0cbe\u0ca6\u0ccd\u0cb0\u0cc1 \u0ca7\u0cc0\u0cae\u0ccd \u0ca8\u0cbe\u0ca6\u0cbf\u0cb0\u0cbf"}, {"M": "\u0c85\u0ca8\u0cc1\u0caa\u0cb2\u0ccd\u0cb2\u0cb5\u0cbf", "T": "\u0ca7\u0cc0\u0cae\u0ccd \u0ca8\u0ca8\u0cbe \u0ca7\u0cc0\u0cae\u0ccd \u0ca8\u0ca8\u0cbe \u0ca4\u0ca6\u0cbf\u0c82\u0c97\u0cbf\u0ca3\u0ca4\u0ccb\u0cae\u0ccd \u0ca4\u0c95\u0cbf\u0c9f \u0c9d\u0cae\u0ccd \u0ca4\u0c9d\u0cae\u0ccd \u0ca4\u0c9d\u0ca8\u0ccd\u0ca4 \u0ca4\u0c9d\u0ca8\u0ccd\u0ca4\u0cb0\u0cbf\u0c9d\u0cae\u0ccd \u0ca4\u0cb0\u0cbf\u0ca4 \u0c9d\u0cae\u0ccd \u0ca4\u0cb0\u0cbf\u0ca4 \u0ca8\u0cbe\u0ca6\u0cbf\u0cb0\u0cbf"}, {"M": "\u0c9a\u0cb0\u0ca3\u0cae\u0ccd", "T": "\u0cb8\u0cca\u0c97\u0cb8\u0cc1\u0cb2\u0cc2\u0cb0 \u0cb9\u0ccb\u0caf\u0cb2\u0cc1 \u0cae\u0cc0\u0cb0\u0cbf \u0ca8\u0cc0\u0ca6\u0cb0\u0cbf \u0c9c\u0cc7\u0cb0\u0cbf\u0ca4\u0cbf\u0ca8\u0cbf \u0ca8\u0cc0\u0cb0 \u0c95\u0ccd\u0cb7\u0cc0\u0cb0 \u0ca8\u0ccd\u0caf\u0cbe\u0caf\u0cae\u0cc8 \u0cae\u0cc8\u0cae\u0cb0\u0c9a\u0cbf \u0cb8\u0c95\u0cb2 \u0c9a\u0cb0\u0cbe\u0c9a\u0cb0\u0cae\u0cc6\u0cb2\u0ccd\u0cb2 \u0caa\u0cc1\u0cb2\u0c95\u0cbf\u0c82\u0c9a\u0cc6 <br/> \u0ca4\u0cc0\u0caf\u0ca8\u0cbf \u0cb9\u0ccd\u0caf\u0ca8\u0cbf \u0caa\u0cbf\u0c82\u0c9a\u0cc1 \u0c9a\u0cbf\u0cb0\u0cc1 \u0cb0\u0cb5\u0cb3\u0cbf \u0ca8\u0cc0 \u0cae\u0cc1\u0cb0\u0cb3\u0cc0 \u0cae\u0cbe\u0ca7\u0cc1\u0cb0\u0cc0 \u0ca8\u0cbe\u0ca7\u0cbf\u0cb0\u0cbf"}]}, {"L": "Malayalam", "text": [{"M": "\u0d2a\u0d32\u0d4d\u0d32\u0d35\u0d3f", "T": "\u0d27\u0d40\u0d2e\u0d4d \u0d28 \u0d28 \u0d28 \u0d24\u0d3f\u0d32\u0d4d\u0d32\u0d3f\u0d32\u0d4d\u0d32\u0d28 \u0d24\u0d3f\u0d32\u0d4d\u0d32\u0d3e\u0d28 \u0d28\u0d3e\u0d26\u0d3f\u0d30\u0d3f \u0d27\u0d40\u0d2e\u0d4d \u0d27\u0d40\u0d2e\u0d4d \u0d28\u0d3e\u0d26\u0d3f\u0d30\u0d3f \u0d27\u0d40\u0d2e\u0d4d \u0d28\u0d3e\u0d26\u0d3f\u0d30\u0d3f \u0d27\u0d40\u0d2e\u0d4d \u0d28\u0d3e\u0d26\u0d3f\u0d30\u0d3f <br/> \u0d27\u0d40\u0d2e\u0d4d \u0d28 \u0d28 \u0d28 \u0d24\u0d3f\u0d32\u0d4d\u0d32\u0d3f\u0d32\u0d4d\u0d32\u0d28 \u0d24\u0d3f\u0d32\u0d4d\u0d32\u0d3e\u0d28 \u0d28\u0d3e\u0d26\u0d3f\u0d30\u0d3f \u0d27\u0d40\u0d2e\u0d4d \u0d27\u0d40\u0d2e\u0d4d \u0d28\u0d3e\u0d26\u0d3f\u0d30\u0d3f \u0d27\u0d40\u0d2e\u0d4d \u0d28\u0d3e\u0d26\u0d4d\u0d30\u0d41 \u0d27\u0d40\u0d2e\u0d4d \u0d28\u0d3e\u0d26\u0d3f\u0d30\u0d3f"}, {"M": "\u0d05\u0d28\u0d41\u0d2a\u0d32\u0d4d\u0d32\u0d35\u0d3f", "T": "\u0d27\u0d40\u0d2e\u0d4d \u0d28\u0d28\u0d3e \u0d27\u0d40\u0d2e\u0d4d \u0d28\u0d28\u0d3e \u0d24\u0d26\u0d3f\u0d02\u0d17\u0d3f\u0d23\u0d24\u0d4b\u0d2e\u0d4d \u0d24\u0d15\u0d3f\u0d1f \u0d1d\u0d2e\u0d4d \u0d24\u0d1d\u0d2e\u0d4d \u0d24\u0d1d\u0d28\u0d4d\u0d24 \u0d24\u0d1d\u0d28\u0d4d\u0d24\u0d30\u0d3f\u0d1d\u0d2e\u0d4d \u0d24\u0d30\u0d3f\u0d24 \u0d1d\u0d2e\u0d4d \u0d24\u0d30\u0d3f\u0d24 \u0d28\u0d3e\u0d26\u0d3f\u0d30\u0d3f"}, {"M": "\u0d1a\u0d30\u0d23\u0d2e\u0d4d", "T": "\u0d38\u0d4a\u0d17\u0d38\u0d41\u0d32\u0d42\u0d30 \u0d39\u0d4b\u0d2f\u0d32\u0d41 \u0d2e\u0d40\u0d30\u0d3f \u0d28\u0d40\u0d26\u0d30\u0d3f \u0d1c\u0d47\u0d30\u0d3f\u0d24\u0d3f\u0d28\u0d3f \u0d28\u0d40\u0d30 \u0d15\u0d4d\u0d37\u0d40\u0d30 \u0d28\u0d4d\u0d2f\u0d3e\u0d2f\u0d2e\u0d48 \u0d2e\u0d48\u0d2e\u0d30\u0d1a\u0d3f \u0d38\u0d15\u0d32 \u0d1a\u0d30\u0d3e\u0d1a\u0d30\u0d2e\u0d46\u0d32\u0d4d\u0d32 \u0d2a\u0d41\u0d32\u0d15\u0d3f\u0d02\u0d1a\u0d46 <br/> \u0d24\u0d40\u0d2f\u0d28\u0d3f \u0d39\u0d4d\u0d2f\u0d28\u0d3f \u0d2a\u0d3f\u0d02\u0d1a\u0d41 \u0d1a\u0d3f\u0d30\u0d41 \u0d30\u0d35\u0d33\u0d3f \u0d28\u0d40 \u0d2e\u0d41\u0d30\u0d33\u0d40 \u0d2e\u0d3e\u0d27\u0d41\u0d30\u0d40 \u0d28\u0d3e\u0d27\u0d3f\u0d30\u0d3f"}]}, {"L": "Sanskrit", "text": [{"M": "\u092a\u0932\u094d\u0932\u0935\u093f", "T": "\u0927\u0940\u092e\u094d \u0928 \u0928 \u0928 \u0924\u093f\u0932\u094d\u0932\u093f\u0932\u094d\u0932\u0928 \u0924\u093f\u0932\u094d\u0932\u093e\u0928 \u0928\u093e\u0926\u093f\u0930\u093f \u0927\u0940\u092e\u094d \u0927\u0940\u092e\u094d \u0928\u093e\u0926\u093f\u0930\u093f \u0927\u0940\u092e\u094d \u0928\u093e\u0926\u093f\u0930\u093f \u0927\u0940\u092e\u094d \u0928\u093e\u0926\u093f\u0930\u093f <br/> \u0927\u0940\u092e\u094d \u0928 \u0928 \u0928 \u0924\u093f\u0932\u094d\u0932\u093f\u0932\u094d\u0932\u0928 \u0924\u093f\u0932\u094d\u0932\u093e\u0928 \u0928\u093e\u0926\u093f\u0930\u093f \u0927\u0940\u092e\u094d \u0927\u0940\u092e\u094d \u0928\u093e\u0926\u093f\u0930\u093f \u0927\u0940\u092e\u094d \u0928\u093e\u0926\u094d\u0930\u0941 \u0927\u0940\u092e\u094d \u0928\u093e\u0926\u093f\u0930\u093f"}, {"M": "\u0905\u0928\u0941\u092a\u0932\u094d\u0932\u0935\u093f", "T": "\u0927\u0940\u092e\u094d \u0928\u0928\u093e \u0927\u0940\u092e\u094d \u0928\u0928\u093e \u0924\u0926\u093f\u0902\u0917\u093f\u0923\u0924\u094b\u092e\u094d \u0924\u0915\u093f\u091f \u091d\u092e\u094d \u0924\u091d\u092e\u094d \u0924\u091d\u0928\u094d\u0924 \u0924\u091d\u0928\u094d\u0924\u0930\u093f\u091d\u092e\u094d \u0924\u0930\u093f\u0924 \u091d\u092e\u094d \u0924\u0930\u093f\u0924 \u0928\u093e\u0926\u093f\u0930\u093f"}, {"M": "\u091a\u0930\u0923\u092e\u094d", "T": "\u0938\u094b\u0917\u0938\u0941\u0932\u0942\u0930 \u0939\u094b\u092f\u0932\u0941 \u092e\u0940\u0930\u093f \u0928\u0940\u0926\u0930\u093f \u091c\u0947\u0930\u093f\u0924\u093f\u0928\u093f \u0928\u0940\u0930 \u0915\u094d\u0937\u0940\u0930 \u0928\u094d\u092f\u093e\u092f\u092e\u0948 \u092e\u0948\u092e\u0930\u091a\u093f \u0938\u0915\u0932 \u091a\u0930\u093e\u091a\u0930\u092e\u0947\u0932\u094d\u0932 \u092a\u0941\u0932\u0915\u093f\u0902\u091a\u0947 <br/> \u0924\u0940\u092f\u0928\u093f \u0939\u094d\u092f\u0928\u093f \u092a\u093f\u0902\u091a\u0941 \u091a\u093f\u0930\u0941 \u0930\u0935\u0932\u093f \u0928\u0940 \u092e\u0941\u0930\u0932\u0940 \u092e\u093e\u0927\u0941\u0930\u0940 \u0928\u093e\u0927\u093f\u0930\u093f"}]}], "L": "l", "lyricsref": [{"links": [{"N": "karnatik.com", "L": "https://karnatik.com/c8955.shtml"}]}]}