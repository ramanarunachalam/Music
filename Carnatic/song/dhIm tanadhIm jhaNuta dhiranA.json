\u0bc0\u0bae\u0bcd \u0ba4\u0b9c\u0ba3\u0bc1\u0ba4 <br/> \u0ba4\u0bbf\u0bb0\u0ba9\u0bbe \u0ba4\u0b95\u0ba4\u0bc0\u0bae\u0bcd \u0b9c\u0ba3\u0bc1\u0ba4\u0bc0\u0bae\u0bcd \u0ba4\u0ba4\u0ba9 \u0b9c\u0ba3\u0bc1\u0ba4 \u0b9a\u0bbf\u0bae\u0bbf\u0ba4 \u0ba4\u0b95\u0ba4\u0ba9 \u0ba4\u0bc0\u0bae\u0bcd \u0ba4\u0ba9\u0ba4\u0bc0\u0bae\u0bcd \u0ba4\u0ba9"}, {"M": "\u0b85\u0ba9\u0bc1\u0baa\u0bb2\u0bcd\u0bb2\u0bb5\u0bbf", "T": "\u0ba4\u0b95\u0ba4\u0bc0\u0bae\u0bcd \u0ba4\u0ba4\u0bc0\u0bae\u0bcd \u0b9c\u0ba3\u0bc1\u0ba4 \u0ba4\u0bc0\u0bae\u0bcd \u0ba4\u0b95\u0b9c\u0ba3\u0bc1\u0ba4\u0b95 \u0ba4\u0bb0\u0bbf\u0b95\u0bbf\u0b9f\u0ba4\u0bcb\u0bae\u0bcd \u0ba4\u0bc0\u0bae\u0bcd \u0ba4\u0b9c\u0bcd\u0b9c\u0bae\u0bcd <br/> \u0ba4\u0bbf\u0bae\u0bbf\u0ba4 \u0ba4\u0bb0\u0bbf\u0b95\u0bbf\u0b9f \u0ba4\u0bc0\u0bae\u0bcd \u0ba4\u0b9c\u0bcd\u0b9c\u0bae\u0bcd \u0ba4\u0bbe\u0bae\u0bcd\u0ba4 \u0ba4\u0bb0\u0bbf\u0b95\u0bbf\u0b9f\u0ba4\u0bc0\u0bae\u0bcd \u0ba4\u0b9c\u0bcd\u0b9c\u0bae\u0bcd \u0ba4\u0bcb\u0bae\u0bcd \u0ba4\u0ba4\u0bb0\u0bbf\u0b95\u0bbf\u0b9f"}, {"M": "\u0b9a\u0bb0\u0ba3\u0bae\u0bcd", "T": "\u0bae\u0bbe\u0ba4\u0bb5\u0ba9\u0bcd \u0bae\u0bb0\u0bc1\u0b95\u0bbe \u0bae\u0bb2\u0bb0\u0bbf\u0ba9\u0bc8\u0baa\u0bcd-\u0baa\u0bbe\u0ba4\u0bae\u0bc7 \u0b95\u0ba4\u0bbf\u0baf\u0bc6\u0ba9 \u0baa\u0ba3\u0bbf\u0ba8\u0bcd\u0ba4\u0bc7\u0ba9\u0bcd <br/> \u0ba8\u0bc0 \u0ba4\u0baf\u0bc8 \u0baa\u0bc1\u0bb0\u0bbf\u0baf\u0bbe\u0ba4\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bbf\u0b9f\u0bbf\u0bb2\u0bcd \u0ba8\u0bc0\u0ba4\u0bae\u0bbe \u0baa\u0bb0\u0bbf\u0bb5\u0bc1\u0b9f\u0ba9\u0bcd \u0b85\u0bb0\u0bc1\u0bb3\u0bcd\u0bb5\u0bbe\u0baf\u0bcd \u0ba4\u0bc0\u0bae\u0bcd\u0ba4\u0ba9\u0ba9 <br/> \u0ba4\u0ba9 \u0ba4\u0bc0\u0bae\u0bcd \u0b9c\u0ba3\u0bc1\u0ba4\u0ba4\u0bc0\u0bae\u0bcd \u0bae \u0bb0 \u0b95\u0bbe ; \u0ba4\u0ba4\u0bbf\u0bae\u0bcd \u0b95 \u0bae \u0ba8\u0bbf \u0ba4 \u0ba4\u0b95\u0b9c\u0ba3\u0bc1 <br/> \u0baa \u0ba8\u0bbf \u0b95* \u0bb0\u0bbf* \u0ba4\u0ba9\u0ba9 \u0ba4\u0ba9\u0ba4\u0bc0\u0bae\u0bcd \u0b95 \u0bae \u0baa \u0ba8\u0bbf \u0b9a* \u0b95* \u0bb0\u0bc0* \u0ba4\u0bbf\u0bae\u0bbf\u0ba4\u0b95 <br/> \u0ba4\u0bb0\u0bbf\u0b95\u0bbf\u0b9f \u0b9c\u0bae\u0bcd \u0ba4\u0bc0\u0bae\u0bcd \u0ba4\u0ba4\u0bc0\u0bae\u0bcd \u0ba4\u0b95 \u0ba4\u0bb0\u0bbf\u0b95\u0bbf\u0b9f \u0b9c\u0bae\u0bcd \u0ba4\u0bc0\u0bae\u0bcd \u0ba4\u0ba4\u0bc0\u0bae\u0bcd <br/> \u0ba4\u0b95 \u0ba4\u0bb0\u0bbf\u0b95\u0bbf\u0b9f \u0b9c\u0bae\u0bcd\u0ba4\u0bc0\u0bae\u0bcd \u0ba4\u0ba4\u0bc0\u0bae\u0bcd \u0ba4\u0bb0\u0bbf\u0b95\u0bbf\u0b9f \u0b9c\u0bae\u0bcd \u0ba4\u0bc0\u0bae\u0bcd\u0ba4"}]}, {"L": "Telugu", "text": [{"M": "\u0c2a\u0c32\u0c4d\u0c32\u0c35\u0c3f", "T": "\u0c27\u0c40\u0c2e\u0c4d \u0c24\u0c28\u0c27\u0c40\u0c2e\u0c4d \u0c1d\u0c23\u0c41\u0c24 \u0c27\u0c3f\u0c30\u0c28\u0c3e \u0c24\u0c15\u0c27\u0c40\u0c2e\u0c4d \u0c1d\u0c23\u0c41\u0c27\u0c40\u0c2e\u0c4d \u0c27\u0c40\u0c2e\u0c4d \u0c24\u0c28\u0c27\u0c40\u0c2e\u0c4d \u0c24\u0c1d\u0c23\u0c41\u0c24 <br/> \u0c27\u0c3f\u0c30\u0c28\u0c3e \u0c24\u0c15\u0c27\u0c40\u0c2e\u0c4d \u0c1d\u0c23\u0c41\u0c27\u0c40\u0c2e\u0c4d \u0c24\u0c24\u0c28 \u0c1d\u0c23\u0c41\u0c24 \u0c36\u0c3f\u0c2e\u0c3f\u0c24 \u0c24\u0c15\u0c24\u0c28 \u0c27\u0c40\u0c2e\u0c4d \u0c24\u0c28\u0c27\u0c40\u0c2e\u0c4d \u0c24\u0c28"}, {"M": "\u0c05\u0c28\u0c41\u0c2a\u0c32\u0c4d\u0c32\u0c35\u0c3f", "T": "\u0c24\u0c15\u0c27\u0c40\u0c2e\u0c4d \u0c24\u0c27\u0c40\u0c2e\u0c4d \u0c1d\u0c23\u0c41\u0c24 \u0c27\u0c40\u0c2e\u0c4d \u0c24\u0c15\u0c1d\u0c23\u0c41\u0c24\u0c15 \u0c24\u0c30\u0c3f\u0c15\u0c3f\u0c1f\u0c24\u0c4b\u0c2e\u0c4d \u0c27\u0c40\u0c2e\u0c4d \u0c24\u0c1c\u0c4d\u0c1d\u0c2e\u0c4d <br/> \u0c27\u0c3f\u0c2e\u0c3f\u0c24 \u0c24\u0c30\u0c3f\u0c15\u0c3f\u0c1f \u0c27\u0c40\u0c2e\u0c4d \u0c24\u0c1c\u0c4d\u0c1d\u0c2e\u0c4d \u0c24\u0c3e\u0c2e\u0c4d\u0c24 \u0c24\u0c30\u0c3f\u0c15\u0c3f\u0c1f\u0c27\u0c40\u0c2e\u0c4d \u0c24\u0c1c\u0c4d\u0c1d\u0c2e\u0c4d \u0c24\u0c4b\u0c2e\u0c4d \u0c24\u0c24\u0c30\u0c3f\u0c15\u0c3f\u0c1f"}, {"M": "\u0c1a\u0c30\u0c23\u0c2e\u0c4d", "T": "\u0c2e\u0c3e\u0c27\u0c35\u0c28\u0c4d \u0c2e\u0c30\u0c41\u0c17\u0c3e