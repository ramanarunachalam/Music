d. - <br/> \u0921\u094d \u0923\u094d \u0930\u093f* - \u0902 \u0921\u094d \u0923\u094d - \u0919\u094d \u0902 \u0921\u094d - \u0924\u0930\u093f\u0915\u093f\u091f \u0924\u0915\u0924\u0915\u093f\u091f \u0924\u0915.\u091d\u092e\u094d. - <br/> \u0921\u094d \u0923\u094d- \u0902 \u0921\u094d- \u0919\u094d \u0902- \u0924\u0930\u093f\u0915\u093f\u091f \u0924\u0915\u0924\u0915\u093f\u091f <br/> \u0907\u0907 \u0921\u094d \u0923\u094d \u0930\u093f* \u0924\u0930\u093f\u0915\u093f\u091f \u0924\u0915\u0924\u0915\u093f\u091f \u0924\u0915.\u091d\u092e\u094d. - <br/> \u0902 \u0921\u094d \u0923\u094d \u0930\u093f* \u0924\u0930\u093f\u0915\u093f\u091f \u0924\u0915\u0924\u0915\u093f\u091f \u0924\u0915.\u091d\u092e\u094d. \u0937\u094d \u090b , \u0919\u094d , - <br/> \u0919\u094d \u0902 \u0921\u094d \u0923\u094d \u0930\u093f* \u0924\u0930\u093f\u0915\u093f\u091f \u0924\u0915\u0924\u0915\u093f\u091f \u0924\u0915.\u091d\u092e\u094d. \u0937\u094d \u090b , \u0919\u094d, <br/> \u0907\u0907\u0907 \u0917* \u0930\u093f* \u0930\u093f* \u0938* \u0938* \u0923\u094d \u0923\u094d \u0921\u094d \u0924\u0915\u0924\u0915\u093f\u091f \u0924\u0915.\u091d\u092e\u094d. - <br/> \u0917* \u0930\u093f* \u0930\u093f* \u0938* \u0938* \u0923\u094d \u0923\u094d \u0921\u094d \u0924 . \u0915 . \u0924 . \u0915\u093f . \u091f . \u0924\u0915.\u091d\u092e\u094d. - <br/> \u0917* \u0930\u093f* \u0930\u093f* \u0938* \u0938* \u0923\u094d \u0923\u094d \u0921\u094d \u0924 . . \u0915 . . \u0924 . . \u0915\u093f . . \u091f . . \u0924\u0915\u091d\u092e\u094d"}, {"M": "\u091a\u0930\u0923\u092e\u094d 2", "T": "\u0924 \u0930\u093f . \u0915\u093f \u091f . \u0924 \u0915 . \u0927\u093f\u092e\u093f\u0915\u093f\u091f\u0924\u0915 \u0924 \u0930\u093f . \u0915\u093f \u091f . \u0924 \u0915 . \u0927\u093f\u092e\u093f\u0915\u093f\u091f\u0924\u0915 <br/> \u0924 \u0930\u093f . \u0915\u093f \u091f . \u0924 \u0915 . \u092e* \u0917* \u0930\u093f* \u0938* \u0923\u094d - \u0924\u0915\u0924\u0915\u093f\u091f - \u0930\u093f* \u0938* \u0923\u094d \u0921\u0