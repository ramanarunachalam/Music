bcd", "T": "\u0ba4\u0b95\u0bbf\u0b9f \u0ba4\u0bbf\u0b95\u0bbf\u0b9f \u0ba4\u0bbf\u0bae\u0bbf\u0ba4 \u0b9c\u0ba3\u0bc1\u0ba4 \u0ba4\u0bbe - \u0ba4\u0b95\u0bbf\u0b9f \u0ba4\u0bbf\u0b95\u0bbf\u0b9f \u0ba4\u0bbf\u0bae\u0bbf\u0ba4 \u0b9c\u0ba3\u0bc1\u0ba4 \u0ba4\u0bbe - <br/> \u0ba4\u0b95\u0bbf\u0b9f \u0ba4\u0bbf\u0b95\u0bbf\u0b9f \u0ba4\u0bbf\u0bae\u0bbf\u0ba4 \u0b9c\u0ba3\u0bc1\u0ba4 <br/> \u0ba4\u0ba4\u0bbe\u0bae\u0bcd \u0ba4\u0ba4\u0bbe\u0bae\u0bcd \u0ba4\u0ba4\u0bbe - \u0b95\u0bbf\u0b9f\u0ba4\u0bbe\u0bae\u0bcd \u0b95\u0bbf\u0b9f\u0ba4\u0bbe\u0bae\u0bcd \u0b95\u0bbf\u0b9f\u0ba4\u0bbe - \u0ba4\u0b95\u0bbf\u0b9f\u0ba4\u0bbe\u0bae\u0bcd \u0ba4\u0b95\u0bbf\u0b9f\u0ba4\u0bbe\u0bae\u0bcd \u0ba4\u0b95\u0bbf\u0b9f <br/> \u0bae\u0bcd\u0b99\u0bcd\u0bb0\u0bc1\u0bb7\u0bcd\u0ba3\u0bcd \u0ba4\u0b95\u0ba4\u0b95\u0bbf\u0b9f \u0ba4\u0bbe - \u0bae\u0bcd\u0b99\u0bcd\u0bb0\u0bc1\u0bb7\u0bcd\u0ba3\u0bcd \u0ba4\u0b95.\u0ba4\u0b95\u0bbf.\u0b9f \u0ba4\u0bbe - \u0bae\u0bcd\u0b99\u0bcd\u0bb0\u0bc1\u0bb7\u0bcd\u0ba3\u0bcd \u0ba4\u0b95..\u0ba4\u0b95\u0bbf..\u0b9f"}]}, {"L": "Telugu", "text": [{"M": "\u0c2a\u0c32\u0c4d\u0c32\u0c35\u0c3f", "T": "\u0c24\u0c24\u0c4d\u0c24\u0c4b\u0c2e\u0c4d \u0c24\u0c24\u0c4d\u0c24\u0c4b\u0c2e\u0c4d \u0c24\u0c24\u0c4d\u0c24\u0c4b\u0c2e\u0c4d \u0c24\u0c15\u0c3f\u0c1f \u0c27\u0c3f\u0c30\u0c28\u0c3e <br/> \u0c24\u0c15\u0c1d\u0c23\u0c41 \u0c24\u0c15\u0c24\u0c1d\u0c23\u0c41 \u0c24\u0c15\u0c27\u0c3f\u0c28 \u0c24\u0c27\u0c40\u0c02\u0c17\u0c3f\u0c23\u0c24\u0c4a\u0c2e\u0c4d <br/> \u0c24\u0c30\u0c3f\u0c15\u0c3f\u0c1f\u0c24\u0c15\u0c27\u0c3f\u0c28 \u0c24\u0c3e \u0c24\u0c30\u0c3f.\u0c15\u0c3f\u0c1f.\u0c24\u0c15.\u0c27\u0c3f\u0c28 \u0c24\u0c3e \u0c24\u0c30\u0c3f..\u0c15\u0c3f\u0c1f..\u0c24\u0c15..\u0c27\u0c3f\u0c28"}, {"M": "\u0c05\u0c28\u0c41\u0c2a\u0c32\u0c4d\u0c32\u0c35\u0c3f", "T": "\u0c24\u0c15\u0c27\u0c40\u0c2e\u0c4d\u0c24 \u0c15\u0c3f\u0c1f\u0c27\u0c3f\u0c28 \u0c24\u0c15\u0c24\u0c4b\u0c2e\u0c4d \u0c24\u0c15\u0c3f\u0c1f \u0c24\u0c4b\u0c2e\u0c4d \u0c15\u0c3f\u0c1f\u0c27\u0c40\u0c2e\u0c4d\u0c24 \u0c24\u0c15\u0c27\u0c3f\u0c28\u0c24\u0c4b\u0c2e\u0c4d \u0c24\u0c15\u0c24\u0c15\u0c3f\u0c1f \u0c24\u0c4b\u0c2e\u0c4d <br/> \u0c24\u0c30\u0c3f\u0c15\u0c3f\u0c1f \u0c24\u0c3e\u0c2e\u0c4d \u0c24\u0c15\u0c24\u0c30\u0c3f\u0c15\u0c3f\u0c1f \u0c24\u0c3e - \u0c24\u0c30\u0c3f\u0c15\u0c3f\u0c1f \u0c24\u0c3e\u0c2e\u0c4d \u0c24\u0c15\u0c24\u0c30\u0c3f\u0c15\u0c3f\u0c1f \u0c24\u0c3e - \u0c24\u0c30\u0c3f\u0c15\u0c3f\u0c1f \u0c24\u0c3e\u0c2e\u0c4d \u0c24\u0c15\u0c24\u0c30\u0c3f\u0c15\u0c3f\u0c1f <br/> \u0c24\u0c15\u0c3f\u0c1f \u0c24\u0c3e\u0c2e\u0c4d \u0c24\u0c15\u0c24\u0c30\u0c3f\u0c15\u0c3f\u0c1f \u0c24\u0c3e - \u0c24\u0c30\u0c3f\u0c15\u0c3f\u0c1f \u0c24\u0c3e\u0c2e\u0c4d \u0c24\u0c15\u0c24\u0c30\u0c3f\u0c15\u0c3f\u0c1f \u0c24\u0c3e - \u0c24\u0c24\u0c30\u0c3f\u0c15\u0c3f\u0c1f \u0c24\u0c3e\u0c2e\u0c4d \u0c24\u0c15\u0c24\u0c30\u0c3f\u0c15\u0c3f\u0c1f"}, {"M": "\u0c1a\u0c3f\u0c1f\u0c4d\u0c1f\u0c38\u0c4d\u0c35\u0c30\u0c2e\u0c4d", "T": "\u0c35\u0c3e\u0c28\u0c35\u0c30\u0c4d \u0c35\u0c3e\u0c34\u0c4d\u0c24\u0c4d\u0c24\u0c41\u0c2e\u0c4d \u0c26\u0c47\u0c35\u0c3e\u0c26\u0c3f \u0c26\u0c47\u0c35\u0c3e \u0c15\u0c47\u0c36\u0c35\u0c3e \u0c35\u0c40\u0c30 \u0c35\u0c3e\u0c38\u0c41\u0c26\u0c47\u0c35\u0c3e \u0c2f\u0c3e\u0c26\u0c35\u0c3e \u0c07 \u0c38\u0c15\u0c32 \u0c07\u0c07 \u0c28\u0c40\u0c32 <br/> \u0c35\u0c3e\u0c28\u0c2e\u0c4d \u0c35\u0c46\u0c32\u0c4d \u0c05\u0c34\u0c39\u0c28\u0c47 \u0c35\u0c3e \u0c07\u0c0b\u0c10\u0c35\u0c3e \u0c2e\u0c27\u0c35\u0c3e \u0c0e\u0c28\u0c4d\u0c28\u0c48 \u0c0f\u0c0b\u0c15\u0c35\u0c47 \u0c35\u0c3e\u0c26\u0c41 \u0c36\u0c46\u0c07\u0c2f\u0c3e\u0c26\u0c41 \u0c35\u0c3e"}, {"M": "\u0c1c\u0c24\u0c3f\u0c38\u0c4d\u0c35\u0c30\u0c2e\u0c4d", "T": "\u0c24\u0c1d\u0c2e\u0c4d \u0c24\u0c15\u0c3f\u0c1f \u0c24\u0c28\u0c27\u0c3f\u0c30\u0c28\u0c3e \u0c21\u0c4dP\u0c02\u0c19\u0c43 \u0c24\u0c28\u0c2e\u0c4d \u0c24\u0c15\u0c3f\u0c1f \u0c24\u0c28\u0c27\u0c3f\u0c30\u0c28\u0c3e \u0c23\u0c4d\u0c21\u0c4dP\u0c02\u0c19\u0c43\u0c37\u0c4d <br/> \u0c24\u0c15\u0c27\u0c3f\u0c28 \u0c24\u0c4b\u0c2e\u0c4d \u0c24\u0c4b\u0c2e\u0c4d \u0c02\u0c19\u0c43\u0c37\u0c4d\u0c23\u0c4d \u0c24\u0c15\u0c27\u0c3f\u0c28 \u0c24\u0c4b\u0c2e\u0c4d \u0c24\u0c4b\u0c2e\u0c4d P\u0c02\u0c19\u0c43\u0c37\u0c4d \u0c24\u0c15\u0c27\u0c3f\u0c28 \u0c24\u0c4b\u0c2e\u0c4d \u0c24\u0c4b\u0c2e\u0c4d <br/> \u0c2e*,,\u0c17*\u0c30\u0c3f*\u0c38*\u0c23\u0c4d \u0c30\u0c35\u0c3f \u0c36\u0c36\u0c3f \u0c28\u0c2f\u0c28\u0c28\u0c47 \u0c2a\u0c30\u0c3f\u0c35\u0c41\u0c21\u0c28\u0c4d \u0c35\u0c3f\u0c30\u0c48\u0c35\u0c3f\u0c28\u0c3f\u0c32\u0c4d \u0c05\u0c2d\u0c2f\u0c2e\u0c4d \u0c24\u0c02\u0c26\u0c30\u0c41\u0c33 \u0c35\u0c3e"}, {"M": "\u0c1a\u0c30\u0c23\u0c2e\u0c4d", "T": "\u0c24\u0c15\u0c3f\u0c1f \u0c27\u0c3f\u0c15\u0c3f\u0c1f \u0c27\u0c3f\u0c2e\u0c3f\u0c24 \u0c1d\u0c23\u0c41\u0c24 \u0c24\u0c3e - \u0c24\u0c15\u0c3f\u0c1f \u0c27\u0c3f\u0c15\u0c3f\u0c1f \u0c27\u0c3f\u0c2e\u0c3f\u0c24 \u0c1d\u0c23\u0c41\u0c24 \u0c24\u0c3e - <br/> \u0c24\u0c15\u0c3f\u0c1f \u0c27\u0c3f\u0c15\u0c3f\u0c1f \u0c27\u0c3f\u0c2e\u0c3f\u0c24 \u0c1d\u0c23\u0c41\u0c24 <br/> \u0c24\u0c24\u0c3e\u0c2e\u0c4d \u0c24\u0c24\u0c3e\u0c2e\u0c4d \u0c24\u0c24\u0c3e - \u0c15\u0c3f\u0c1f\u0c24\u0c3e\u0c2e\u0c4d \u0c15\u0c3f\u0c1f\u0c24\u0c3e\u0c2e\u0c4d \u0c15\u0c3f\u0c1f\u0c24\u0c3e - \u0c24\u0c15\u0c3f\u0c1f\u0c24\u0c3e\u0c2e\u0c4d \u0c24\u0c15\u0c3f\u0c1f\u0c24\u0c3e\u0c2e\u0c4d \u0c24\u0c15\u0c3f\u0c1f <br/> \u0c02\u0c19\u0c43\u0c37\u0c4d\u0c23\u0c4d \u0c24\u0c15\u0c24\u0c15\u0c3f\u0c1f \u0c24\u0c3e - \u0c02\u0c19\u0c43\u0c37\u0c4d\u0c23\u0c4d \u0c24\u0c15.\u0c24\u0c15\u0c3f.\u0c1f \u0c24\u0c3e - \u0c02\u0c19\u0c43\u0c37\u0c4d\u0c23\u0c4d \u0c24\u0c15..\u0c24\u0c15\u0c3f..\u0c1f"}]}, {"L": "Kannada", "text": [{"M": "\u0caa\u0cb2\u0ccd\u0cb2\u0cb5\u0cbf", "T": "\u0ca4\u0ca4\u0ccd\u0ca4\u0ccb\u0cae\u0ccd \u0ca4\u0ca4\u0ccd\u0ca4\u0ccb\u0cae\u0ccd \u0ca4\u0ca4\u0ccd\u0ca4\u0ccb\u0cae\u0ccd \u0ca4\u0c95\u0cbf\u0c9f \u0ca7\u0cbf\u0cb0\u0ca8\u0cbe <br/> \u0ca4\u0c95\u0c9d\u0ca3\u0cc1 \u0ca4\u0c95\u0ca4\u0c9d\u0ca3\u0cc1 \u0ca4\u0c95\u0ca7\u0cbf\u0ca8 \u0ca4\u0ca7\u0cc0\u0c82\u0c97\u0cbf\u0ca3\u0ca4\u0cca\u0cae\u0ccd <br/> \u0ca4\u0cb0\u0cbf\u0c95\u0cbf\u0c9f\u0ca4\u0c95\u0ca7\u0cbf\u0ca8 \u0ca4\u0cbe \u0ca4\u0cb0\u0cbf.\u0c95\u0cbf\u0c9f.\u0ca4\u0c95.\u0ca7\u0cbf\u0ca8 \u0ca4\u0cbe \u0ca4\u0cb0\u0cbf..\u0c95\u0cbf\u0c9f..\u0ca4\u0c95..\u0ca7\u0cbf\u0ca8"}, {"M": "\u0c85\u0ca8\u0cc1\u0caa\u0cb2\u0ccd\u0cb2\u0cb5\u0cbf", "T": "\u0ca4\u0c95\u0ca7\u0cc0\u0cae\u0ccd\u0ca4 \u0c95\u0cbf\u0c9f\u0ca7\u0cbf\u0ca8 \u0ca4\u0c95\u0ca4\u0ccb\u0cae\u0ccd \u0ca4\u0c95\u0cbf\u0c9f \u0ca4\u0ccb\u0cae\u0ccd \u0c95\u0cbf\u0c9f\u0ca7\u0cc0\u0cae\u0ccd\u0ca4 \u0ca4\u0c95\u0ca7\u0cbf\u0ca8\u0ca4\u0ccb\u0cae\u0ccd \u0ca4\u0c95\u0ca4\u0c95\u0cbf\u0c9f \u0ca4\u0ccb\u0cae\u0ccd <br/> \u0ca4\u0cb0\u0cbf\u0c95\u0cbf\u0c9f \u0ca4\u0cbe\u0cae\u0ccd \u0ca4\u0c95\u0ca4\u0cb0\u0cbf\u0c95\u0cbf\u0c9f \u0ca4\u0cbe - \u0ca4\u0cb0\u0cbf\u0c95\u0cbf\u0c9f \u0ca4\u0cbe\u0cae\u0ccd \u0ca4\u0c95\u0ca4\u0cb0\u0cbf\u0c95\u0cbf\u0c9f \u0ca4\u0cbe - \u0ca4\u0cb0\u0cbf\u0c95\u0cbf\u0c9f \u0ca4\u0cbe\u0cae\u0ccd \u0ca4\u0c95\u0ca4\u0cb0\u0cbf\u0c95\u0cbf\u0c9f <br/> \u0ca4\u0c95\u0cbf\u0c9f \u0ca4\u0cbe\u0cae\u0ccd \u0ca4\u0c95\u0ca4\u0cb0\u0cbf\u0c95\u0cbf\u0c9f \u0ca4\u0cbe - \u0ca4\u0cb0\u0cbf\u0c95\u0cbf\u0c9f \u0ca4\u0cbe\u0cae\u0ccd \u0ca4\u0c95\u0ca4\u0cb0\u0cbf\u0c95\u0cbf\u0c9f \u0ca4\u0cbe - \u0ca4\u0ca4\u0cb0\u0cbf\u0c95\u0cbf\u0c9f \u0ca4\u0cbe\u0cae\u0ccd \u0ca4\u0c95\u0ca4\u0cb0\u0cbf\u0c95\u0cbf\u0c9f"}, {"M": "\u0c9a\u0cbf\u0c9f\u0ccd\u0c9f\u0cb8\u0ccd\u0cb5\u0cb0\u0cae\u0ccd", "T": "\u0cb5\u0cbe\u0ca8\u0cb5\u0cb0\u0ccd \u0cb5\u0cbe\u0cb3\u0ccd\u0ca4\u0ccd\u0ca4\u0cc1\u0cae\u0ccd \u0ca6\u0cc7\u0cb5\u0cbe\u0ca6\u0cbf \u0ca6\u0cc7\u0cb5\u0cbe \u0c95\u0cc7\u0cb6\u0cb5\u0cbe \u0cb5\u0cc0\u0cb0 \u0cb5\u0cbe\u0cb8\u0cc1\u0ca6\u0cc7\u0cb5\u0cbe \u0caf\u0cbe\u0ca6\u0cb5\u0cbe \u0c87 \u0cb8\u0c95\u0cb2 \u0c87\u0c87 \u0ca8\u0cc0\u0cb2 <br/> \u0cb5\u0cbe\u0ca8\u0cae\u0ccd \u0cb5\u0cc6\u0cb2\u0ccd \u0c85\u0cb3\u0cb9\u0ca8\u0cc7 \u0cb5\u0cbe \u0c87\u0c8b\u0c90\u0cb5\u0cbe \u0cae\u0ca7\u0cb5\u0cbe \u0c8e\u0ca8\u0ccd\u0ca8\u0cc8 \u0c8f\u0c8b\u0c95\u0cb5\u0cc7 \u0cb5\u0cbe\u0ca6\u0cc1 \u0cb6\u0cc6\u0c87\u0caf\u0cbe\u0ca6\u0cc1 \u0cb5\u0cbe"}, {"M": "\u0c9c\u0ca4\u0cbf\u0cb8\u0ccd\u0cb5\u0cb0\u0cae\u0ccd", "T": "\u0ca4\u0c9d\u0cae\u0ccd \u0ca4\u0c95\u0cbf\u0c9f \u0ca4\u0ca8\u0ca7\u0cbf\u0cb0\u0ca8\u0cbe \u0ca1\u0ccdP\u0c82\u0c99\u0cc3 \u0ca4\u0ca8\u0cae\u0ccd \u0ca4\u0c95\u0cbf\u0c9f \u0ca4\u0ca8\u0ca7\u0cbf\u0cb0\u0ca8\u0cbe \u0ca3\u0ccd\u0ca1\u0ccdP\u0c82\u0c99\u0cc3\u0cb7\u0ccd <br/> \u0ca4\u0c95\u0ca7\u0cbf\u0ca8 \u0ca4\u0ccb\u0cae\u0ccd \u0ca4\u0ccb\u0cae\u0ccd \u0c82\u0c99\u0cc3\u0cb7\u0ccd\u0ca3\u0ccd \u0ca4\u0c95\u0ca7\u0cbf\u0ca8 \u0ca4\u0ccb\u0cae\u0ccd \u0ca4\u0ccb\u0cae\u0ccd P\u0c82\u0c99\u0cc3\u0cb7\u0ccd \u0ca4\u0c95\u0ca7\u0cbf\u0ca8 \u0ca4\u0ccb\u0cae\u0ccd \u0ca4\u0ccb\u0cae\u0ccd <br/> \u0cae*,,\u0c97*\u0cb0\u0cbf*\u0cb8*\u0ca3\u0ccd \u0cb0\u0cb5\u0cbf \u0cb6\u0cb6\u0cbf \u0ca8\u0caf\u0ca8\u0ca8\u0cc7 \u0caa\u0cb0\u0cbf\u0cb5\u0cc1\u0ca1\u0ca8\u0ccd \u0cb5\u0cbf\u0cb0\u0cc8\u0cb5\u0cbf\u0ca8\u0cbf\u0cb2\u0ccd \u0c85\u0cad\u0caf\u0cae\u0ccd \u0ca4\u0c82\u0ca6\u0cb0\u0cc1\u0cb3 \u0cb5\u0cbe"}, {"M": "\u0c9a\u0cb0\u0ca3\u0cae\u0ccd", "T": "\u0ca4\u0c95\u0cbf\u0c9f \u0ca7\u0cbf\u0c95\u0cbf\u0c9f \u0ca7\u0cbf\u0cae\u0cbf\u0ca4 \u0c9d\u0ca3\u0cc1\u0ca4 \u0ca4\u0cbe - \u0ca4\u0c95\u0cbf\u0c9f \u0ca7\u0cbf\u0c95\u0cbf\u0c9f \u0ca7\u0cbf\u0cae\u0cbf\u0ca4 \u0c9d\u0ca3\u0cc1\u0ca4 \u0ca4\u0cbe - <br/> \u0ca4\u0c95\u0cbf\u0c9f \u0ca7\u0cbf\u0c95\u0cbf\u0c9f \u0ca7\u0cbf\u0cae\u0cbf\u0ca4 \u0c9d\u0ca3\u0cc1\u0ca4 <br/> \u0ca4\u0ca4\u0cbe\u0cae\u0ccd \u0ca4\u0ca4\u0cbe\u0cae\u0ccd \u0ca4\u0ca4\u0cbe - \u0c95\u0cbf\u0c9f\u0ca4\u0cbe\u0cae\u0ccd \u0c95\u0cbf\u0c9f\u0ca4\u0cbe\u0cae\u0ccd \u0c95\u0cbf\u0c9f\u0ca4\u0cbe - \u0ca4\u0c95\u0cbf\u0c9f\u0ca4\u0cbe\u0cae\u0ccd \u0ca4\u0c95\u0cbf\u0c9f\u0ca4\u0cbe\u0cae\u0ccd \u0ca4\u0c95\u0cbf\u0c9f <br/> \u0c82\u0c99\u0cc3\u0cb7\u0ccd\u0ca3\u0ccd \u0ca4\u0c95\u0ca4\u0c95\u0cbf\u0c9f \u0ca4\u0cbe - \u0c82\u0c99\u0cc3\u0cb7\u0ccd\u0ca3\u0ccd \u0ca4\u0c95.\u0ca4\u0c95\u0cbf.\u0c9f \u0ca4\u0cbe - \u0c82\u0c99\u0cc3\u0cb7\u0ccd\u0ca3\u0ccd \u0ca4\u0c95..\u0ca4\u0c95\u0cbf..\u0c9f"}]}, {"L": "Malayalam", "text": [{"M": "\u0d2a\u0d32\u0d4d\u0d32\u0d35\u0d3f", "T": "\u0d24\u0d24\u0d4d\u0d24\u0d4b\u0d2e\u0d4d \u0d24\u0d24\u0d4d\u0d24\u0d4b\u0d2e\u0d4d \u0d24\u0d24\u0d4d\u0d24\u0d4b\u0d2e\u0d4d \u0d24\u0d15\u0d3f\u0d1f \u0d27\u0d3f\u0d30\u0d28\u0d3e <br/> \u0d24\u0d15\u0d1d\u0d23\u0d41 \u0d24\u0d15\u0d24\u0d1d\u0d23\u0d41 \u0d24\u0d15\u0d27\u0d3f\u0d28 \u0d24\u0d27\u0d40\u0d02\u0d17\u0d3f\u0d23\u0d24\u0d4a\u0d2e\u0d4d <br/> \u0d24\u0d30\u0d3f\u0d15\u0d3f\u0d1f\u0d24\u0d15\u0d27\u0d3f\u0d28 \u0d24\u0d3e \u0d24\u0d30\u0d3f.\u0d15\u0d3f\u0d1f.\u0d24\u0d15.\u0d27\u0d3f\u0d28 \u0d24\u0d3e \u0d24\u0d30\u0d3f..\u0d15\u0d3f\u0d1f..\u0d24\u0d15..\u0d27\u0d3f\u0d28"}, {"M": "\u0d05\u0d28\u0d41\u0d2a\u0d32\u0d4d\u0d32\u0d35\u0d3f", "T": "\u0d24\u0d15\u0d27\u0d40\u0d2e\u0d4d\u0d24 \u0d15\u0d3f\u0d1f\u0d27\u0d3f\u0d28 \u0d24\u0d15\u0d24\u0d4b\u0d2e\u0d4d \u0d24\u0d15\u0d3f\u0d1f \u0d24\u0d4b\u0d2e\u0d4d \u0d15\u0d3f\u0d1f\u0d27\u0d40\u0d2e\u0d4d\u0d24 \u0d24\u0d15\u0d27\u0d3f\u0d28\u0d24\u0d4b\u0d2e\u0d4d \u0d24\u0d15\u0d24\u0d15\u0d3f\u0d1f \u0d24\u0d4b\u0d2e\u0d4d <br/> \u0d24\u0d30\u0d3f\u0d15\u0d3f\u0d1f \u0d24\u0d3e\u0d2e\u0d4d \u0d24\u0d15\u0d24\u0d30\u0d3f\u0d15\u0d3f\u0d1f \u0d24\u0d3e - \u0d24\u0d30\u0d3f\u0d15\u0d3f\u0d1f \u0d24\u0d3e\u0d2e\u0d4d \u0d24\u0d15\u0d24\u0d30\u0d3f\u0d15\u0d3f\u0d1f \u0d24\u0d3e - \u0d24\u0d30\u0d3f\u0d15\u0d3f\u0d1f \u0d24\u0d3e\u0d2e\u0d4d \u0d24\u0d15\u0d24\u0d30\u0d3f\u0d15\u0d3f\u0d1f <br/> \u0d24\u0d15\u0d3f\u0d1f \u0d24\u0d3e\u0d2e\u0d4d \u0d24\u0d15\u0d24\u0d30\u0d3f\u0d15\u0d3f\u0d1f \u0d24\u0d3e - \u0d24\u0d30\u0d3f\u0d15\u0d3f\u0d1f \u0d24\u0d3e\u0d2e\u0d4d \u0d24\u0d15\u0d24\u0d30\u0d3f\u0d15\u0d3f\u0d1f \u0d24\u0d3e - \u0d24\u0d24\u0d30\u0d3f\u0d15\u0d3f\u0d1f \u0d24\u0d3e\u0d2e\u0d4d \u0d24\u0d15\u0d24\u0d30\u0d3f\u0d15\u0d3f\u0d1f"}, {"M": "\u0d1a\u0d3f\u0d1f\u0d4d\u0d1f\u0d38\u0d4d\u0d35\u0d30\u0d2e\u0d4d", "T": "\u0d35\u0d3e\u0d28\u0d35\u0d30\u0d4d \u0d35\u0d3e\u0d34\u0d4d\u0d24\u0d4d\u0d24\u0d41\u0d2e\u0d4d \u0d26\u0d47\u0d35\u0d3e\u0d26\u0d3f \u0d26\u0d47\u0d35\u0d3e \u0d15\u0d47\u0d36\u0d35\u0d3e \u0d35\u0d40\u0d30 \u0d35\u0d3e\u0d38\u0d41\u0d26\u0d47\u0d35\u0d3e \u0d2f\u0d3e\u0d26\u0d35\u0d3e \u0d07 \u0d38\u0d15\u0d32 \u0d07\u0d07 \u0d28\u0d40\u0d32 <br/> \u0d35\u0d3e\u0d28\u0d2e\u0d4d \u0d35\u0d46\u0d32\u0d4d \u0d05\u0d34\u0d39\u0d28\u0d47 \u0d35\u0d3e \u0d07\u0d0b\u0d10\u0d35\u0d3e \u0d2e\u0d27\u0d35\u0d3e \u0d0e\u0d28\u0d4d\u0d28\u0d48 \u0d0f\u0d0b\u0d15\u0d35\u0d47 \u0d35\u0d3e\u0d26\u0d41 \u0d36\u0d46\u0d07\u0d2f\u0d3e\u0d26\u0d41 \u0d35\u0d3e"}, {"M": "\u0d1c\u0d24\u0d3f\u0d38\u0d4d\u0d35\u0d30\u0d2e\u0d4d", "T": "\u0d24\u0d1d\u0d2e\u0d4d \u0d24\u0d15\u0d3f\u0d1f \u0d24\u0d28\u0d27\u0d3f\u0d30\u0d28\u0d3e \u0d21\u0d4dP\u0d02\u0d19\u0d43 \u0d24\u0d28\u0d2e\u0d4d \u0d24\u0d15\u0d3f\u0d1f \u0d24\u0d28\u0d27\u0d3f\u0d30\u0d28\u0d3e \u0d23\u0d4d\u0d21\u0d4dP\u0d02\u0d19\u0d43\u0d37\u0d4d <br/> \u0d24\u0d15\u0d27\u0d3f\u0d28 \u0d24\u0d4b\u0d2e\u0d4d \u0d24\u0d4b\u0d2e\u0d4d \u0d02\u0d19\u0d43\u0d37\u0d4d\u0d23\u0d4d \u0d24\u0d15\u0d27\u0d3f\u0d28 \u0d24\u0d4b\u0d2e\u0d4d \u0d24\u0d4b\u0d2e\u0d4d P\u0d02\u0d19\u0d43\u0d37\u0d4d \u0d24\u0d15\u0d27\u0d3f\u0d28 \u0d24\u0d4b\u0d2e\u0d4d \u0d24\u0d4b\u0d2e\u0d4d <br/> \u0d2e*,,\u0d17*\u0d30\u0d3f*\u0d38*\u0d23\u0d4d \u0d30\u0d35\u0d3f \u0d36\u0d36\u0d3f \u0d28\u0d2f\u0d28\u0d28\u0d47 \u0d2a\u0d30\u0d3f\u0d35\u0d41\u0d21\u0d28\u0d4d \u0d35\u0d3f\u0d30\u0d48\u0d35\u0d3f\u0d28\u0d3f\u0d32\u0d4d \u0d05\u0d2d\u0d2f\u0d2e\u0d4d \u0d24\u0d02\u0d26\u0d30\u0d41\u0d33 \u0d35\u0d3e"}, {"M": "\u0d1a\u0d30\u0d23\u0d2e\u0d4d", "T": "\u0d24\u0d15\u0d3f\u0d1f \u0d27\u0d3f\u0d15\u0d3f\u0d1f \u0d27\u0d3f\u0d2e\u0d3f\u0d24 \u0d1d\u0d23\u0d41\u0d24 \u0d24\u0d3e - \u0d24\u0d15\u0d3f\u0d1f \u0d27\u0d3f\u0d15\u0d3f\u0d1f \u0d27\u0d3f\u0d2e\u0d3f\u0d24 \u0d1d\u0d23\u0d41\u0d24 \u0d24\u0d3e - <br/> \u0d24\u0d15\u0d3f\u0d1f \u0d27\u0d3f\u0d15\u0d3f\u0d1f \u0d27\u0d3f\u0d2e\u0d3f\u0d24 \u0d1d\u0d23\u0d41\u0d24 <br/> \u0d24\u0d24\u0d3e\u0d2e\u0d4d \u0d24\u0d24\u0d3e\u0d2e\u0d4d \u0d24\u0d24\u0d3e - \u0d15\u0d3f\u0d1f\u0d24\u0d3e\u0d2e\u0d4d \u0d15\u0d3f\u0d1f\u0d24\u0d3e\u0d2e\u0d4d \u0d15\u0d3f\u0d1f\u0d24\u0d3e - \u0d24\u0d15\u0d3f\u0d1f\u0d24\u0d3e\u0d2e\u0d4d \u0d24\u0d15\u0d3f\u0d1f\u0d24\u0d3e\u0d2e\u0d4d \u0d24\u0d15\u0d3f\u0d1f <br/> \u0d02\u0d19\u0d43\u0d37\u0d4d\u0d23\u0d4d \u0d24\u0d15\u0d24\u0d15\u0d3f\u0d1f \u0d24\u0d3e - \u0d02\u0d19\u0d43\u0d37\u0d4d\u0d23\u0d4d \u0d24\u0d15.\u0d24\u0d15\u0d3f.\u0d1f \u0d24\u0d3e - \u0d02\u0d19\u0d43\u0d37\u0d4d\u0d23\u0d4d \u0d24\u0d15..\u0d24\u0d15\u0d3f..\u0d1f"}]}, {"L": "Sanskrit", "text": [{"M": "\u092a\u0932\u094d\u0932\u0935\u093f", "T": "\u0924\u0924\u094d\u0924\u094b\u092e\u094d \u0924\u0924\u094d\u0924\u094b\u092e\u094d \u0924\u0924\u094d\u0924\u094b\u092e\u094d \u0924\u0915\u093f\u091f \u0927\u093f\u0930\u0928\u093e <br/> \u0924\u0915\u091d\u0923\u0941 \u0924\u0915\u0924\u091d\u0923\u0941 \u0924\u0915\u0927\u093f\u0928 \u0924\u0927\u0940\u0902\u0917\u093f\u0923\u0924\u094b\u092e\u094d <br/> \u0924\u0930\u093f\u0915\u093f\u091f\u0924\u0915\u0927\u093f\u0928 \u0924\u093e \u0924\u0930\u093f.\u0915\u093f\u091f.\u0924\u0915.\u0927\u093f\u0928 \u0924\u093e \u0924\u0930\u093f..\u0915\u093f\u091f..\u0924\u0915..\u0927\u093f\u0928"}, {"M": "\u0905\u0928\u0941\u092a\u0932\u094d\u0932\u0935\u093f", "T": "\u0924\u0915\u0927\u0940\u092e\u094d\u0924 \u0915\u093f\u091f\u0927\u093f\u0928 \u0924\u0915\u0924\u094b\u092e\u094d \u0924\u0915\u093f\u091f \u0924\u094b\u092e\u094d \u0915\u093f\u091f\u0927\u0940\u092e\u094d\u0924 \u0924\u0915\u0927\u093f\u0928\u0924\u094b\u092e\u094d \u0924\u0915\u0924\u0915\u093f\u091f \u0924\u094b\u092e\u094d <br/> \u0924\u0930\u093f\u0915\u093f\u091f \u0924\u093e\u092e\u094d \u0924\u0915\u0924\u0930\u093f\u0915\u093f\u091f \u0924\u093e - \u0924\u0930\u093f\u0915\u093f\u091f \u0924\u093e\u092e\u094d \u0924\u0915\u0924\u0930\u093f\u0915\u093f\u091f \u0924\u093e - \u0924\u0930\u093f\u0915\u093f\u091f \u0924\u093e\u092e\u094d \u0924\u0915\u0924\u0930\u093f\u0915\u093f\u091f <br/> \u0924\u0915\u093f\u091f \u0924\u093e\u092e\u094d \u0924\u0915\u0924\u0930\u093f\u0915\u093f\u091f \u0924\u093e - \u0924\u0930\u093f\u0915\u093f\u091f \u0924\u093e\u092e\u094d \u0924\u0915\u0924\u0930\u093f\u0915\u093f\u091f \u0924\u093e - \u0924\u0924\u0930\u093f\u0915\u093f\u091f \u0924\u093e\u092e\u094d \u0924\u0915\u0924\u0930\u093f\u0915\u093f\u091f"}, {"M": "\u091a\u093f\u091f\u094d\u091f\u0938\u094d\u0935\u0930\u092e\u094d", "T": "\u0935\u093e\u0928\u0935\u0930\u094d \u0935\u093e\u0932\u094d\u0924\u094d\u0924\u0941\u092e\u094d \u0926\u0947\u0935\u093e\u0926\u093f \u0926\u0947\u0935\u093e \u0915\u0947\u0936\u0935\u093e \u0935\u0940\u0930 \u0935\u093e\u0938\u0941\u0926\u0947\u0935\u093e \u092f\u093e\u0926\u0935\u093e \u0907 \u0938\u0915\u0932 \u0907\u0907 \u0928\u0940\u0932 <br/> \u0935\u093e\u0928\u092e\u094d \u0935\u0947\u0932\u094d \u0905\u0932\u0939\u0928\u0947 \u0935\u093e \u0907\u090b\u0910\u0935\u093e \u092e\u0927\u0935\u093e \u090f\u0928\u094d\u0928\u0948 \u090f\u090b\u0915\u0935\u0947 \u0935\u093e\u0926\u0941 \u0936\u0947\u0907\u092f\u093e\u0926\u0941 \u0935\u093e"}, {"M": "\u091c\u0924\u093f\u0938\u094d\u0935\u0930\u092e\u094d", "T": "\u0924\u091d\u092e\u094d \u0924\u0915\u093f\u091f \u0924\u0928\u0927\u093f\u0930\u0928\u093e \u0921\u094dP\u0902\u0919\u0943 \u0924\u0928\u092e\u094d \u0924\u0915\u093f\u091f \u0924\u0928\u0927\u093f\u0930\u0928\u093e \u0923\u094d\u0921\u094dP\u0902\u0919\u0943\u0937\u094d <br/> \u0924\u0915\u0927\u093f\u0928 \u0924\u094b\u092e\u094d \u0924\u094b\u092e\u094d \u0902\u0919\u0943\u0937\u094d\u0923\u094d \u0924\u0915\u0927\u093f\u0928 \u0924\u094b\u092e\u094d \u0924\u094b\u092e\u094d P\u0902\u0919\u0943\u0937\u094d \u0924\u0915\u0927\u093f\u0928 \u0924\u094b\u092e\u094d \u0924\u094b\u092e\u094d <br/> \u092e*,,\u0917*\u0930\u093f*\u0938*\u0923\u094d \u0930\u0935\u093f \u0936\u0936\u093f \u0928\u092f\u0928\u0928\u0947 \u092a\u0930\u093f\u0935\u0941\u0921\u0928\u094d \u0935\u093f\u0930\u0948\u0935\u093f\u0928\u093f\u0932\u094d \u0905\u092d\u092f\u092e\u094d \u0924\u0902\u0926\u0930\u0941\u0932 \u0935\u093e"}, {"M": "\u091a\u0930\u0923\u092e\u094d", "T": "\u0924\u0915\u093f\u091f \u0927\u093f\u0915\u093f\u091f \u0927\u093f\u092e\u093f\u0924 \u091d\u0923\u0941\u0924 \u0924\u093e - \u0924\u0915\u093f\u091f \u0927\u093f\u0915\u093f\u091f \u0927\u093f\u092e\u093f\u0924 \u091d\u0923\u0941\u0924 \u0924\u093e - <br/> \u0924\u0915\u093f\u091f \u0927\u093f\u0915\u093f\u091f \u0927\u093f\u092e\u093f\u0924 \u091d\u0923\u0941\u0924 <br/> \u0924\u0924\u093e\u092e\u094d \u0924\u0924\u093e\u092e\u094d \u0924\u0924\u093e - \u0915\u093f\u091f\u0924\u093e\u092e\u094d \u0915\u093f\u091f\u0924\u093e\u092e\u094d \u0915\u093f\u091f\u0924\u093e - \u0924\u0915\u093f\u091f\u0924\u093e\u092e\u094d \u0924\u0915\u093f\u091f\u0924\u093e\u092e\u094d \u0924\u0915\u093f\u091f <br/> \u0902\u0919\u0943\u0937\u094d\u0923\u094d \u0924\u0915\u0924\u0915\u093f\u091f \u0924\u093e - \u0902\u0919\u0943\u0937\u094d\u0923\u094d \u0924\u0915.\u0924\u0915\u093f.\u091f \u0924\u093e - \u0902\u0919\u0943\u0937\u094d\u0923\u094d \u0924\u0915..\u0924\u0915\u093f..\u091f"}]}], "L": "l", "lyricsref": [{"links": [{"N": "ravikiranmusic.com", "L": "https://ravikiranmusic.com/compositions/tillana-kalyanavasantam-khanda-chapu/"}]}]}